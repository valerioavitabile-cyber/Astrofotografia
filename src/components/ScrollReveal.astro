---
---

<script>
  // Temporary on-page debug overlay (?debug=1) for the "hero title already
  // shrunk on load" bug reported on a real Android device that isolated
  // test pages couldn't reproduce — logs every hero-progress computation
  // with a timestamp/scrollY/innerHeight snapshot so the real cause is
  // visible without remote-debugging the device. Remove once the bug is
  // fixed and confirmed on-device.
  const debugMode = new URLSearchParams(location.search).get('debug') === '1';
  const heroDebugLog: { label: string; t: number; scrollY: number; innerHeight: number; target: number }[] = [];
  let heroDebugEl: HTMLElement | null = null;

  const heroDebugRecord = (label: string, target: number) => {
    if (!debugMode) return;
    heroDebugLog.push({
      label,
      t: Math.round(performance.now()),
      scrollY: window.scrollY,
      innerHeight: window.innerHeight,
      target,
    });
    if (!heroDebugEl) {
      heroDebugEl = document.createElement('div');
      heroDebugEl.style.cssText =
        'position:fixed;bottom:0;left:0;right:0;max-height:45vh;overflow:auto;background:rgba(0,0,0,0.92);color:#e8a33d;font:11px/1.4 ui-monospace,monospace;padding:8px;z-index:99999;white-space:pre-wrap;';
      document.body.appendChild(heroDebugEl);
    }
    heroDebugEl.textContent = heroDebugLog
      .map((e) => `${e.label} t=${e.t}ms scrollY=${e.scrollY} innerHeight=${e.innerHeight} target=${e.target.toFixed(3)}`)
      .join('\n');
  };

  // Toggles rather than one-shot reveals: scrolling a section back out of
  // view (either direction) resets it, so it replays every time it
  // re-enters the viewport instead of staying revealed forever.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle('is-visible', entry.isIntersecting);
      }
    },
    { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
  );

  const observe = () => {
    document
      .querySelectorAll<HTMLElement>(
        '.reveal, .reveal-left:not(.reveal-hero), .reveal-right:not(.reveal-hero), .reveal-blur, .reveal-fade, .barn-door-reveal',
      )
      .forEach((el) => observer.observe(el));
  };

  const revealHero = () => {
    document.querySelectorAll<HTMLElement>('.reveal-hero:not(.is-visible)').forEach((el) => {
      el.classList.add('is-visible');
    });
    window.removeEventListener('scroll', revealHero);
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Smoothed with a lerp loop rather than snapping straight to the scroll
  // position: raw scroll events fire in uneven bursts (mouse wheel steps,
  // trackpad ticks), so mapping 1:1 to the transform looks jerky. Chasing
  // the target value a fraction of the way each frame decouples the motion
  // from event timing and reads as fluid regardless of how choppy the
  // incoming scroll events are.
  const heroSmoothing = 0.15;
  let heroCurrent = 0;
  let heroRafId: number | null = null;

  const getHeroTarget = () => {
    const hero = document.getElementById('hero');
    if (!hero) return 0;
    const vh = window.innerHeight;
    return Math.min(1, Math.max(0, window.scrollY / (vh * 0.5)));
  };

  const heroTick = () => {
    const target = getHeroTarget();
    heroCurrent += (target - heroCurrent) * heroSmoothing;
    if (Math.abs(target - heroCurrent) < 0.0005) {
      heroCurrent = target;
    }
    document.documentElement.style.setProperty('--hero-progress', heroCurrent.toFixed(4));
    heroRafId = heroCurrent === target ? null : requestAnimationFrame(heroTick);
  };

  let heroScrollEventCount = 0;
  const onHeroScroll = () => {
    heroScrollEventCount++;
    if (heroScrollEventCount <= 5) heroDebugRecord(`scroll-event-#${heroScrollEventCount}`, getHeroTarget());
    if (heroRafId === null) {
      heroRafId = requestAnimationFrame(heroTick);
    }
  };

  // Measures where the (invisible) hero placeholder text sits and where the
  // small corner brand sits, so the .hero-clone element in Header.astro can
  // morph between the two purely via CSS transform driven by --hero-progress.
  const measureHeroClone = () => {
    const placeholder = document.getElementById('hero-placeholder');
    const clone = document.querySelector<HTMLElement>('.hero-clone');
    const cloneHeading = clone?.querySelector('h1');
    const cloneTagline = clone?.querySelector<HTMLElement>('p.hero-tagline');
    if (!placeholder || !clone || !cloneHeading) return;

    const root = document.documentElement;
    const rect = placeholder.getBoundingClientRect();
    const x0 = rect.left;
    const y0 = rect.top + window.scrollY;

    const startFontSize = parseFloat(getComputedStyle(cloneHeading).fontSize);
    const endFontSize = 16; // matches .site-brand font-size
    const scale1 = endFontSize / startFontSize;

    // Splits the tagline into one <span> per letter (once) and stretches it
    // to the title's exact width via flexbox space-between, which lines up
    // the first and last letters with the title's edges precisely — unlike
    // letter-spacing, whose trailing space is handled inconsistently across
    // browsers and undershoots the target width.
    if (cloneTagline) {
      const text = cloneTagline.textContent ?? '';
      if (!cloneTagline.dataset.split) {
        cloneTagline.innerHTML = Array.from(text)
          .map((ch) => `<span>${ch === ' ' ? '&nbsp;' : ch}</span>`)
          .join('');
        cloneTagline.dataset.split = 'true';
      }
      const titleWidth = cloneHeading.getBoundingClientRect().width;
      cloneTagline.style.width = `${titleWidth}px`;
    }

    root.style.setProperty('--hero-x0', `${x0}px`);
    root.style.setProperty('--hero-y0', `${y0}px`);
    root.style.setProperty('--hero-x1', '25px');
    root.style.setProperty('--hero-y1', '22px');
    root.style.setProperty('--hero-scale1', scale1.toFixed(4));
    clone.classList.add('is-ready');
  };

  const onHeroResize = () => {
    heroDebugRecord('resize-before', getHeroTarget());
    measureHeroClone();
    onHeroScroll();
    heroDebugRecord('resize-after', getHeroTarget());
  };

  let heroListenersBound = false;
  const setupHeroProgress = () => {
    heroDebugRecord('setup-entry', getHeroTarget());
    if (reduceMotion || !document.getElementById('hero')) return;
    measureHeroClone();
    // Start exactly at the current scroll position (no animated entrance on
    // load/navigation) and only ease subsequent movement from there.
    heroCurrent = getHeroTarget();
    document.documentElement.style.setProperty('--hero-progress', heroCurrent.toFixed(4));
    heroDebugRecord('setup-applied', heroCurrent);
    if (!heroListenersBound) {
      window.addEventListener('scroll', onHeroScroll, { passive: true });
      window.addEventListener('resize', onHeroResize);
      document.fonts?.ready.then(() => {
        measureHeroClone();
        heroDebugRecord('fonts-ready', getHeroTarget());
      });
      heroListenersBound = true;
    }
  };

  // Keyed on the container element so a re-run (e.g. after Astro reuses a
  // cached page instance instead of parsing fresh DOM on navigation) tears
  // down the previous observer instead of silently skipping re-init — the
  // old `.mosaic-ready` class guard left stale/cached containers with a dead
  // observer and no way to reattach, which is what left the video black
  // after navigating away and back to the homepage.
  const mosaicObservers = new WeakMap<HTMLElement, IntersectionObserver>();

  const setupMosaic = () => {
    document.querySelectorAll<HTMLElement>('.mosaic-reveal').forEach((container) => {
      mosaicObservers.get(container)?.disconnect();

      const maxDelay = 1800;
      const tiles = Array.from(container.querySelectorAll<HTMLElement>('.mosaic-tile'));
      const randomizeDelays = () => {
        tiles.forEach((tile) => {
          tile.style.transitionDelay = `${Math.round(Math.random() * maxDelay)}ms`;
        });
      };
      randomizeDelays();

      const video = container.querySelector<HTMLVideoElement>('[data-mosaic-video]');

      const reveal = () => {
        container.classList.add('is-visible');
        // A container reused after being detached from the document (e.g.
        // navigating away and back) can leave the video's decode buffer
        // discarded even though currentTime/readyState still look sane, so
        // force a reload before playing rather than trusting stale state.
        if (video && video.readyState === 0) {
          video.load();
        }
        // Starts playback as soon as the tiles begin peeling (rather than
        // waiting for them to fully clear) so the black intro frames of
        // the clip have already played out by the time the video is
        // uncovered, and viewers see real footage instead of a black flash.
        video?.play().catch(() => {});
      };

      const hide = () => {
        container.classList.remove('is-visible');
        randomizeDelays();
        if (video) {
          video.pause();
          video.currentTime = 0;
        }
      };

      if (reduceMotion) {
        reveal();
        return;
      }

      // Re-triggers on every entry: scrolling the section out of view (in
      // either direction) resets the tiles so it replays from scratch
      // the next time it scrolls back into the viewport.
      const mosaicObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              reveal();
            } else {
              hide();
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
      );
      mosaicObserver.observe(container);
      mosaicObservers.set(container, mosaicObserver);
    });
  };

  // Iris reveal: opens the gallery's images one at a time (rather than all
  // together) by staggering when .is-visible lands on each .iris-stage.
  const irisObservers = new WeakMap<HTMLElement, IntersectionObserver>();
  const irisTimers = new WeakMap<HTMLElement, number[]>();

  const setupIris = () => {
    document.querySelectorAll<HTMLElement>('.iris-gallery').forEach((gallery) => {
      irisObservers.get(gallery)?.disconnect();
      const stages = Array.from(gallery.querySelectorAll<HTMLElement>('.iris-stage'));

      if (reduceMotion) {
        stages.forEach((stage) => {
          stage.classList.add('is-visible');
          stage.closest<HTMLElement>('.iris-card')?.classList.add('is-framed');
        });
        return;
      }

      const clearTimers = () => {
        irisTimers.get(gallery)?.forEach((id) => window.clearTimeout(id));
        irisTimers.set(gallery, []);
      };

      const reveal = () => {
        clearTimers();
        const timers = stages.map((stage, i) =>
          window.setTimeout(() => {
            stage.classList.add('is-visible');
            // The frame only fades in once the iris has actually finished
            // blooming out, not while it's still opening.
            const photo = stage.querySelector<HTMLElement>('.iris-reveal');
            const card = stage.closest<HTMLElement>('.iris-card');
            photo?.addEventListener(
              'transitionend',
              (e) => {
                if (e.propertyName === 'clip-path') card?.classList.add('is-framed');
              },
              { once: true },
            );
          }, i * 250),
        );
        irisTimers.set(gallery, timers);
      };

      const hide = () => {
        clearTimers();
        stages.forEach((stage) => {
          stage.classList.remove('is-visible');
          stage.closest<HTMLElement>('.iris-card')?.classList.remove('is-framed');
        });
      };

      const irisObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              reveal();
            } else {
              hide();
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
      );
      irisObserver.observe(gallery);
      irisObservers.set(gallery, irisObserver);
    });
  };

  // Stack gallery: cards start piled at the grid's center (rotated, scaled
  // down) and unfurl into their natural grid position with a stagger. This
  // is a FLIP: the grid is laid out normally by CSS, then for each card we
  // measure its real position and compute the offset that would carry it
  // back to the gallery's center — that offset is applied as an instant,
  // untransitioned transform the moment the gallery is set up, so the pile
  // is what's visible on first paint rather than the settled grid flashing
  // first. As with the old fan gallery, it arms itself on intersection and
  // waits for the visitor's next vertical scroll before unfurling, so the
  // pile sits put until they actually scroll the section.
  const stackObservers = new WeakMap<HTMLElement, IntersectionObserver>();

  const setupStack = () => {
    document.querySelectorAll<HTMLElement>('.stack-gallery').forEach((gallery) => {
      stackObservers.get(gallery)?.disconnect();
      const cards = Array.from(gallery.querySelectorAll<HTMLElement>('.stack-card'));
      // Galleries with a single photo don't get the pile/unfurl treatment —
      // there's nothing to fan out, so leave it in its natural, already-visible position.
      if (cards.length < 2) {
        cards.forEach((card) => card.classList.add('is-placed'));
        return;
      }

      if (reduceMotion) {
        gallery.classList.add('is-settled');
        cards.forEach((card) => card.classList.add('is-placed'));
        return;
      }

      const DURATION = 2200;
      const STAGGER = 140;
      let settleTimer: number | null = null;

      // Reads each card's laid-out position and returns the translate/
      // rotate needed to carry it from there back to the pile's start
      // point. Assumes cards are currently untransformed — callers reset
      // transform to none first so a stale pile doesn't get measured and
      // compounded.
      const computeOffsets = () => {
        const galleryRect = gallery.getBoundingClientRect();
        const centerX = galleryRect.width / 2;
        // Vertically the pile sits just below the first row rather than at
        // the whole grid's center — anchoring to the first card (instead of
        // galleryRect.height / 2) keeps the start point near the top
        // regardless of how many rows the gallery has, rather than drifting
        // down as more rows are added. The added 0.85 card-heights nudges
        // it down from dead-center-of-row-1 to just under it.
        const firstCardRect = cards[0].getBoundingClientRect();
        const centerY = firstCardRect.top - galleryRect.top + firstCardRect.height * 0.85;
        return cards.map((card, i) => {
          const r = card.getBoundingClientRect();
          const cardCenterX = r.left - galleryRect.left + r.width / 2;
          const cardCenterY = r.top - galleryRect.top + r.height / 2;
          const dx = centerX - cardCenterX;
          const dy = centerY - cardCenterY;
          const rot = (i % 2 === 0 ? -1 : 1) * (4 + ((i * 3) % 9));
          return { dx, dy, rot };
        });
      };

      const pile = () => {
        if (settleTimer !== null) window.clearTimeout(settleTimer);
        gallery.classList.remove('is-settled');
        // pile() can be re-entered while cards are still mid-pile (e.g. a
        // late image-load layout shift re-crosses the intersection
        // threshold) — reset to the natural layout first so computeOffsets
        // never measures an already-transformed (and therefore wrong)
        // position. This resolves synchronously with no yield back to the
        // renderer, so the untransformed frame is never actually painted.
        cards.forEach((card) => {
          card.style.transition = 'none';
          card.style.transform = 'none';
        });
        const offsets = computeOffsets();
        cards.forEach((card, i) => {
          card.style.zIndex = String(cards.length - i);
          card.style.transform = `translate(${offsets[i].dx}px, ${offsets[i].dy}px) rotate(${offsets[i].rot}deg) scale(0.7)`;
          card.classList.add('is-placed');
        });
      };

      const unfurl = () => {
        if (settleTimer !== null) window.clearTimeout(settleTimer);
        cards.forEach((card, i) => {
          card.style.transition = `transform ${DURATION}ms cubic-bezier(0.22, 1, 0.36, 1) ${i * STAGGER}ms`;
          card.style.transform = 'translate(0, 0) rotate(0deg) scale(1)';
        });
        settleTimer = window.setTimeout(
          () => gallery.classList.add('is-settled'),
          DURATION + cards.length * STAGGER,
        );
      };

      // Cards start at opacity:0 (see global.css) and only turn visible
      // once .is-placed lands alongside the pile transform, so nothing is
      // ever painted in its untransformed grid slot. The double rAF waits
      // for a real layout/paint cycle first — measuring on the same tick
      // the script runs can catch the grid mid-CSS-load (e.g. Tailwind's
      // column classes not yet applied in dev), which produced near-zero
      // offsets and piled every card on top of itself.
      requestAnimationFrame(() => requestAnimationFrame(pile));

      let armed = false;
      let lastScrollY = window.scrollY;
      let armTimer: number | null = null;

      const disarm = () => {
        armed = false;
        window.removeEventListener('scroll', onArmedScroll);
        if (armTimer !== null) {
          window.clearTimeout(armTimer);
          armTimer = null;
        }
      };

      const onArmedScroll = () => {
        if (!armed || window.scrollY === lastScrollY) return;
        disarm();
        unfurl();
      };

      const stackObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              armed = true;
              lastScrollY = window.scrollY;
              window.addEventListener('scroll', onArmedScroll, { passive: true });
              // Fallback for pages short enough that the gallery is already
              // in view with little or nothing left to scroll (e.g. a
              // category with only two photos) — without this, arming never
              // gets a follow-up scroll event and the pile sits frozen
              // forever. Gives the visitor a moment to start scrolling on
              // their own before unfurling automatically.
              armTimer = window.setTimeout(() => {
                disarm();
                unfurl();
              }, 2200);
            } else {
              disarm();
              pile();
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
      );
      stackObserver.observe(gallery);
      stackObservers.set(gallery, stackObserver);
    });
  };

  const setup = () => {
    observe();
    setupHeroProgress();
    setupMosaic();
    setupIris();
    setupStack();
    if (document.querySelector('.reveal-hero:not(.is-visible)')) {
      window.addEventListener('scroll', revealHero, { passive: true });
    }
  };

  setup();
  document.addEventListener('astro:page-load', setup);

  if (debugMode) {
    [300, 1000, 2000, 4000].forEach((delay) => {
      setTimeout(() => heroDebugRecord(`+${delay}ms`, getHeroTarget()), delay);
    });
    window.addEventListener('load', () => heroDebugRecord('window-load', getHeroTarget()));
  }
</script>
