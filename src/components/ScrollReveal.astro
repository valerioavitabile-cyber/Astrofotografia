<script>
  // Toggles rather than one-shot reveals: scrolling a section back out of
  // view (either direction) resets it, so it replays every time it
  // re-enters the viewport instead of staying revealed forever.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle('is-visible', entry.isIntersecting);
      }
    },
    { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
  );

  const observe = () => {
    document
      .querySelectorAll<HTMLElement>('.reveal, .reveal-left:not(.reveal-hero), .reveal-right:not(.reveal-hero)')
      .forEach((el) => observer.observe(el));
  };

  const revealHero = () => {
    document.querySelectorAll<HTMLElement>('.reveal-hero:not(.is-visible)').forEach((el) => {
      el.classList.add('is-visible');
    });
    window.removeEventListener('scroll', revealHero);
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let flyTicking = false;
  const updateFly = () => {
    flyTicking = false;
    const vh = window.innerHeight;
    const start = vh; // element bottom-of-viewport: progress 0
    const end = vh * 0.45; // finishes higher up the viewport: progress 1, slower feel
    document.querySelectorAll<HTMLElement>('.scroll-fly').forEach((el) => {
      const rect = el.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end)));
      el.style.setProperty('--fly-progress', progress.toFixed(3));
    });
  };

  const onFlyScroll = () => {
    if (!flyTicking) {
      flyTicking = true;
      requestAnimationFrame(updateFly);
    }
  };

  let flyListenersBound = false;
  const setupFly = () => {
    if (reduceMotion || !document.querySelector('.scroll-fly')) return;
    updateFly();
    if (!flyListenersBound) {
      window.addEventListener('scroll', onFlyScroll, { passive: true });
      window.addEventListener('resize', onFlyScroll);
      flyListenersBound = true;
    }
  };

  // Smoothed with a lerp loop rather than snapping straight to the scroll
  // position: raw scroll events fire in uneven bursts (mouse wheel steps,
  // trackpad ticks), so mapping 1:1 to the transform looks jerky. Chasing
  // the target value a fraction of the way each frame decouples the motion
  // from event timing and reads as fluid regardless of how choppy the
  // incoming scroll events are.
  const heroSmoothing = 0.15;
  let heroCurrent = 0;
  let heroRafId: number | null = null;

  const getHeroTarget = () => {
    const hero = document.getElementById('hero');
    if (!hero) return 0;
    const vh = window.innerHeight;
    return Math.min(1, Math.max(0, window.scrollY / (vh * 0.5)));
  };

  const heroTick = () => {
    const target = getHeroTarget();
    heroCurrent += (target - heroCurrent) * heroSmoothing;
    if (Math.abs(target - heroCurrent) < 0.0005) {
      heroCurrent = target;
    }
    document.documentElement.style.setProperty('--hero-progress', heroCurrent.toFixed(4));
    heroRafId = heroCurrent === target ? null : requestAnimationFrame(heroTick);
  };

  const onHeroScroll = () => {
    if (heroRafId === null) {
      heroRafId = requestAnimationFrame(heroTick);
    }
  };

  // Measures where the (invisible) hero placeholder text sits and where the
  // small corner brand sits, so the .hero-clone element in Header.astro can
  // morph between the two purely via CSS transform driven by --hero-progress.
  const measureHeroClone = () => {
    const placeholder = document.getElementById('hero-placeholder');
    const clone = document.querySelector<HTMLElement>('.hero-clone');
    const cloneHeading = clone?.querySelector('h1');
    if (!placeholder || !clone || !cloneHeading) return;

    const root = document.documentElement;
    const rect = placeholder.getBoundingClientRect();
    const x0 = rect.left;
    const y0 = rect.top + window.scrollY;

    const startFontSize = parseFloat(getComputedStyle(cloneHeading).fontSize);
    const endFontSize = 16; // matches .site-brand font-size
    const scale1 = endFontSize / startFontSize;

    root.style.setProperty('--hero-x0', `${x0}px`);
    root.style.setProperty('--hero-y0', `${y0}px`);
    root.style.setProperty('--hero-x1', '25px');
    root.style.setProperty('--hero-y1', '22px');
    root.style.setProperty('--hero-scale1', scale1.toFixed(4));
    clone.classList.add('is-ready');
  };

  const onHeroResize = () => {
    measureHeroClone();
    onHeroScroll();
  };

  let heroListenersBound = false;
  const setupHeroProgress = () => {
    if (reduceMotion || !document.getElementById('hero')) return;
    measureHeroClone();
    // Start exactly at the current scroll position (no animated entrance on
    // load/navigation) and only ease subsequent movement from there.
    heroCurrent = getHeroTarget();
    document.documentElement.style.setProperty('--hero-progress', heroCurrent.toFixed(4));
    if (!heroListenersBound) {
      window.addEventListener('scroll', onHeroScroll, { passive: true });
      window.addEventListener('resize', onHeroResize);
      document.fonts?.ready.then(measureHeroClone);
      heroListenersBound = true;
    }
  };

  const setupMosaic = () => {
    document.querySelectorAll<HTMLElement>('.mosaic-reveal:not(.mosaic-ready)').forEach((container) => {
      container.classList.add('mosaic-ready');

      const tileTransition = 1200; // matches .mosaic-tile transition duration (ms)
      const maxDelay = 900;
      const tiles = Array.from(container.querySelectorAll<HTMLElement>('.mosaic-tile'));
      const randomizeDelays = () => {
        tiles.forEach((tile) => {
          tile.style.transitionDelay = `${Math.round(Math.random() * maxDelay)}ms`;
        });
      };
      randomizeDelays();

      const video = container.querySelector<HTMLVideoElement>('[data-mosaic-video]');
      let revealTimeout: number | undefined;

      const reveal = () => {
        container.classList.add('is-visible');
        if (video) {
          revealTimeout = window.setTimeout(() => {
            video.play().catch(() => {});
          }, maxDelay + tileTransition);
        }
      };

      const hide = () => {
        window.clearTimeout(revealTimeout);
        container.classList.remove('is-visible');
        randomizeDelays();
        if (video) {
          video.pause();
          video.currentTime = 0;
        }
      };

      if (reduceMotion) {
        reveal();
        return;
      }

      // Re-triggers on every entry: scrolling the section out of view (in
      // either direction) resets the tiles so it replays from scratch
      // the next time it scrolls back into the viewport.
      const mosaicObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              reveal();
            } else {
              hide();
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
      );
      mosaicObserver.observe(container);
    });
  };

  const setup = () => {
    observe();
    setupFly();
    setupHeroProgress();
    setupMosaic();
    if (document.querySelector('.reveal-hero:not(.is-visible)')) {
      window.addEventListener('scroll', revealHero, { passive: true });
    }
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
