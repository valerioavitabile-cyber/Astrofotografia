---
// Language toggle: two flag buttons that flip a `data-lang` attribute on
// <html>. All translated content lives in the DOM twice (see T.astro and the
// data-lang-en/data-lang-it markup used across pages); global.css hides the
// inactive language. Attribute-only content (page <title>, meta description,
// alt/aria-label text) can't be duplicated in the DOM, so it's declared via
// `data-tr='{"attr":"alt","en":"...","it":"..."}'` and patched by this script.
---

<div class="lang-switcher" role="group" aria-label="Language / Lingua">
  <button type="button" class="lang-btn" data-lang-btn="it" aria-label="Italiano" title="Italiano">
    <svg viewBox="0 0 3 2" class="lang-flag" aria-hidden="true">
      <rect width="1" height="2" x="0" fill="#009246" />
      <rect width="1" height="2" x="1" fill="#f1f2f1" />
      <rect width="1" height="2" x="2" fill="#ce2b37" />
    </svg>
  </button>
  <button type="button" class="lang-btn" data-lang-btn="en" aria-label="English" title="English">
    <svg viewBox="0 0 60 30" class="lang-flag" aria-hidden="true">
      <clipPath id="lang-uk-t">
        <path d="M0,0 v30 h60 v-30 z" />
      </clipPath>
      <path d="M0,0 v30 h60 v-30 z" fill="#00247d" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" clip-path="url(#lang-uk-t)" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#cf142b" stroke-width="2" clip-path="url(#lang-uk-t)" />
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#cf142b" stroke-width="6" />
    </svg>
  </button>
</div>

<style>
  .lang-switcher {
    position: fixed;
    top: 25px;
    right: 70px;
    z-index: 1001;
    display: flex;
    gap: 6px;
  }

  .lang-btn {
    width: 26px;
    height: 26px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    border: 1.5px solid transparent;
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
    opacity: 0.55;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .lang-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .lang-btn.is-active {
    opacity: 1;
    border-color: var(--color-accent);
  }

  .lang-flag {
    width: 20px;
    height: 14px;
    border-radius: 2px;
    display: block;
  }

  @media (max-width: 768px) {
    .lang-switcher {
      top: 15px;
      right: 62px;
    }
  }
</style>

<script>
  type Lang = 'it' | 'en';
  const STORAGE_KEY = 'site-lang';
  const DEFAULT_LANG: Lang = 'it';

  function getLang(): Lang {
    const stored = localStorage.getItem(STORAGE_KEY);
    return stored === 'en' || stored === 'it' ? stored : DEFAULT_LANG;
  }

  function applyLang(lang: Lang) {
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.setAttribute('lang', lang);

    document.querySelectorAll<HTMLElement>('[data-tr]').forEach((el) => {
      try {
        const cfg = JSON.parse(el.getAttribute('data-tr') || '{}') as Record<string, string>;
        const value = cfg[lang];
        if (value == null) return;
        if (cfg.attr === 'text') {
          el.textContent = value;
        } else if (cfg.attr) {
          el.setAttribute(cfg.attr, value);
        }
      } catch {
        // ignore malformed data-tr payloads
      }
    });

    document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.langBtn === lang);
    });
  }

  function setLang(lang: Lang) {
    localStorage.setItem(STORAGE_KEY, lang);
    applyLang(lang);
  }

  function init() {
    applyLang(getLang());
    document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const l = btn.dataset.langBtn;
        if (l === 'it' || l === 'en') setLang(l);
      });
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
