---
import { site } from '../data/site';
import { withBase } from '../utils/url';

const year = new Date().getFullYear();

const socials = [
  {
    label: 'Email',
    href: `mailto:${site.email}`,
    color: '#fbbf24',
    external: false,
    icon: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm.5 1L12 13l8.5-7',
    viewBox: '0 0 24 24',
    stroke: true,
  },
  {
    label: 'Facebook',
    href: site.social.facebook,
    color: '#1877f2',
    external: true,
    icon: 'M13.5 21v-7.6h2.55l.38-2.96h-2.93V8.55c0-.86.24-1.44 1.47-1.44h1.57V4.46c-.27-.04-1.2-.12-2.28-.12-2.26 0-3.8 1.38-3.8 3.9v2.18H7.9v2.96h2.56V21h3.04Z',
    viewBox: '0 0 24 24',
    stroke: false,
  },
  {
    label: 'YouTube',
    href: site.social.youtube,
    color: '#ff0000',
    external: true,
    icon: 'M21.6 7.6a2.9 2.9 0 0 0-2.05-2.06C17.8 5.1 12 5.1 12 5.1s-5.8 0-7.55.44A2.9 2.9 0 0 0 2.4 7.6 30.4 30.4 0 0 0 2 12a30.4 30.4 0 0 0 .4 4.4 2.9 2.9 0 0 0 2.05 2.06c1.75.44 7.55.44 7.55.44s5.8 0 7.55-.44a2.9 2.9 0 0 0 2.05-2.06A30.4 30.4 0 0 0 22 12a30.4 30.4 0 0 0-.4-4.4ZM10 15V9l5.2 3-5.2 3Z',
    viewBox: '0 0 24 24',
    stroke: false,
  },
  {
    label: 'Instagram',
    href: site.social.instagram,
    color: '#e1306c',
    external: true,
    icon: null,
    viewBox: '0 0 24 24',
    stroke: true,
  },
];
---

<footer class="sticky-footer border-t border-white/10 bg-surface-2" id="site-footer">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent"></div>

  <div
    class="footer-grid mx-auto grid w-full max-w-6xl grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]"
  >
    <div class="max-w-sm sm:col-span-2 lg:col-span-1">
      <a
        href={withBase('/')}
        class="block text-[clamp(2.25rem,7vw,5rem)] font-semibold leading-[0.95] tracking-tight text-white"
      >
        {site.title.split(' ').map((word) => (
          <>
            {word}
            <br />
          </>
        ))}
      </a>
      <p class="mt-4 text-sm leading-relaxed text-white/60">
        <span data-lang-en>
          {site.tagline} &mdash; galaxies, nebulae and deep-sky objects captured from a home
          terrace, shared through images, courses and tutorials.
        </span>
        <span data-lang-it>
          {site.tagline} &mdash; galassie, nebulose e oggetti del profondo cielo catturati da
          una terrazza di casa, condivisi attraverso immagini, corsi e tutorial.
        </span>
      </p>

      <div
        class="mt-6 flex gap-3"
        role="list"
        aria-label="Follow on social media"
        data-tr={JSON.stringify({ attr: 'aria-label', en: 'Follow on social media', it: 'Seguimi sui social' })}
      >
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.external ? '_blank' : undefined}
              rel={s.external ? 'noopener' : undefined}
              aria-label={s.label}
              title={s.label}
              class="footer-icon"
              style={`--icon-hover: ${s.color}`}
            >
              {s.label === 'Instagram' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
                </svg>
              ) : (
                <svg
                  viewBox={s.viewBox}
                  fill={s.stroke ? 'none' : 'currentColor'}
                  stroke={s.stroke ? 'currentColor' : undefined}
                  stroke-width={s.stroke ? '1.8' : undefined}
                  stroke-linecap={s.stroke ? 'round' : undefined}
                  stroke-linejoin={s.stroke ? 'round' : undefined}
                >
                  <path d={s.icon} />
                </svg>
              )}
            </a>
          ))
        }
      </div>

      <blockquote class="footer-quote mt-8 max-w-xs border-l-2 border-accent pl-4 text-[13.5px] italic leading-relaxed text-white/50">
        <span data-lang-en>
          Thank you for exploring the cosmos through my eyes. Never stop looking beyond &mdash;
          the next dream is already among the stars.
        </span>
        <span data-lang-it>
          Grazie per aver esplorato il cosmo attraverso i miei occhi. Non smettere mai di
          guardare oltre &mdash; il prossimo sogno è già tra le stelle.
        </span>
      </blockquote>
    </div>

    <div>
      <p class="eyebrow"><span data-lang-en>Get in touch</span><span data-lang-it>Contattami</span></p>
      <ul class="mt-5 space-y-2.5 text-sm text-white/70">
        <li>
          <a href={`mailto:${site.email}`} class="footer-link">{site.email}</a>
        </li>
        <li>
          <a href={withBase('/contact/')} class="footer-link">
            <span data-lang-en>Contact form</span><span data-lang-it>Modulo di contatto</span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="eyebrow"><span data-lang-en>Stay updated</span><span data-lang-it>Resta aggiornato</span></p>
      <p class="mt-5 text-sm leading-relaxed text-white/60">
        <span data-lang-en>New photos, courses and deep-sky tips &mdash; straight to your inbox.</span>
        <span data-lang-it>Nuove foto, corsi e consigli sul profondo cielo &mdash; direttamente nella tua casella email.</span>
      </p>
      <form class="footer-newsletter mt-4 flex flex-col gap-2.5" onsubmit="return false;">
        <input
          type="email"
          required
          placeholder="Your email"
          aria-label="Email address"
          class="footer-newsletter-input"
          data-tr={JSON.stringify({ attr: 'placeholder', en: 'Your email', it: 'La tua email' })}
        />
        <button type="submit" class="footer-newsletter-submit">
          <span data-lang-en>Subscribe</span><span data-lang-it>Iscriviti</span>
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom mx-auto w-full max-w-6xl">
    <div
      class="flex flex-col items-center gap-3 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:justify-between"
    >
      <p>
        <span data-lang-en>&copy; {year} Valerio Avitabile. All rights reserved.</span>
        <span data-lang-it>&copy; {year} Valerio Avitabile. Tutti i diritti riservati.</span>
      </p>
      <a href={withBase('/privacy/')} class="footer-link">
        <span data-lang-en>Privacy Policy</span><span data-lang-it>Informativa sulla Privacy</span>
      </a>
    </div>
  </div>
</footer>

<style>
  /* Sticky reveal footer: the footer sticks to the viewport bottom while
     the preceding <main> (rounded bottom corners, opaque background,
     higher z-index) scrolls over it, progressively uncovering it — the
     same "curtain" trick as the reference markup, just split across
     Layout.astro (.page-reveal on <main>) and this component. */
  .sticky-footer {
    position: sticky;
    bottom: 0;
    z-index: 0;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 4rem 1.5rem 2rem;

    opacity: 0;
    transform: scale(0.92);
    transform-origin: bottom center;
    will-change: transform, opacity;
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sticky-footer.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  /* While a page transition is in flight, <main>'s view-transition snapshot
     is frozen at whatever height it had the instant the snapshot was taken
     — often shorter than main's real (post-layout) height, since that's
     captured right after swap, before images/JS-driven sizing settle. For
     the rest of the transition's ~2.8s fade, that undersized snapshot no
     longer fully covers this sticky footer sitting right behind it, and the
     footer's own scroll-reveal (driven by IntersectionObserver, unrelated
     to the transition) can already be mid-fade-in by then — so it shows
     through before the incoming header hero has actually finished
     appearing. Force it hidden for the transition's duration; it reverts to
     its normal scroll-reveal behavior the instant the attribute clears.
     `transition: none` is required too — without it, this rule's own
     opacity/transform target is still reached by *animating* through the
     0.9s reveal transition below, so the footer stays partway visible
     for most of that time instead of disappearing immediately. */
  :global(html[data-astro-transition]) .sticky-footer {
    opacity: 0 !important;
    transform: scale(0.92) !important;
    transition: none !important;
  }

  @media (min-width: 640px) {
    .sticky-footer {
      padding: 4rem 2.5rem 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-footer {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .footer-newsletter-input {
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: var(--color-surface-2);
    padding: 0.625rem 0.75rem;
    font-size: 13.5px;
    color: #fff;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .footer-newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-newsletter-input:focus-visible {
    border-color: var(--color-accent);
  }

  .footer-newsletter-submit {
    border-radius: 0.5rem;
    border: none;
    background-color: var(--color-accent);
    padding: 0.625rem 0.75rem;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .footer-newsletter-submit:hover,
  .footer-newsletter-submit:focus-visible {
    filter: brightness(1.08);
  }
</style>

<script>
  // Mirrors the reference implementation: reveal when the footer enters
  // the viewport, reset when it fully leaves, so it replays if the user
  // scrolls back up and down again.
  let footerObserver: IntersectionObserver | null = null;

  const setupStickyFooter = () => {
    const footer = document.getElementById('site-footer');
    if (!footer) return;

    footerObserver?.disconnect();
    footerObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-visible', entry.isIntersecting);
        });
      },
      { threshold: 0.15 },
    );
    footerObserver.observe(footer);
  };

  setupStickyFooter();
  document.addEventListener('astro:page-load', setupStickyFooter);
</script>
