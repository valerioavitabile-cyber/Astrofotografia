---
import { withBase } from '../utils/url';
import { Image } from 'astro:assets';
import signature from '../assets/signature/firma.png';
import { socials } from '../data/socials';

const year = new Date().getFullYear();
---

<footer class="sticky-footer border-t border-white/10 bg-surface-2" id="site-footer">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent"></div>

  <div class="mx-auto flex w-full max-w-4xl flex-col items-center px-6 text-center">
    <p class="text-2xl text-white/70 sm:text-3xl" style="font-family: 'Cormorant Garamond', serif">
      <span data-lang-en>Do you have any questions? Feel free to write to me, I will be happy to answer you.</span>
      <span data-lang-it>Hai qualche domanda? Scrivimi pure, sarò felice di risponderti.</span>
    </p>

    <div
      class="mt-10 flex flex-wrap justify-center gap-4"
      role="list"
      aria-label="Follow on social media"
      data-tr={JSON.stringify({ attr: 'aria-label', en: 'Follow on social media', it: 'Seguimi sui social' })}
    >
      {
        socials.map((s) => (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener' : undefined}
            aria-label={s.label}
            title={s.label}
            class="footer-icon"
            style={`--icon-hover: ${s.color}`}
          >
            {s.label === 'Instagram' ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            ) : (
              <svg
                viewBox={s.viewBox}
                fill={s.stroke ? 'none' : 'currentColor'}
                stroke={s.stroke ? 'currentColor' : undefined}
                stroke-width={s.stroke ? '1.8' : undefined}
                stroke-linecap={s.stroke ? 'round' : undefined}
                stroke-linejoin={s.stroke ? 'round' : undefined}
              >
                <path d={s.icon} />
              </svg>
            )}
          </a>
        ))
      }
    </div>

    <div class="mt-16 w-fit text-left">
      <p class="text-xl italic text-white/80 sm:text-2xl" style="font-family: 'Cormorant Garamond', serif">
        <span data-lang-en>Thank you for exploring the universe with me</span>
        <span data-lang-it>Grazie per aver esplorato l'universo con me</span>
      </p>
      <p class="mt-5 text-2xl font-semibold italic text-accent sm:text-3xl" style="font-family: 'Cormorant Garamond', serif">
        <span data-lang-en>Clear skies</span>
        <span data-lang-it>Cieli sereni</span>
      </p>
    </div>

    <Image
      src={signature}
      alt="Valerio Avitabile"
      width={220}
      height={98}
      class="mt-6 w-40 self-center sm:w-48"
      style="filter: invert(1); opacity: 0.9; transform: translateX(6rem);"
    />

    <button type="button" id="footer-back-top" class="btn-accent mt-10 justify-center min-w-[190px]">
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 19V5M6 11l6-6 6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span data-lang-en>Back to top</span>
      <span data-lang-it>Torna su</span>
    </button>
  </div>

  <div class="footer-bottom mx-auto w-full max-w-6xl">
    <div
      class="flex flex-col items-center gap-3 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:justify-between"
    >
      <p>
        <span data-lang-en>&copy; {year} Valerio Avitabile. All rights reserved.</span>
        <span data-lang-it>&copy; {year} Valerio Avitabile. Tutti i diritti riservati.</span>
      </p>
      <a href={withBase('/privacy/')} class="footer-link">
        <span data-lang-en>Privacy Policy</span><span data-lang-it>Informativa sulla Privacy</span>
      </a>
    </div>
  </div>
</footer>

<style>
  /* Sticky reveal footer: the footer sticks to the viewport bottom while
     the preceding <main> (rounded bottom corners, opaque background,
     higher z-index) scrolls over it, progressively uncovering it — the
     same "curtain" trick as the reference markup, just split across
     Layout.astro (.page-reveal on <main>) and this component. */
  .sticky-footer {
    position: sticky;
    bottom: 0;
    z-index: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: 4rem 1.5rem 2rem;

    opacity: 0;
    transform: scale(0.97);
    filter: blur(18px);
    transform-origin: bottom center;
    will-change: transform, opacity, filter;
    transition:
      opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sticky-footer.is-visible {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  /* While a page swap is in flight, force the footer hidden so it can't
     flash through before the incoming page has settled — historically
     needed because <main>'s view-transition snapshot didn't fully cover it
     during the crossfade. Gated on our own `data-nav-swap` attribute (set/
     cleared in Layout.astro around 'astro:before-preparation'/
     'astro:page-load', which land within a frame or two of the actual DOM
     swap) rather than Astro's own `data-astro-transition` — that one is
     only removed once `ViewTransition.finished` resolves, which measured
     ~2.5-3s after landing on this page (real Chromium, not a fluke), since
     it waits out browser-internal transition bookkeeping unrelated to
     when our content is actually ready. Gating on it left the footer stuck
     fully invisible for that whole stretch after navigating here from a
     different page (e.g. About → "Contatti"), long past the point the
     fade+blur-in below (see replayFooterReveal() in Layout.astro) had
     already been armed and ready to play.
     `transition: none` is required too — without it, this rule's own
     opacity/transform target is still reached by *animating* through the
     1.1s reveal transition above, so the footer stays partway visible for
     most of that time instead of disappearing instantly. */
  :global(html[data-nav-swap]) .sticky-footer {
    opacity: 0 !important;
    transform: scale(0.97) !important;
    filter: blur(18px) !important;
    transition: none !important;
  }

  @media (min-width: 640px) {
    .sticky-footer {
      padding: 4rem 2.5rem 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-footer {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }

  .footer-newsletter-input {
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: var(--color-surface-2);
    padding: 0.625rem 0.75rem;
    font-size: 13.5px;
    color: #fff;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .footer-newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-newsletter-input:focus-visible {
    border-color: var(--color-accent);
  }

  .footer-newsletter-submit {
    border-radius: 0.5rem;
    border: none;
    background-color: var(--color-accent);
    padding: 0.625rem 0.75rem;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .footer-newsletter-submit:hover,
  .footer-newsletter-submit:focus-visible {
    filter: brightness(1.08);
  }
</style>

<script>
  // Mirrors the reference implementation: reveal when the footer enters
  // the viewport, reset when it fully leaves, so it replays if the user
  // scrolls back up and down again.
  let footerObserver: IntersectionObserver | null = null;

  const setupStickyFooter = () => {
    const footer = document.getElementById('site-footer');
    if (!footer) return;

    footerObserver?.disconnect();
    footerObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-visible', entry.isIntersecting);
        });
      },
      { threshold: 0.15 },
    );
    footerObserver.observe(footer);
  };

  const setupBackToTop = () => {
    const button = document.getElementById('footer-back-top');
    button?.addEventListener('click', () => {
      window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
    });
  };

  setupStickyFooter();
  setupBackToTop();
  document.addEventListener('astro:page-load', setupStickyFooter);
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
