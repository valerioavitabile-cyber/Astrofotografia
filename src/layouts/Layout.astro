---
import '@fontsource-variable/raleway';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import Parallax from '../components/Parallax.astro';
import BackgroundMusic from '../components/BackgroundMusic.astro';
import { site } from '../data/site';
import socialCard from '../assets/social-card.jpg';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  titleIt?: string;
  description?: string;
  descriptionIt?: string;
  preloadImage?: string;
}

const { title, titleIt, description = site.description, descriptionIt, preloadImage } = Astro.props;
const pageTitle = title === site.title ? site.title : `${title} · ${site.title}`;
const pageTitleIt = titleIt ? (titleIt === site.title ? site.title : `${titleIt} · ${site.title}`) : pageTitle;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === withBase('/');
---

<!doctype html>
<html lang="it" data-lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href={socialCard.src} />
    <script is:inline>
      // Set data-lang before anything paints, straight from localStorage, so
      // the page never flashes the wrong language before LangSwitcher's own
      // script runs (see components/LangSwitcher.astro).
      (function () {
        try {
          var l = localStorage.getItem('site-lang');
          document.documentElement.setAttribute('data-lang', l === 'en' ? 'en' : 'it');
          document.documentElement.setAttribute('lang', l === 'en' ? 'en' : 'it');
        } catch (e) {}
      })();
    </script>
    <title data-tr={JSON.stringify({ attr: 'text', en: pageTitle, it: pageTitleIt })}>{pageTitleIt}</title>
    <meta
      name="description"
      content={descriptionIt || description}
      data-tr={JSON.stringify({ attr: 'content', en: description, it: descriptionIt || description })}
    />
    <link rel="canonical" href={canonicalURL} />
    {preloadImage && <link rel="preload" as="image" fetchpriority="high" href={preloadImage} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(socialCard.src, site.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <script is:inline>
      // The portrait link's hover-zoom (group-hover:scale-110) stays active
      // through the click since the pointer never leaves the element before
      // navigation starts. Left as-is, the view-transition snapshot captures
      // the zoomed-in image and it visibly pops back to normal once the
      // (un-zoomed) about page swaps in. Delaying navigation just long enough
      // for the zoom to ease back to scale(1) removes that pop.
      if (!window.__portraitZoomFix) {
        window.__portraitZoomFix = true;
        document.addEventListener('astro:before-preparation', (event) => {
          const link = event.sourceElement?.closest?.('[data-portrait-link]');
          const img = link?.querySelector('img');
          if (!img || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          const originalLoader = event.loader;
          event.loader = async () => {
            img.classList.add('portrait-unzoom');
            await new Promise((resolve) => setTimeout(resolve, 1250));
            await originalLoader();
          };
        });
      }
    </script>
    <script is:inline define:vars={{ homePath: withBase('/') }}>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      // A single early scrollTo isn't enough: the browser can re-apply its
      // own scroll restoration after this script runs (notably on
      // 'pageshow', which also fires when the page is served from the
      // bfcache on refresh/back-forward), so it's forced back to the top
      // again at each of these later points too. It also has to run on
      // 'astro:after-swap' (not just 'load'/'pageshow'), since navigating to
      // "/" via the client-side router never re-fires those — without it,
      // the page briefly shows whatever scroll position the previous page
      // was at (e.g. the footer) until something scrolls it back up.
      // behavior: 'instant' is required too: global.css sets
      // scroll-behavior: smooth, so a plain scrollTo(0, 0) would glide up
      // from wherever the browser landed (often the footer, when the prior
      // page's raw scroll offset overshoots the home page's height),
      // visibly sliding the footer past the header hero on the way up.
      function resetHomeScroll() {
        if (window.location.pathname === homePath) window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      }
      resetHomeScroll();
      window.addEventListener('load', resetHomeScroll);
      window.addEventListener('pageshow', resetHomeScroll);
      document.addEventListener('astro:after-swap', resetHomeScroll);

      // There used to also be an 'astro:before-preparation' handler here that
      // pre-scrolled the *outgoing* page to the top as soon as a navigation
      // to "/" was requested — added back when <main> still crossfaded
      // between pages, to stop the old page's leftover scrollY (e.g. deep
      // down a long "courses" page) from flashing the home page's sticky
      // footer during the transition. Since <main> now uses
      // transition:animate="none" (see below; decisioni.md, 2026-08-12),
      // there's no crossfade snapshot left for that leftover scrollY to leak
      // into, so the pre-scroll had become pure overhead — and worse, a bug
      // in its own right: it's a real scrollTo on the still-visible outgoing
      // page, landing ~50-100ms before the swap, which reads as "scrolls to
      // the top, then changes page" (reported on the video-utility "Torna
      // alla Home" button after scrolling deep down the page). Removed;
      // resetHomeScroll() on 'astro:after-swap' alone is enough now that the
      // swap itself is an instant cut.
      // "Torna a ..." links point at another page's #section (e.g.
      // /video-utility/#tools). Astro's router can't scroll to a fragment as
      // part of its own SPA-style swap, so for any `to.hash` it falls back to
      // a real `location.href` navigation to let the browser do it natively
      // — which, combined with global.css's `scroll-behavior: smooth`,
      // animates toward the target's position *as measured at the start of
      // the animation*. If that position shifts once the destination page's
      // own layout (reveal animations, stacked cards, images) settles, the
      // scroll lands short of the section instead of on it — which is what
      // reads as "jumps to the top of the page" rather than to the target.
      // Stripping the hash before Astro sees it skips that whole path, and
      // scrolling to the element ourselves (after the swap, `instant` so
      // there's no animation to get interrupted) lands exactly on the
      // section every time. The hash is restored in the URL afterwards so
      // the address bar/bookmark still reflect it.
      if (!window.__hashScrollFix) {
        window.__hashScrollFix = true;
        let pendingHash = '';
        document.addEventListener('astro:before-preparation', (event) => {
          if (event.to?.hash) {
            pendingHash = event.to.hash;
            event.to.hash = '';
          }
        });
        document.addEventListener('astro:after-swap', () => {
          if (!pendingHash) return;
          const hash = pendingHash;
          pendingHash = '';
          const target = document.querySelector(hash);
          if (!target) return;
          history.replaceState(history.state, '', location.pathname + location.search + hash);
          target.scrollIntoView({ behavior: 'instant', block: 'start' });
        });
      }

      // Belt-and-suspenders: global.css's `scroll-behavior: smooth` on <html>
      // applies to *every* scrollTo/scrollIntoView call, including the
      // `behavior: 'instant'` ones above and Astro's own internal ones during
      // a transition — 'instant' is supposed to override the CSS, but that's
      // not consistently honored on every browser/fallback path (older
      // Safari/Firefox without native View Transitions in particular, where
      // Astro's router keeps the outgoing page as live, visible DOM instead
      // of a frozen snapshot while it animates). Turning `scroll-behavior`
      // off entirely for the duration of the navigation removes any chance
      // of an animated scroll — ours or Astro's — being visible, on any
      // browser, regardless of which path is taken.
      if (!window.__noSmoothScrollDuringNav) {
        window.__noSmoothScrollDuringNav = true;
        const html = document.documentElement;
        document.addEventListener('astro:before-preparation', () => {
          html.style.scrollBehavior = 'auto';
        });
        document.addEventListener('astro:page-load', () => {
          html.style.scrollBehavior = '';
        });
      }
    </script>
    <script is:inline>
      // Altervista (shared hosting) drops a random handful of image requests
      // under concurrent load (net::ERR_HTTP2_PROTOCOL_ERROR /
      // ERR_CONNECTION_RESET, observed directly on the live site, not a bug
      // in this codebase) — the image is fine, just that one fetch failed.
      // Without a retry the <img> stays permanently broken until the whole
      // page is reloaded. 'error' doesn't bubble, so this has to listen in
      // the capture phase on `document` to catch it from any <img> anywhere.
      (function () {
        var MAX_RETRIES = 3;
        var RETRY_DELAY_MS = 800;
        var attempts = new WeakMap();
        document.addEventListener(
          'error',
          function (event) {
            var img = event.target;
            if (!(img instanceof HTMLImageElement) || !img.src) return;
            var count = attempts.get(img) || 0;
            if (count >= MAX_RETRIES) return;
            attempts.set(img, count + 1);
            var src = img.src;
            setTimeout(
              function () {
                img.src = src;
              },
              RETRY_DELAY_MS * (count + 1),
            );
          },
          true,
        );
      })();
    </script>
  </head>
  <body>
    <Header />
    <LangSwitcher />
    <main
      class:list={[isHome && 'relative z-[1] -mb-px overflow-hidden rounded-b-[2rem] bg-ink']}
      transition:animate="none"
    >
      <slot />
    </main>
    {isHome && <Footer />}
    <ScrollReveal />
    <Parallax />
    <BackgroundMusic />
  </body>
</html>
