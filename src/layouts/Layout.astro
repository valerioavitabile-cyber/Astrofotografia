---
import '@fontsource-variable/raleway';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import Parallax from '../components/Parallax.astro';
import BackgroundMusic from '../components/BackgroundMusic.astro';
import { site } from '../data/site';
import socialCard from '../assets/social-card.jpg';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  titleIt?: string;
  description?: string;
  descriptionIt?: string;
  preloadImage?: string;
}

const { title, titleIt, description = site.description, descriptionIt, preloadImage } = Astro.props;
const pageTitle = title === site.title ? site.title : `${title} · ${site.title}`;
const pageTitleIt = titleIt ? (titleIt === site.title ? site.title : `${titleIt} · ${site.title}`) : pageTitle;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === withBase('/');
---

<!doctype html>
<html lang="it" data-lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href={socialCard.src} />
    <script is:inline>
      // Set data-lang before anything paints, straight from localStorage, so
      // the page never flashes the wrong language before LangSwitcher's own
      // script runs (see components/LangSwitcher.astro).
      (function () {
        try {
          var l = localStorage.getItem('site-lang');
          document.documentElement.setAttribute('data-lang', l === 'en' ? 'en' : 'it');
          document.documentElement.setAttribute('lang', l === 'en' ? 'en' : 'it');
        } catch (e) {}
      })();
    </script>
    <title data-tr={JSON.stringify({ attr: 'text', en: pageTitle, it: pageTitleIt })}>{pageTitleIt}</title>
    <meta
      name="description"
      content={descriptionIt || description}
      data-tr={JSON.stringify({ attr: 'content', en: description, it: descriptionIt || description })}
    />
    <link rel="canonical" href={canonicalURL} />
    {preloadImage && <link rel="preload" as="image" fetchpriority="high" href={preloadImage} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(socialCard.src, site.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <script is:inline>
      // The portrait link's hover-zoom (group-hover:scale-110) stays active
      // through the click since the pointer never leaves the element before
      // navigation starts. Left as-is, the view-transition snapshot captures
      // the zoomed-in image and it visibly pops back to normal once the
      // (un-zoomed) about page swaps in. Delaying navigation just long enough
      // for the zoom to ease back to scale(1) removes that pop.
      if (!window.__portraitZoomFix) {
        window.__portraitZoomFix = true;
        document.addEventListener('astro:before-preparation', (event) => {
          const link = event.sourceElement?.closest?.('[data-portrait-link]');
          const img = link?.querySelector('img');
          if (!img || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          const originalLoader = event.loader;
          event.loader = async () => {
            img.classList.add('portrait-unzoom');
            await new Promise((resolve) => setTimeout(resolve, 1250));
            await originalLoader();
          };
        });
      }
    </script>
    <script is:inline define:vars={{ homePath: withBase('/') }}>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      // A single early scrollTo isn't enough: the browser can re-apply its
      // own scroll restoration after this script runs (notably on
      // 'pageshow', which also fires when the page is served from the
      // bfcache on refresh/back-forward), so it's forced back to the top
      // again at each of these later points too. It also has to run on
      // 'astro:after-swap' (not just 'load'/'pageshow'), since navigating to
      // "/" via the client-side router never re-fires those — without it,
      // the page briefly shows whatever scroll position the previous page
      // was at (e.g. the footer) until something scrolls it back up.
      // behavior: 'instant' is required too: global.css sets
      // scroll-behavior: smooth, so a plain scrollTo(0, 0) would glide up
      // from wherever the browser landed (often the footer, when the prior
      // page's raw scroll offset overshoots the home page's height),
      // visibly sliding the footer past the header hero on the way up.
      function resetHomeScroll() {
        if (window.location.pathname === homePath) window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      }
      resetHomeScroll();
      window.addEventListener('load', resetHomeScroll);
      window.addEventListener('pageshow', resetHomeScroll);
      document.addEventListener('astro:after-swap', resetHomeScroll);

      // A link click to the *same* URL the browser is already on (e.g. the
      // footer's "Torna alla Home", clicked while already on "/") makes
      // Chrome silently restore the scroll offset the page had right before
      // that navigation — animated by the browser itself, independently of
      // history.scrollRestoration (which only governs back/forward) and of
      // our own JS (which can't run early enough to stop an animation the
      // browser starts internally, before or alongside painting). It plays
      // out over the page's whole load time (measured: ~800ms, easing from
      // 0 up toward the old offset), so a single resetHomeScroll() on
      // 'load'/'pageshow' lands in the middle of that animation at an
      // unpredictable frame — which is exactly what read as "sometimes
      // lands with some random leftover scroll" (reported on the footer's
      // back-to-home button specifically, since it's the only one that's a
      // same-URL navigation; every other "back to home" link goes from a
      // *different* page, which the browser has no old offset to restore).
      // Repeatedly pinning to 0 every animation frame, instead of a few
      // discrete resets, fights that animation on every frame it takes
      // instead of just interrupting it once mid-flight.
      if (window.location.pathname === homePath) {
        const pinStart = performance.now();
        const pinHomeScroll = () => {
          resetHomeScroll();
          if (performance.now() - pinStart < 1500) requestAnimationFrame(pinHomeScroll);
        };
        requestAnimationFrame(pinHomeScroll);
      }

      // There used to also be an 'astro:before-preparation' handler here that
      // pre-scrolled the *outgoing* page to the top as soon as a navigation
      // to "/" was requested — added back when <main> still crossfaded
      // between pages, to stop the old page's leftover scrollY (e.g. deep
      // down a long "courses" page) from flashing the home page's sticky
      // footer during the transition. Since <main> now uses
      // transition:animate="none" (see below; decisioni.md, 2026-08-12),
      // there's no crossfade snapshot left for that leftover scrollY to leak
      // into, so the pre-scroll had become pure overhead — and worse, a bug
      // in its own right: it's a real scrollTo on the still-visible outgoing
      // page, landing ~50-100ms before the swap, which reads as "scrolls to
      // the top, then changes page" (reported on the video-utility "Torna
      // alla Home" button after scrolling deep down the page). Removed;
      // resetHomeScroll() on 'astro:after-swap' alone is enough now that the
      // swap itself is an instant cut.
      // "Torna a ..." links point at another page's #section (e.g.
      // /video-utility/#tools). Astro's router can't scroll to a fragment as
      // part of its own SPA-style swap, so for any `to.hash` it falls back to
      // a real `location.href` navigation to let the browser do it natively
      // — which, combined with global.css's `scroll-behavior: smooth`,
      // animates toward the target's position *as measured at the start of
      // the animation*. If that position shifts once the destination page's
      // own layout (reveal animations, stacked cards, images) settles, the
      // scroll lands short of the section instead of on it — which is what
      // reads as "jumps to the top of the page" rather than to the target.
      // Stripping the hash before Astro sees it skips that whole path, and
      // scrolling to the element ourselves (after the swap, `instant` so
      // there's no animation to get interrupted) lands exactly on the
      // section every time. The hash is restored in the URL afterwards so
      // the address bar/bookmark still reflect it.
      // Forces the footer's fade+blur-in reveal (see Footer.astro's
      // `.sticky-footer`/`.is-visible`) to actually replay when jumping to
      // it directly via a "Contatti"-style link. Left to itself, the
      // footer's IntersectionObserver marks it `is-visible` the moment it's
      // set up on page load — because it's `position: sticky; bottom: 0`,
      // its bounding box already sits at the viewport's bottom edge from
      // the very first paint (just visually hidden behind the opaque
      // `<main>` curtain sliding over it), so IntersectionObserver reports
      // it as "intersecting" immediately, well before any real scrolling
      // happens. By the time a same-page click jumps straight to it, the
      // reveal has already fully resolved to opaque/sharp with nothing left
      // to animate — the click just felt like a hard cut. Stripping
      // `is-visible` right before the jump and re-adding it a frame later
      // (after `offsetWidth` forces the hidden frame to actually paint)
      // replays the transition on demand instead of relying on it having
      // already fired at some meaningless earlier moment.
      function replayFooterReveal() {
        const footer = document.getElementById('site-footer');
        if (!footer) return;
        // Removing the class alone would still animate — from whatever
        // opacity/blur it already had (usually fully visible, per the note
        // above) back down toward hidden — which is itself a transition,
        // so re-adding the class a frame later just reverses that partway
        // through, reading as a quick flicker/dip instead of a clean fade
        // in from nothing. Suspending the transition for the instant the
        // hidden state is applied (then re-enabling it before the class
        // goes back on) forces a hard, invisible jump to hidden first, so
        // what plays afterward is a genuine fade+blur-in from zero.
        footer.style.transition = 'none';
        footer.classList.remove('is-visible');
        void footer.offsetWidth;
        footer.style.transition = '';
        requestAnimationFrame(() => footer.classList.add('is-visible'));
      }

      if (!window.__hashScrollFix) {
        window.__hashScrollFix = true;
        let pendingHash = '';
        document.addEventListener('astro:before-preparation', (event) => {
          if (event.to?.hash) {
            pendingHash = event.to.hash;
            event.to.hash = '';
          }
        });
        document.addEventListener('astro:after-swap', () => {
          if (!pendingHash) return;
          const hash = pendingHash;
          pendingHash = '';
          const target = document.querySelector(hash);
          if (!target) return;
          history.replaceState(history.state, '', location.pathname + location.search + hash);
          // #site-footer is `position: sticky` to its own scroll container,
          // not a normal in-flow element — scrollIntoView() computes its
          // target offset from getBoundingClientRect(), which for a sticky
          // element mid-viewport-pin returns wherever it's currently stuck
          // rather than its natural document position, so it lands far short
          // of the page bottom. Scrolling the page to its max scroll extent
          // is the only way to actually reveal it.
          if (hash === '#site-footer') {
            replayFooterReveal();
            window.scrollTo({ top: document.documentElement.scrollHeight, left: 0, behavior: 'instant' });
          } else {
            target.scrollIntoView({ behavior: 'instant', block: 'start' });
          }
        });
      }

      // The fix above only fires on an actual page transition
      // ('astro:before-preparation' / 'astro:after-swap'), but a click on
      // "Contatti" while already sitting on the home page is a same-URL,
      // hash-only navigation — Astro's router doesn't treat that as a
      // transition at all, so those events never fire and the click falls
      // through to the browser's native anchor-jump, which undershoots for
      // the same sticky-footer reason described above (and, unlike a real
      // transition, there's no swap to wait for — so it's not slow, it just
      // silently lands in the wrong place). Handling the click directly
      // here, independent of the transition lifecycle, is what makes the
      // jump immediate and correct regardless of what the entrance
      // animations on the page are doing.
      if (!window.__siteFooterClickFix) {
        window.__siteFooterClickFix = true;
        document.addEventListener('click', (event) => {
          const link = event.target.closest?.('a[href*="#site-footer"]');
          if (!link) return;
          const url = new URL(link.href, location.href);
          if (url.pathname !== location.pathname) return;
          event.preventDefault();
          history.replaceState(history.state, '', url.pathname + url.search + url.hash);
          replayFooterReveal();
          window.scrollTo({ top: document.documentElement.scrollHeight, left: 0, behavior: 'instant' });
        });
      }

      // Drives Footer.astro's `html[data-nav-swap] .sticky-footer` guard
      // (forces the footer hidden mid-swap so it can't flash through before
      // the incoming page settles). Deliberately our own attribute instead
      // of Astro's own `data-astro-transition`: that one is only removed
      // once `ViewTransition.finished` resolves, measured at ~2.5-3s after
      // landing on the page (real Chromium) — leaving the footer forced
      // invisible that whole time on any cross-page arrival at
      // "#site-footer" (reported: About → "Contatti" felt like it "took
      // forever" to fade in). 'astro:page-load' fires within a frame or two
      // of the actual DOM swap, so clearing on it instead removes that
      // multi-second dead wait without losing the original protection.
      if (!window.__navSwapGuard) {
        window.__navSwapGuard = true;
        const html = document.documentElement;
        document.addEventListener('astro:before-preparation', () => {
          html.setAttribute('data-nav-swap', '');
        });
        document.addEventListener('astro:page-load', () => {
          html.removeAttribute('data-nav-swap');
        });
      }

      // Belt-and-suspenders: global.css's `scroll-behavior: smooth` on <html>
      // applies to *every* scrollTo/scrollIntoView call, including the
      // `behavior: 'instant'` ones above and Astro's own internal ones during
      // a transition — 'instant' is supposed to override the CSS, but that's
      // not consistently honored on every browser/fallback path (older
      // Safari/Firefox without native View Transitions in particular, where
      // Astro's router keeps the outgoing page as live, visible DOM instead
      // of a frozen snapshot while it animates). Turning `scroll-behavior`
      // off entirely for the duration of the navigation removes any chance
      // of an animated scroll — ours or Astro's — being visible, on any
      // browser, regardless of which path is taken.
      if (!window.__noSmoothScrollDuringNav) {
        window.__noSmoothScrollDuringNav = true;
        const html = document.documentElement;
        document.addEventListener('astro:before-preparation', () => {
          html.style.scrollBehavior = 'auto';
        });
        document.addEventListener('astro:page-load', () => {
          html.style.scrollBehavior = '';
        });
      }
    </script>
    <script is:inline>
      // .img-zoom photos (tutorial/article images): zoom only engages after
      // a click (not on hover), toggling .is-zoomed (see global.css). While
      // zoomed, tracking the pointer and moving transform-origin to match
      // lets the zoomed-in view pan to wherever the cursor is, so every part
      // of the photo (including corners) becomes reachable instead of always
      // cropping around a fixed center. Clicking the photo again, clicking
      // elsewhere, or pressing Escape zooms back out. Delegated on
      // `document` so it keeps working after Astro's client-side
      // navigations swap in new .img-zoom elements, without needing to
      // re-run setup on every page load.
      if (!window.__imgZoomPan) {
        window.__imgZoomPan = true;

        function panTo(wrap, clientX, clientY) {
          const img = wrap.querySelector('img');
          if (!img) return;
          const rect = wrap.getBoundingClientRect();
          const x = ((clientX - rect.left) / rect.width) * 100;
          const y = ((clientY - rect.top) / rect.height) * 100;
          img.style.transformOrigin = `${Math.max(0, Math.min(100, x))}% ${Math.max(0, Math.min(100, y))}%`;
        }

        document.addEventListener('click', (event) => {
          const wrap = event.target.closest?.('.img-zoom');
          const current = document.querySelector('.img-zoom.is-zoomed');
          if (current && current !== wrap) current.classList.remove('is-zoomed');
          if (!wrap) return;
          const nowZoomed = wrap.classList.toggle('is-zoomed');
          if (nowZoomed) panTo(wrap, event.clientX, event.clientY);
        });

        document.addEventListener('pointermove', (event) => {
          const wrap = event.target.closest?.('.img-zoom.is-zoomed');
          if (!wrap) return;
          panTo(wrap, event.clientX, event.clientY);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          document.querySelector('.img-zoom.is-zoomed')?.classList.remove('is-zoomed');
        });
      }
    </script>
    <script is:inline>
      // Altervista (shared hosting) drops a random handful of image requests
      // under concurrent load (net::ERR_HTTP2_PROTOCOL_ERROR /
      // ERR_CONNECTION_RESET, observed directly on the live site, not a bug
      // in this codebase) — the image is fine, just that one fetch failed.
      // Without a retry the <img> stays permanently broken until the whole
      // page is reloaded. 'error' doesn't bubble, so this has to listen in
      // the capture phase on `document` to catch it from any <img> anywhere.
      (function () {
        var MAX_RETRIES = 3;
        var RETRY_DELAY_MS = 800;
        var attempts = new WeakMap();
        document.addEventListener(
          'error',
          function (event) {
            var img = event.target;
            if (!(img instanceof HTMLImageElement) || !img.src) return;
            var count = attempts.get(img) || 0;
            if (count >= MAX_RETRIES) return;
            attempts.set(img, count + 1);
            var src = img.src;
            setTimeout(
              function () {
                img.src = src;
              },
              RETRY_DELAY_MS * (count + 1),
            );
          },
          true,
        );
      })();
    </script>
  </head>
  <body>
    <Header />
    <LangSwitcher />
    <main
      class:list={[isHome && 'relative z-[1] -mb-px overflow-hidden rounded-b-[2rem] bg-ink']}
      transition:animate="none"
    >
      <slot />
    </main>
    {isHome && <Footer />}
    <ScrollReveal />
    <Parallax />
    <BackgroundMusic />
  </body>
</html>
