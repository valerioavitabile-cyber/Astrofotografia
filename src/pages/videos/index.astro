---
import Layout from '../../layouts/Layout.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';

const videos = [
  { id: 'Ug6HP7CV-hY', title: 'Astrophotography video 1' },
  { id: 'sKDhDhjzNQ8', title: 'Astrophotography video 2' },
  { id: 'ABFydJXkaW4', title: 'Astrophotography video 3' },
  { id: 'Iu5LRdpN_7A', title: 'Astrophotography video 4' },
];
---

<Layout title="Video & Tutorials" description="Astrophotography videos and tutorials by Valerio Avitabile.">
  <section class="mx-auto max-w-5xl px-6 py-20">
    <p class="eyebrow text-center">Video &amp; Tutorials</p>
    <h1 class="mt-3 text-center text-4xl font-semibold sm:text-5xl">Watch &amp; learn</h1>

    <div class="mt-14 grid gap-8 sm:grid-cols-2">
      {videos.map((v) => <LiteYouTube videoId={v.id} title={v.title} />)}
    </div>

    <div class="mt-16 text-center">
      <a href="/utility/" class="btn-accent">Plate solve and other utilities</a>
    </div>
  </section>
</Layout>
