---
// Pagina temporanea di diagnostica per il bug "animazioni non si vedono su
// mobile" segnalato dall'utente: verifica prefers-reduced-motion e misura
// dal vivo la durata di una transizione CSS. Da rimuovere una volta chiuso
// il ticket.
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Diagnostica Animazioni</title>
    <style>
      :root {
        --bg: #0b0d10;
        --surface: #14171b;
        --surface-2: #1b1f24;
        --line: #262b31;
        --text: #e8e6df;
        --muted: #868c96;
        --amber: #e8a33d;
        --amber-dim: #8a672c;
        --good: #6fcf7d;
        --bad: #ff6b6b;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: ui-monospace, 'Cascadia Mono', 'Segoe UI Mono', Consolas, 'SFMono-Regular', Menlo, monospace;
        font-size: 15px;
        line-height: 1.5;
        padding: 28px 18px 60px;
      }

      main {
        max-width: 640px;
        margin: 0 auto;
      }

      header {
        margin-bottom: 28px;
      }

      .eyebrow {
        color: var(--amber);
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0 0 8px;
      }

      h1 {
        font-size: clamp(22px, 6vw, 28px);
        margin: 0 0 10px;
        text-wrap: balance;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      header p {
        color: var(--muted);
        margin: 0;
        max-width: 60ch;
      }

      section {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface);
        margin-bottom: 20px;
        overflow: hidden;
      }

      .section-title {
        padding: 12px 16px;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        border-bottom: 1px solid var(--line);
        background: var(--surface-2);
      }

      .row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 11px 16px;
        border-bottom: 1px solid var(--line);
      }

      .row:last-child {
        border-bottom: none;
      }

      .row .k {
        color: var(--muted);
        flex: 0 0 auto;
      }

      .row .v {
        text-align: right;
        word-break: break-word;
        font-variant-numeric: tabular-nums;
      }

      .v.pass {
        color: var(--good);
      }

      .v.fail {
        color: var(--bad);
      }

      .v.neutral {
        color: var(--text);
      }

      .ua-row .v {
        text-align: left;
        color: var(--muted);
        font-size: 12.5px;
        max-width: 100%;
      }

      .verdict {
        padding: 16px;
        font-size: 14.5px;
      }

      .verdict strong {
        color: var(--amber);
      }

      .test-box {
        padding: 20px 16px 24px;
      }

      .test-track {
        position: relative;
        height: 64px;
        border: 1px dashed var(--line);
        border-radius: 8px;
        background: var(--bg);
        overflow: hidden;
        margin-bottom: 14px;
      }

      .test-chip {
        position: absolute;
        top: 12px;
        left: 12px;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: var(--amber-dim);
        opacity: 0;
        transform: translateX(-8px) scale(0.85);
        transition:
          opacity 1.5s ease-out,
          transform 1.5s ease-out,
          background-color 0.3s;
      }

      .test-chip.armed {
        opacity: 1;
        transform: translateX(0) scale(1);
        background: var(--amber);
      }

      button {
        font: inherit;
        background: var(--amber);
        color: #211602;
        border: none;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: 0.02em;
      }

      button:active {
        background: var(--amber-dim);
      }

      button:focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 2px;
      }

      .test-result {
        margin-top: 12px;
        color: var(--muted);
        min-height: 20px;
      }

      .test-result strong {
        color: var(--text);
      }

      footer {
        color: var(--muted);
        font-size: 13px;
        text-align: center;
        margin-top: 32px;
      }

      .sticky-section {
        position: sticky;
        top: 8px;
        z-index: 10;
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
      }

      .spacer {
        height: 130vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-size: 13px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .reveal-replica {
        opacity: 0;
        transform: translateX(-16rem);
        transition:
          opacity 2s ease-out,
          transform 2s ease-out;
        padding: 16px;
        border-radius: 8px;
        background: var(--surface-2);
        border: 1px solid var(--line);
        margin-bottom: 12px;
      }

      .reveal-replica.is-visible {
        opacity: 1;
        transform: translateX(0);
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">Astrofotografia &mdash; Diagnostica</p>
        <h1>Perch&eacute; non vedo le animazioni?</h1>
        <p>
          Questa pagina legge le impostazioni del tuo telefono e fa un test dal vivo, per capire se il browser sta
          bloccando le animazioni o se il problema &egrave; nel sito.
        </p>
      </header>

      <section>
        <div class="section-title">Impostazioni rilevate</div>
        <div class="row">
          <span class="k">Riduci movimento (prefers-reduced-motion)</span>
          <span class="v" id="rm">&hellip;</span>
        </div>
        <div class="row">
          <span class="k">Dispositivo touch (hover: none)</span>
          <span class="v neutral" id="hover">&hellip;</span>
        </div>
        <div class="row">
          <span class="k">Risparmio dati (Data Saver)</span>
          <span class="v neutral" id="savedata">&hellip;</span>
        </div>
        <div class="row">
          <span class="k">Viewport</span>
          <span class="v neutral" id="viewport">&hellip;</span>
        </div>
        <div class="row ua-row">
          <span class="k">Browser</span>
          <span class="v" id="ua">&hellip;</span>
        </div>
      </section>

      <section>
        <div class="section-title">Test animazione dal vivo</div>
        <div class="test-box">
          <div class="test-track">
            <div class="test-chip" id="chip"></div>
          </div>
          <button id="run">Avvia test (1,5s)</button>
          <div class="test-result" id="result">
            Premi il pulsante: il quadratino dovrebbe scivolare e dissolversi dentro in un secondo e mezzo, non
            comparire di scatto.
          </div>
        </div>
      </section>

      <section id="scroll-live" class="sticky-section">
        <div class="section-title">Scroll dal vivo (scorri questa pagina)</div>
        <div class="row">
          <span class="k">Eventi "scroll" ricevuti</span>
          <span class="v" id="scrollcount">0</span>
        </div>
        <div class="row">
          <span class="k">scrollY attuale</span>
          <span class="v neutral" id="scrolly">0</span>
        </div>
        <div class="row">
          <span class="k">innerHeight attuale</span>
          <span class="v neutral" id="innerh">&hellip;</span>
        </div>
      </section>

      <section>
        <div class="section-title">Replica esatta dell'animazione del sito</div>
        <div class="test-box">
          <p style="margin:0 0 14px;color:var(--muted)">
            Scorri fino al riquadro qui sotto: deve restare invisibile finch&eacute; non ci arrivi, poi scivolare
            dentro da sinistra in 2 secondi, esattamente come le sezioni della home.
          </p>
        </div>
      </section>

      <div class="spacer">&darr; continua a scorrere &darr;</div>

      <section>
        <div class="section-title">Riquadro da rivelare</div>
        <div class="test-box">
          <div class="reveal-replica" id="revealbox">Se leggi questo testo chiaramente e SUBITO senza averlo visto scivolare dentro, l'animazione non &egrave; partita.</div>
          <div class="test-result" id="revealstatus">In attesa di entrare in viewport&hellip;</div>
        </div>
      </section>

      <section>
        <div class="section-title">Verdetto</div>
        <div class="verdict" id="verdict">Esegui il test qui sopra per vedere il verdetto.</div>
      </section>

      <footer>Fai uno screenshot di questa pagina (dopo aver premuto il test) e mandalo.</footer>
    </main>

    <script>
      (function () {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const rmEl = document.getElementById('rm')!;
        rmEl.textContent = reduced ? 'ATTIVO' : 'disattivo';
        rmEl.className = 'v ' + (reduced ? 'fail' : 'pass');

        const hover = window.matchMedia('(hover: none)').matches;
        document.getElementById('hover')!.textContent = hover ? 'si (touch)' : 'no (mouse)';

        const conn = (navigator as any).connection || (navigator as any).webkitConnection || (navigator as any).mozConnection;
        const saveDataEl = document.getElementById('savedata')!;
        if (conn && typeof conn.saveData === 'boolean') {
          saveDataEl.textContent = conn.saveData ? 'ATTIVO' : 'disattivo';
          saveDataEl.className = 'v ' + (conn.saveData ? 'fail' : 'pass');
        } else {
          saveDataEl.textContent = 'non rilevabile';
        }

        document.getElementById('viewport')!.textContent =
          window.innerWidth + ' x ' + window.innerHeight + ' (dpr ' + (window.devicePixelRatio || 1) + ')';

        document.getElementById('ua')!.textContent = navigator.userAgent;

        // Live scroll-event counter: if this stays at 0 while the user
        // physically scrolls, the site's window-'scroll' listeners (hero
        // shrink, parallax) never fire on this device/browser, which is a
        // completely different bug from IntersectionObserver-based reveals.
        let scrollEvents = 0;
        const scrollCountEl = document.getElementById('scrollcount')!;
        const scrollYEl = document.getElementById('scrolly')!;
        const innerHEl = document.getElementById('innerh')!;
        const updateScrollStats = () => {
          scrollYEl.textContent = String(Math.round(window.scrollY));
          innerHEl.textContent = String(window.innerHeight);
        };
        window.addEventListener(
          'scroll',
          () => {
            scrollEvents++;
            scrollCountEl.textContent = String(scrollEvents);
            updateScrollStats();
          },
          { passive: true },
        );
        window.addEventListener('resize', updateScrollStats);
        updateScrollStats();

        // Exact replica of ScrollReveal.astro's .reveal-left mechanism: same
        // rootMargin/threshold, same class toggle. If this box reveals
        // itself before actually being scrolled into view, the bug is in
        // IntersectionObserver setup/timing, not in the CSS transition.
        const revealBox = document.getElementById('revealbox')!;
        const revealStatus = document.getElementById('revealstatus')!;
        let revealTriggerCount = 0;
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.target.classList.toggle('is-visible', entry.isIntersecting);
              if (entry.isIntersecting) {
                revealTriggerCount++;
                revealStatus.textContent =
                  'Rivelato alla scrollY=' + Math.round(window.scrollY) + ' (trigger #' + revealTriggerCount + ')';
              } else {
                revealStatus.textContent = 'Fuori viewport (in attesa)';
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
        );
        revealObserver.observe(revealBox);

        // Catches the exact bug this page exists to diagnose: if the box is
        // already marked visible within the first second after load, without
        // any scroll having happened, something is wrong with the observer
        // setup itself (e.g. a layout/viewport-height quirk on this device),
        // not with scroll handling.
        setTimeout(() => {
          if (revealBox.classList.contains('is-visible') && scrollEvents === 0) {
            revealStatus.textContent =
              '⚠ Rivelato SENZA scroll e senza eventi scroll: il box era già "visibile" al caricamento.';
          }
        }, 1000);

        const chip = document.getElementById('chip')!;
        const resultEl = document.getElementById('result')!;
        const verdictEl = document.getElementById('verdict')!;
        let running = false;

        document.getElementById('run')!.addEventListener('click', () => {
          if (running) return;
          running = true;
          chip.classList.remove('armed');
          void (chip as HTMLElement).offsetWidth;

          const start = performance.now();
          let finished = false;

          const onEnd = (e: TransitionEvent) => {
            if (e.propertyName !== 'opacity' || finished) return;
            finished = true;
            const elapsed = Math.round(performance.now() - start);
            chip.removeEventListener('transitionend', onEnd as EventListener);
            resultEl.innerHTML = 'Durata misurata: <strong>' + elapsed + ' ms</strong> (richiesti 1500 ms).';

            if (elapsed > 800) {
              verdictEl.innerHTML =
                '<strong>Le animazioni funzionano</strong> in questo browser (transizione fluida da ' +
                elapsed +
                ' ms). Il problema è quindi specifico del sito, non del telefono: lo sistemo dal codice, grazie per il test.';
            } else if (reduced) {
              verdictEl.innerHTML =
                '<strong>Confermato</strong>: il tuo browser segnala "riduci movimento" attivo, quindi il sito disattiva le animazioni di proposito (è una scelta di accessibilità). Il nome dell\'opzione sul tuo telefono è diverso da quello che abbiamo cercato in Accessibilità.';
            } else {
              verdictEl.innerHTML =
                '<strong>Anomalia</strong>: "riduci movimento" risulta disattivo ma la transizione è comunque quasi istantanea (' +
                elapsed +
                ' ms). Probabile blocco a livello di sistema/batteria non rilevabile da JavaScript. Manda uno screenshot di questa pagina.';
            }

            running = false;
          };

          chip.addEventListener('transitionend', onEnd as EventListener);
          requestAnimationFrame(() => {
            chip.classList.add('armed');
          });

          setTimeout(() => {
            if (!finished) {
              finished = true;
              running = false;
              resultEl.textContent = 'Il test non ha completato correttamente (evento mancante). Riprova.';
            }
          }, 3000);
        });
      })();
    </script>
  </body>
</html>
