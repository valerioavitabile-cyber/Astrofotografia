---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { categories, type CategorySlug } from '../../../data/site';
import { withBase } from '../../../utils/url';

export async function getStaticPaths() {
  return Object.entries(categories).map(([id, cat]) => ({
    params: { category: cat.slug },
    props: { categoryId: id as CategorySlug },
  }));
}

const { categoryId } = Astro.props;
const cat = categories[categoryId];
const entries = (await getCollection('portfolio')).filter((e) => e.id.split('/')[0] === categoryId);

const descriptionEntry = await getEntry('categories', categoryId);
const [descriptionIt, descriptionEn] = descriptionEntry?.body?.split(/\n\n---\n\n/) ?? ['', ''];
---

<Layout
  title={cat.title}
  titleIt={cat.titleIt}
  description={`${cat.blurb} — astrophotography portfolio by Valerio Avitabile.`}
  descriptionIt={`${cat.blurbIt} — portfolio di astrofotografia di Valerio Avitabile.`}
>
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-20">
    <p class="reveal-left whitespace-pre-line text-white/60">
      <span data-lang-en>{descriptionEn.trim() || cat.blurb}</span>
      <span data-lang-it>{descriptionIt.trim() || cat.blurbIt}</span>
    </p>

    {entries.length >= 2 ? (
      <div class="stack-gallery mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => (
          <a
            href={withBase(`/portfolio/${cat.slug}/${entry.id.split('/').pop()}/`)}
            class="stack-card group relative overflow-hidden rounded-2xl border border-white/10 hover:border-accent/60"
          >
            <Image
              quality={90}
              src={entry.data.image}
              alt={entry.data.title}
              width={480}
              height={360}
              class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:brightness-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/5 to-transparent" />
            <p class="absolute inset-x-0 bottom-0 p-4 font-semibold text-white">
              <span data-lang-en>{entry.data.title}</span>
              <span data-lang-it>{entry.data.titleIt}</span>
            </p>
          </a>
        ))}
      </div>
    ) : (
      <div class="mt-14 flex justify-center">
        {entries.map((entry) => (
          <a
            href={withBase(`/portfolio/${cat.slug}/${entry.id.split('/').pop()}/`)}
            class="group relative block w-full max-w-xl overflow-hidden rounded-2xl border border-white/10 hover:border-accent/60"
          >
            <Image
              quality={90}
              src={entry.data.image}
              alt={entry.data.title}
              width={480}
              height={360}
              class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:brightness-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/5 to-transparent" />
            <p class="absolute inset-x-0 bottom-0 p-4 font-semibold text-white">
              <span data-lang-en>{entry.data.title}</span>
              <span data-lang-it>{entry.data.titleIt}</span>
            </p>
          </a>
        ))}
      </div>
    )}

    <div class="mt-20 flex justify-center">
      <a href={withBase('/#portfolio')} class="btn-accent justify-center min-w-[190px]">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span data-lang-en>Back to Portfolio</span>
        <span data-lang-it>Torna al Portfolio</span>
      </a>
    </div>
  </section>
</Layout>
