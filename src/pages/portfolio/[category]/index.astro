---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { categories, type CategorySlug } from '../../../data/site';

export async function getStaticPaths() {
  return Object.entries(categories).map(([id, cat]) => ({
    params: { category: cat.slug },
    props: { categoryId: id as CategorySlug },
  }));
}

const { categoryId } = Astro.props;
const cat = categories[categoryId];
const entries = (await getCollection('portfolio')).filter((e) => e.data.category === categoryId);
---

<Layout
  title={cat.title}
  titleIt={cat.titleIt}
  description={`${cat.blurb} — astrophotography portfolio by Valerio Avitabile.`}
  descriptionIt={`${cat.blurbIt} — portfolio di astrofotografia di Valerio Avitabile.`}
>
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-20">
    {cat.description && cat.descriptionIt ? (
      <p class="reveal-left max-w-2xl whitespace-pre-line text-white/60">
        <span data-lang-en>{cat.description}</span>
        <span data-lang-it>{cat.descriptionIt}</span>
      </p>
    ) : (
      <p class="reveal-left max-w-xl text-white/60">
        <span data-lang-en>{cat.blurb}</span>
        <span data-lang-it>{cat.blurbIt}</span>
      </p>
    )}

    <div class="fan-gallery mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <a
          href={`/portfolio/${cat.slug}/${entry.id}/`}
          class="fan-card group relative overflow-hidden rounded-2xl border border-white/10 hover:border-accent/60"
        >
          <Image
            quality={90}
            src={entry.data.image}
            alt={entry.data.title}
            width={480}
            height={360}
            class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:brightness-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/5 to-transparent" />
          <p class="absolute inset-x-0 bottom-0 p-4 font-semibold text-white">{entry.data.title}</p>
        </a>
      ))}
    </div>

    <div class="mt-14 flex justify-center">
      <a href="/#portfolio" class="btn-accent justify-center min-w-[190px]">
        <span>Portfolio</span>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
