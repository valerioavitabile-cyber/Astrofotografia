---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { categories, type CategorySlug } from '../../../data/site';

export async function getStaticPaths() {
  return Object.entries(categories).map(([id, cat]) => ({
    params: { category: cat.slug },
    props: { categoryId: id as CategorySlug },
  }));
}

const { categoryId } = Astro.props;
const cat = categories[categoryId];
const entries = (await getCollection('portfolio')).filter((e) => e.data.category === categoryId);
---

<Layout
  title={cat.title}
  titleIt={cat.titleIt}
  description={`${cat.blurb} — astrophotography portfolio by Valerio Avitabile.`}
  descriptionIt={`${cat.blurbIt} — portfolio di astrofotografia di Valerio Avitabile.`}
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <a href="/#portfolio" class="text-sm text-white/50 hover:text-accent">
      <span data-lang-en>&larr; Back to portfolio</span>
      <span data-lang-it>&larr; Torna al portfolio</span>
    </a>
    <p class="eyebrow mt-6">Portfolio</p>
    <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">
      <span data-lang-en>{cat.title}</span>
      <span data-lang-it>{cat.titleIt}</span>
    </h1>
    <p class="mt-3 max-w-xl text-white/60">
      <span data-lang-en>{cat.blurb}</span>
      <span data-lang-it>{cat.blurbIt}</span>
    </p>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <a
          href={`/portfolio/${cat.slug}/${entry.id}/`}
          class="group relative overflow-hidden rounded-2xl border border-white/10 transition duration-500 hover:border-accent/60"
        >
          <Image
            quality={90}
            src={entry.data.image}
            alt={entry.data.title}
            width={480}
            height={360}
            class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:brightness-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/5 to-transparent" />
          <p class="absolute inset-x-0 bottom-0 p-4 font-semibold text-white">{entry.data.title}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
