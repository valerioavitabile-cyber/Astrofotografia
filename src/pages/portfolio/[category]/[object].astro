---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Lightbox from '../../../components/Lightbox';
import { categories } from '../../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('portfolio');
  return entries.map((entry) => {
    const cat = categories[entry.data.category];
    return {
      params: { category: cat.slug, object: entry.id },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const cat = categories[entry.data.category];
const optimized = await getImage({ src: entry.data.image, width: 1600, quality: 90 });
---

<Layout title={entry.data.title} description={`${entry.data.title} — astrophotography by Valerio Avitabile.`}>
  <section class="mx-auto max-w-4xl px-6 py-16">
    <a href={`/portfolio/${cat.slug}/`} class="text-sm text-white/50 hover:text-accent">
      &larr; Back to {cat.title}
    </a>

    <h1 class="mt-6 text-3xl font-semibold sm:text-4xl">{entry.data.title}</h1>

    <div class="mt-8 overflow-hidden rounded-2xl border border-white/10">
      <Lightbox
        client:load
        src={optimized.src}
        alt={entry.data.title}
        width={optimized.attributes.width as number}
        height={optimized.attributes.height as number}
      />
    </div>

    <div class="prose-astro mt-10 max-w-none">
      <Content />
    </div>

    {entry.data.astrobinLink && (
      <a href={entry.data.astrobinLink} target="_blank" rel="noopener" class="btn-accent mt-4">
        Equipment and Acquisition Details
      </a>
    )}
  </section>
</Layout>
