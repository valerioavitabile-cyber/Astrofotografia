---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { marked } from 'marked';
import Lightbox from '../../../components/Lightbox';
import { categories } from '../../../data/site';
import astrobinData from '../../../data/astrobin.json';
import '@fontsource/space-mono';
import '@fontsource/space-mono/700.css';

export async function getStaticPaths() {
  const entries = await getCollection('portfolio');
  return entries.map((entry) => {
    const [categoryId, objectSlug] = entry.id.split('/');
    const cat = categories[categoryId as keyof typeof categories];
    return {
      params: { category: cat.slug, object: objectSlug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const [bodyIt, bodyEn] = entry.body?.split(/\n\n---\n\n/) ?? ['', ''];
const contentItHtml = await marked.parse(bodyIt.trim());
const contentEnHtml = await marked.parse(bodyEn.trim());
const cat = categories[entry.id.split('/')[0] as keyof typeof categories];
const objectSlug = entry.id.split('/').pop() as string;
const acquisition = (astrobinData as Record<string, (typeof astrobinData)[string]>)[objectSlug];

function formatDuration(totalSeconds: number) {
  const totalMinutes = Math.round(totalSeconds / 60);
  const hours = Math.floor(totalMinutes / 60);
  const minutes = totalMinutes % 60;
  if (hours === 0) return `${minutes}m`;
  if (minutes === 0) return `${hours}h`;
  return `${hours}h ${minutes}m`;
}

// Right ascension is stored in degrees (0-360); astronomers read it in hours/minutes/seconds.
function formatRA(deg: number) {
  const totalHours = deg / 15;
  const h = Math.floor(totalHours);
  const totalMinutes = (totalHours - h) * 60;
  const m = Math.floor(totalMinutes);
  const s = Math.round((totalMinutes - m) * 60);
  return `${h}h ${m}m ${s}s`;
}

function formatDec(deg: number) {
  const sign = deg < 0 ? '−' : '+';
  const abs = Math.abs(deg);
  const d = Math.floor(abs);
  const totalMinutes = (abs - d) * 60;
  const m = Math.floor(totalMinutes);
  const s = Math.round((totalMinutes - m) * 60);
  return `${sign}${d}° ${m}′ ${s}″`;
}

const countryNamesEn = new Intl.DisplayNames(['en'], { type: 'region' });
const countryNamesIt = new Intl.DisplayNames(['it'], { type: 'region' });

function formatLocation(loc: { city: string | null; state: string | null; country: string | null }, locale: 'en' | 'it') {
  const countryName = loc.country ? (locale === 'it' ? countryNamesIt : countryNamesEn).of(loc.country) : null;
  return [loc.city, loc.state, countryName].filter(Boolean).join(', ');
}

function mostCommonBortle(sessions: { bortle: number | null }[]) {
  const counts = new Map<number, number>();
  for (const s of sessions) {
    if (s.bortle == null) continue;
    counts.set(s.bortle, (counts.get(s.bortle) ?? 0) + 1);
  }
  let best: number | null = null;
  let bestCount = 0;
  for (const [bortle, count] of counts) {
    if (count > bestCount) {
      best = bortle;
      bestCount = count;
    }
  }
  return best;
}

const bortle = acquisition ? mostCommonBortle(acquisition.deepSkyAcquisitions) : null;
const location = acquisition?.locations?.[0];
const hemisphere = location?.latSide === 'N' ? 'north' : location?.latSide === 'S' ? 'south' : null;

const hasPrimaryEquipment = acquisition
  ? acquisition.imagingTelescopes.length > 0 || acquisition.imagingCameras.length > 0 || acquisition.mounts.length > 0
  : false;

const hasSecondaryDetails = acquisition
  ? acquisition.guidingTelescopes.length > 0 ||
    acquisition.guidingCameras.length > 0 ||
    Boolean(location) ||
    bortle != null ||
    Boolean(hemisphere) ||
    (acquisition.solution?.ra != null && acquisition.solution?.dec != null) ||
    acquisition.solution?.pixscale != null ||
    acquisition.solution?.radiusDeg != null
  : false;
const optimized = await getImage({
  src: entry.data.image,
  width: 1600,
  quality: 90,
});
const fullRes = await getImage({
  src: entry.data.image,
  format: 'webp',
  quality: 75,
});
---

<Layout
  title={entry.data.title}
  description={`${entry.data.title} — astrophotography by Valerio Avitabile.`}
  descriptionIt={`${entry.data.title} — astrofotografia di Valerio Avitabile.`}
>
  <section class="mx-auto max-w-4xl px-6 pt-40 pb-16">
    <h1 class="text-3xl font-semibold sm:text-4xl">{entry.data.title}</h1>

    <div class="mt-8 overflow-hidden rounded-2xl border border-white/10">
      <Lightbox
        client:load
        src={optimized.src}
        fullSrc={fullRes.src}
        alt={entry.data.title}
        width={optimized.attributes.width as number}
        height={optimized.attributes.height as number}
      />
    </div>

    <div class="prose-astro mt-10 max-w-none">
      <div data-lang-en set:html={contentEnHtml} />
      <div data-lang-it set:html={contentItHtml} />
    </div>

    {acquisition && (
      <div class="console-panel mt-10">
        <div class="console-topbar">
          <span class="console-title">
            <span data-lang-en>Equipment &amp; Acquisition Log</span>
            <span data-lang-it>Registro Attrezzatura e Acquisizione</span>
          </span>
        </div>

        <dl class="console-ledger">
          {acquisition.totalIntegrationSeconds > 0 && (
            <div class="ledger-row">
              <dt title="TOTEXP">
                <span data-lang-en>Total integration</span><span data-lang-it>Integrazione totale</span>
              </dt>
              <dd>
                <span class="ledger-val">{formatDuration(acquisition.totalIntegrationSeconds)}</span>
              </dd>
            </div>
          )}
          {acquisition.imagingTelescopes.length > 0 && (
            <div class="ledger-row">
              <dt title="TELESCOP">
                <span data-lang-en>Telescope</span><span data-lang-it>Telescopio</span>
              </dt>
              <dd class="ledger-stack">
                {acquisition.imagingTelescopes.map((v) => <span class="ledger-val">{v}</span>)}
              </dd>
            </div>
          )}
          {acquisition.imagingCameras.length > 0 && (
            <div class="ledger-row">
              <dt title="INSTRUME">
                <span data-lang-en>Camera</span><span data-lang-it>Camera</span>
              </dt>
              <dd class="ledger-stack">
                {acquisition.imagingCameras.map((v) => <span class="ledger-val">{v}</span>)}
              </dd>
            </div>
          )}
          {acquisition.mounts.length > 0 && (
            <div class="ledger-row">
              <dt title="MOUNT">
                <span data-lang-en>Mount</span><span data-lang-it>Montatura</span>
              </dt>
              <dd class="ledger-stack">
                {acquisition.mounts.map((v) => <span class="ledger-val">{v}</span>)}
              </dd>
            </div>
          )}
          {acquisition.guidingTelescopes.length > 0 && (
            <div class="ledger-row">
              <dt title="GUIDESCP">
                <span data-lang-en>Guiding telescope</span><span data-lang-it>Strumento di guida</span>
              </dt>
              <dd class="ledger-stack">
                {acquisition.guidingTelescopes.map((v) => <span class="ledger-val">{v}</span>)}
              </dd>
            </div>
          )}
          {acquisition.guidingCameras.length > 0 && (
            <div class="ledger-row">
              <dt title="GUIDECAM">
                <span data-lang-en>Guiding camera</span><span data-lang-it>Camera di guida</span>
              </dt>
              <dd class="ledger-stack">
                {acquisition.guidingCameras.map((v) => <span class="ledger-val">{v}</span>)}
              </dd>
            </div>
          )}
          {location && (
            <div class="ledger-row">
              <dt title="SITE">
                <span data-lang-en>Location</span><span data-lang-it>Luogo</span>
              </dt>
              <dd>
                <span class="ledger-val">
                  <span data-lang-en>{formatLocation(location, 'en')}</span><span data-lang-it>{formatLocation(location, 'it')}</span>
                </span>
              </dd>
            </div>
          )}
          {hemisphere && (
            <div class="ledger-row">
              <dt title="HEMISPH">
                <span data-lang-en>Hemisphere</span><span data-lang-it>Emisfero</span>
              </dt>
              <dd>
                <span class="ledger-val">
                  <span data-lang-en>{hemisphere === 'north' ? 'Northern' : 'Southern'}</span>
                  <span data-lang-it>{hemisphere === 'north' ? 'Nord' : 'Sud'}</span>
                </span>
              </dd>
            </div>
          )}
          {bortle != null && (
            <div class="ledger-row">
              <dt title="BORTLE">
                <span data-lang-en>Bortle scale</span><span data-lang-it>Scala di Bortle</span>
              </dt>
              <dd>
                <span class="ledger-val">{bortle}</span>
              </dd>
            </div>
          )}
          {acquisition.solution?.ra != null && acquisition.solution?.dec != null && (
            <div class="ledger-row">
              <dt title="OBJCTRD">
                <span data-lang-en>Celestial coordinates</span><span data-lang-it>Coordinate celesti</span>
              </dt>
              <dd>
                <span class="ledger-val ledger-tabular">
                  RA {formatRA(acquisition.solution.ra)} · DEC {formatDec(acquisition.solution.dec)}
                </span>
              </dd>
            </div>
          )}
          {acquisition.solution?.pixscale != null && (
            <div class="ledger-row">
              <dt title="PIXSCALE">
                <span data-lang-en>Pixel scale</span><span data-lang-it>Campionamento</span>
              </dt>
              <dd>
                <span class="ledger-val ledger-tabular">{acquisition.solution.pixscale.toFixed(2)}″/px</span>
              </dd>
            </div>
          )}
          {acquisition.solution?.radiusDeg != null && (
            <div class="ledger-row">
              <dt title="FOVRAD">
                <span data-lang-en>Field radius</span><span data-lang-it>Raggio del campo</span>
              </dt>
              <dd>
                <span class="ledger-val ledger-tabular">{(acquisition.solution.radiusDeg * 60).toFixed(1)}′</span>
              </dd>
            </div>
          )}
          {acquisition.filters.length > 0 && (
            <div class="ledger-row">
              <dt title="FILTERS">
                <span data-lang-en>Filters</span><span data-lang-it>Filtri</span>
              </dt>
              <dd class="ledger-stack">
                {acquisition.filters.map((v) => <span class="ledger-val">{v}</span>)}
              </dd>
            </div>
          )}
          {acquisition.accessories.length > 0 && (
            <div class="ledger-row">
              <dt title="ACCESS">
                <span data-lang-en>Accessories</span><span data-lang-it>Accessori</span>
              </dt>
              <dd class="ledger-stack">
                {acquisition.accessories.map((v) => <span class="ledger-val">{v}</span>)}
              </dd>
            </div>
          )}
          {acquisition.software.length > 0 && (
            <div class="ledger-row">
              <dt title="SOFTWARE">
                <span data-lang-en>Software</span><span data-lang-it>Software</span>
              </dt>
              <dd class="ledger-stack">
                {acquisition.software.map((v) => <span class="ledger-val">{v}</span>)}
              </dd>
            </div>
          )}
        </dl>

        {acquisition.deepSkyAcquisitions.length > 0 && (
          <div class="console-sessions">
            <p class="console-sessions-label">
              <span data-lang-en>SESSION LOG</span>
              <span data-lang-it>REGISTRO SESSIONI</span>
            </p>
            <div class="console-table-scroll">
              <table class="console-table">
                <thead>
                  <tr>
                    <th>
                      <span data-lang-en>Date</span>
                      <span data-lang-it>Data</span>
                    </th>
                    <th>
                      <span data-lang-en>Filter</span>
                      <span data-lang-it>Filtro</span>
                    </th>
                    <th class="is-numeric">
                      <span data-lang-en>Frames</span>
                      <span data-lang-it>Pose</span>
                    </th>
                    <th class="is-numeric">
                      <span data-lang-en>Exposure</span>
                      <span data-lang-it>Esposizione</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {acquisition.deepSkyAcquisitions.map((session) => (
                    <tr>
                      <td>{session.date ?? '—'}</td>
                      <td>{session.filter ?? '—'}</td>
                      <td class="is-numeric">{session.number}×{session.durationSeconds}s</td>
                      <td class="is-numeric">{formatDuration((session.durationSeconds ?? 0) * session.number)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    )}

    <div class="mt-14 flex justify-center">
      <a href={`/portfolio/${cat.slug}/`} class="btn-accent justify-center min-w-[190px]">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span data-lang-en>Back to {cat.title}</span>
        <span data-lang-it>Torna a {cat.titleIt}</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .console-panel {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid rgba(247, 166, 10, 0.18);
    background: var(--color-ink);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    font-family: 'Space Mono', ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .console-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(247, 166, 10, 0.035) 0px,
      rgba(247, 166, 10, 0.035) 1px,
      transparent 1px,
      transparent 3px
    );
  }

  .console-panel > * {
    position: relative;
  }

  .console-topbar {
    border-bottom: 1px solid rgba(247, 166, 10, 0.18);
    padding: 1.1rem 1.25rem;
  }

  .console-title {
    display: block;
    color: var(--color-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.125rem;
  }

  .console-ledger {
    padding: 0.4rem 1.25rem;
  }

  .ledger-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.9rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .ledger-row:last-child {
    border-bottom: none;
  }

  .ledger-row dt {
    flex: 0 0 auto;
    min-width: 11rem;
    color: var(--color-accent-dim);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    cursor: help;
  }

  .ledger-row dd {
    display: flex;
    flex: 1 1 16rem;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6em;
    min-width: 0;
  }

  .ledger-row dd.ledger-stack {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }

  .ledger-val {
    color: #f2f2f4;
    word-break: break-word;
  }

  .ledger-tabular {
    font-variant-numeric: tabular-nums;
  }

  .console-sessions {
    border-top: 1px solid rgba(247, 166, 10, 0.18);
    padding: 1rem 1.25rem 1.25rem;
  }

  .console-sessions-label {
    color: var(--color-accent-dim);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    margin-bottom: 0.6rem;
  }

  .console-table-scroll {
    overflow-x: auto;
  }

  .console-table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    text-align: left;
  }

  .console-table th {
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.6875rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(247, 166, 10, 0.18);
  }

  .console-table td {
    padding-block: 0.45rem;
    color: rgba(255, 255, 255, 0.75);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .console-table .is-numeric {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

</style>
