---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-semibold">This part of the sky is empty</h1>
    <p class="mt-4 text-white/60">The page you're looking for doesn't exist.</p>
    <a href="/" class="btn-accent mt-8 inline-flex">Back to home</a>
  </section>
</Layout>
