---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import { Image } from 'astro:assets';
import signature from '../../assets/signature/firma.png';
---

<Layout
  title="Contact"
  titleIt="Contatti"
  description="Get in touch with Valerio Avitabile for astrophotography courses, collaborations or questions."
  descriptionIt="Contatta Valerio Avitabile per corsi di astrofotografia, collaborazioni o domande."
>
  <section class="mx-auto flex min-h-[80vh] max-w-4xl flex-col items-center justify-center px-6 py-24 text-center">
    <p class="text-2xl text-white/70 sm:text-3xl" style="font-family: 'Cormorant Garamond', serif">
      <span data-lang-en>Do you have any questions? Feel free to write to me, I will be happy to answer you.</span>
      <span data-lang-it>Hai qualche domanda? Scrivimi pure, sarò felice di risponderti.</span>
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href={`mailto:${site.email}`}
        aria-label="Email"
        title="Email"
        class="footer-icon"
        style="--icon-hover: #fbbf24"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3.5 6 8.5 7 8.5-7" />
        </svg>
      </a>
      <a
        href={site.social.facebook}
        target="_blank"
        rel="noopener"
        aria-label="Facebook"
        title="Facebook"
        class="footer-icon"
        style="--icon-hover: #1877f2"
      >
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M13.5 21v-7.6h2.55l.38-2.96h-2.93V8.55c0-.86.24-1.44 1.47-1.44h1.57V4.46c-.27-.04-1.2-.12-2.28-.12-2.26 0-3.8 1.38-3.8 3.9v2.18H7.9v2.96h2.56V21h3.04Z" />
        </svg>
      </a>
      <a
        href={site.social.youtube}
        target="_blank"
        rel="noopener"
        aria-label="YouTube"
        title="YouTube"
        class="footer-icon"
        style="--icon-hover: #ff0000"
      >
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M21.6 7.6a2.9 2.9 0 0 0-2.05-2.06C17.8 5.1 12 5.1 12 5.1s-5.8 0-7.55.44A2.9 2.9 0 0 0 2.4 7.6 30.4 30.4 0 0 0 2 12a30.4 30.4 0 0 0 .4 4.4 2.9 2.9 0 0 0 2.05 2.06c1.75.44 7.55.44 7.55.44s5.8 0 7.55-.44a2.9 2.9 0 0 0 2.05-2.06A30.4 30.4 0 0 0 22 12a30.4 30.4 0 0 0-.4-4.4ZM10 15V9l5.2 3-5.2 3Z" />
        </svg>
      </a>
      <a
        href={site.social.instagram}
        target="_blank"
        rel="noopener"
        aria-label="Instagram"
        title="Instagram"
        class="footer-icon"
        style="--icon-hover: #e1306c"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </div>

    <div class="mt-16 w-fit text-left">
      <p class="text-xl italic text-white/80 sm:text-2xl" style="font-family: 'Cormorant Garamond', serif">
        <span data-lang-en>Thank you for exploring the universe with me</span>
        <span data-lang-it>Grazie per aver esplorato l'universo con me</span>
      </p>
      <p class="mt-5 text-2xl font-semibold italic text-accent sm:text-3xl" style="font-family: 'Cormorant Garamond', serif">
        <span data-lang-en>Clear skies</span>
        <span data-lang-it>Cieli sereni</span>
      </p>
    </div>

    <Image
      src={signature}
      alt="Valerio Avitabile"
      width={220}
      height={98}
      class="mt-6 w-40 self-center sm:w-48"
      style="filter: invert(1); opacity: 0.9; transform: translateX(6rem);"
    />
  </section>
</Layout>
