  function populateCameraSelect(select: HTMLSelectElement) {
    const customOption = document.createElement('option');
    customOption.value = 'custom';
    customOption.setAttribute('data-tr', '{"attr":"text","en":"Custom","it":"Personalizzato"}');
    customOption.textContent = currentLang() === 'en' ? 'Custom' : 'Personalizzato';
    select.appendChild(customOption);

    let currentGroup: HTMLOptGroupElement | null = null;
    let currentBrand = '';
    for (const [brand, model, w, h, px] of CAMERA_DB) {
      if (brand !== currentBrand) {
        currentBrand = brand;
        currentGroup = document.createElement('optgroup');
        currentGroup.label = brand;
        select.appendChild(currentGroup);
      }
      const option = document.createElement('option');
      const slug = (brand + '-' + model).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      option.value = slug;
      option.dataset.w = String(w);
      option.dataset.h = String(h);
      option.dataset.px = String(px);
      option.textContent = `${model} (${w}×${h}, ${px}µm)`;
      currentGroup!.appendChild(option);
    }
  }

  // Wraps a populated <select> in a searchable combobox: the native select stays in the
  // DOM (hidden) as the source of truth so every existing change-listener keeps working
  // unchanged — this only adds a text input + filtered dropdown on top of it.
  function enhanceSearchableSelect(select: HTMLSelectElement) {
    if (select.dataset.comboBound) return;
    select.dataset.comboBound = '1';
    select.classList.add('hidden');

    const wrapper = document.createElement('div');
    wrapper.className = 'relative';

    const input = document.createElement('input');
    input.type = 'text';
    input.autocomplete = 'off';
    input.spellcheck = false;
    input.className =
      'w-full rounded-lg border border-white/15 bg-surface-2/60 py-2 pl-9 pr-3 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent';

    const iconWrapper = document.createElement('div');
    iconWrapper.className = 'pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-white/40';
    iconWrapper.innerHTML =
      '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4"><circle cx="9" cy="9" r="6.2" /><path d="M18 18l-4.5-4.5" stroke-linecap="round" /></svg>';

    const panel = document.createElement('div');
    panel.className =
      'absolute z-20 mt-1 hidden max-h-72 w-full overflow-y-auto rounded-lg border border-white/15 bg-surface-2 py-1 shadow-xl';

    wrapper.appendChild(input);
    wrapper.appendChild(iconWrapper);
    wrapper.appendChild(panel);
    select.insertAdjacentElement('afterend', wrapper);

    const labelFor = (option: HTMLOptionElement) => option.textContent || '';

    const setLabelFromSelection = () => {
      const opt = select.selectedOptions[0];
      input.value = opt ? labelFor(opt) : '';
    };

    const closePanel = () => {
      panel.classList.add('hidden');
      panel.innerHTML = '';
      setLabelFromSelection();
    };

    const selectOption = (option: HTMLOptionElement) => {
      select.value = option.value;
      select.dispatchEvent(new Event('change', { bubbles: true }));
      closePanel();
    };

    const tokens = (query: string) => query.trim().toLowerCase().split(/\s+/).filter(Boolean);

    const renderPanel = (query: string) => {
      panel.innerHTML = '';
      const q = query.trim().toLowerCase();
      const qTokens = tokens(query);
      const groups = Array.from(select.children) as HTMLElement[];
      let anyMatch = false;

      for (const node of groups) {
        if (node.tagName === 'OPTION') {
          const option = node as HTMLOptionElement;
          if (option.value === 'custom') {
            if (!q || labelFor(option).toLowerCase().includes(q)) {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.textContent = labelFor(option);
              btn.className = 'block w-full px-3 py-1.5 text-left text-sm text-white/70 hover:bg-accent/20 hover:text-white';
              btn.addEventListener('mousedown', (e) => {
                e.preventDefault();
                selectOption(option);
              });
              panel.appendChild(btn);
              anyMatch = true;
            }
          }
          continue;
        }
        if (node.tagName !== 'OPTGROUP') continue;
        const group = node as HTMLOptGroupElement;
        const options = Array.from(group.children) as HTMLOptionElement[];
        // Match against "brand + model" combined, so queries spanning both (e.g. "nikon d850")
        // work even though the brand only lives in the optgroup label, not the option text.
        const matches = qTokens.length
          ? options.filter((o) => {
              const haystack = (group.label + ' ' + labelFor(o)).toLowerCase();
              return qTokens.every((t) => haystack.includes(t));
            })
          : options;
        if (!matches.length) continue;
        anyMatch = true;

        const groupLabel = document.createElement('div');
        groupLabel.textContent = group.label;
        groupLabel.className = 'px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-wide text-white/40';
        panel.appendChild(groupLabel);

        for (const option of matches) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = labelFor(option);
          btn.className = 'block w-full px-3 py-1.5 text-left text-sm text-white hover:bg-accent/20';
          btn.addEventListener('mousedown', (e) => {
            e.preventDefault();
            selectOption(option);
          });
          panel.appendChild(btn);
        }
      }

      if (!anyMatch) {
        const empty = document.createElement('div');
        empty.className = 'px-3 py-2 text-sm text-white/40';
        empty.textContent = currentLang() === 'en' ? 'No camera found' : 'Nessuna camera trovata';
        panel.appendChild(empty);
      }

      panel.classList.remove('hidden');
    };

    input.addEventListener('focus', () => {
      input.select();
      renderPanel('');
    });
    input.addEventListener('input', () => renderPanel(input.value));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.blur();
        closePanel();
      }
    });
    input.addEventListener('blur', () => {
      // Delay so a mousedown on a panel button can fire before the panel is torn down.
      window.setTimeout(closePanel, 150);
    });

    setLabelFromSelection();
    (select as any).__comboSync = setLabelFromSelection;
  }

  function setupCcdCalculator() {
    const cameraPreset = document.querySelector<HTMLSelectElement>('#ccd-camera-preset');
    const pixelSizeInput = document.querySelector<HTMLInputElement>('#ccd-pixel-size');
    const focalLengthInput = document.querySelector<HTMLInputElement>('#ccd-focal-length');
    const seeingInput = document.querySelector<HTMLInputElement>('#ccd-seeing');
    const binningSelect = document.querySelector<HTMLSelectElement>('#ccd-binning');
    const scaleOutput = document.querySelector<HTMLElement>('#ccd-scale-output');
    const ratingOutput = document.querySelector<HTMLElement>('#ccd-rating-output');
    const ratingDetail = document.querySelector<HTMLElement>('#ccd-rating-detail');
    if (!cameraPreset || !pixelSizeInput || !focalLengthInput || !seeingInput || !binningSelect || !scaleOutput || !ratingOutput || !ratingDetail) return;
    if (pixelSizeInput.dataset.bound) return;
    pixelSizeInput.dataset.bound = '1';
    populateCameraSelect(cameraPreset);
    enhanceSearchableSelect(cameraPreset);

    const RATINGS = {
      oversampled: {
        color: '#fb923c',
        en: ['Oversampled', 'Pixel scale is much finer than the seeing allows — you are spreading light over more pixels than necessary, reducing sensitivity.'],
        it: ['Oversampling', 'Il campionamento è molto più fine di quanto il seeing permetta: la luce viene distribuita su più pixel del necessario, riducendo la sensibilità.'],
      },
      ideal: {
        color: '#4ade80',
        en: ['Ideal', 'Excellent match between pixel scale and seeing — a good balance of resolution and sensitivity.'],
        it: ['Ideale', 'Ottimo abbinamento tra campionamento e seeing: un buon equilibrio tra risoluzione e sensibilità.'],
      },
      adequate: {
        color: '#C2C1A5',
        en: ['Adequate', 'Reasonable match between pixel scale and seeing, though not perfectly optimal.'],
        it: ['Adeguato', 'Abbinamento ragionevole tra campionamento e seeing, anche se non perfettamente ottimale.'],
      },
      undersampled: {
        color: '#f87171',
        en: ['Undersampled', 'Pixel scale is coarser than the seeing — fine detail will be lost and stars may look blocky.'],
        it: ['Undersampling', "Il campionamento è più grossolano del seeing: i dettagli fini andranno persi e le stelle potrebbero apparire squadrate."],
      },
    } as const;

    const update = () => {
      const pixelSize = parseFloat(pixelSizeInput.value);
      const focalLength = parseFloat(focalLengthInput.value);
      const seeing = parseFloat(seeingInput.value);
      const binning = parseFloat(binningSelect.value) || 1;
      if (!pixelSize || !focalLength || !seeing) {
        scaleOutput.textContent = '—';
        ratingOutput.textContent = '—';
        ratingDetail.textContent = '—';
        return;
      }

      const scale = (ARCSEC_PER_RAD * pixelSize * binning) / focalLength / 1000;
      scaleOutput.textContent = `${scale.toFixed(2)} arcsec/px`;

      let key: keyof typeof RATINGS;
      if (scale < seeing / 3) key = 'oversampled';
      else if (scale < seeing / 2) key = 'ideal';
      else if (scale <= seeing) key = 'adequate';
      else key = 'undersampled';

      const lang = currentLang();
      const [label, detail] = RATINGS[key][lang];
      ratingOutput.textContent = label;
      ratingOutput.style.color = RATINGS[key].color;
      ratingDetail.textContent = detail;
    };

    cameraPreset.addEventListener('change', () => {
      const opt = cameraPreset.selectedOptions[0];
      if (!opt || opt.value === 'custom') return;
      const px = opt.dataset.px;
      if (px) pixelSizeInput.value = px;
      update();
    });

    [pixelSizeInput, focalLengthInput, seeingInput].forEach((el) => el.addEventListener('input', update));
    binningSelect.addEventListener('change', update);
    update();

    (window as any).__ccdCalcUpdate = update;
  }

  function setupFovCalculator() {
    const preset = document.querySelector<HTMLSelectElement>('#fov-preset');
    const focalLengthInput = document.querySelector<HTMLInputElement>('#fov-focal-length');
    const pixelSizeInput = document.querySelector<HTMLInputElement>('#fov-pixel-size');
    const resWInput = document.querySelector<HTMLInputElement>('#fov-res-w');
    const resHInput = document.querySelector<HTMLInputElement>('#fov-res-h');
    const sensorOutput = document.querySelector<HTMLElement>('#fov-sensor-output');
    const scaleOutput = document.querySelector<HTMLElement>('#fov-scale-output');
    const fovOutput = document.querySelector<HTMLElement>('#fov-fov-output');
    const diagOutput = document.querySelector<HTMLElement>('#fov-diag-output');
    if (!preset || !focalLengthInput || !pixelSizeInput || !resWInput || !resHInput || !sensorOutput || !scaleOutput || !fovOutput || !diagOutput) return;
    if (preset.dataset.bound) return;
    preset.dataset.bound = '1';
    populateCameraSelect(preset);
    enhanceSearchableSelect(preset);

    const update = () => {
      const focalLength = parseFloat(focalLengthInput.value);
      const pixelSize = parseFloat(pixelSizeInput.value);
      const resW = parseFloat(resWInput.value);
      const resH = parseFloat(resHInput.value);
      if (!focalLength || !pixelSize || !resW || !resH) {
        sensorOutput.textContent = '—';
        scaleOutput.textContent = '—';
        fovOutput.textContent = '—';
        diagOutput.textContent = '—';
        return;
      }

      const sensorWmm = (resW * pixelSize) / 1000;
      const sensorHmm = (resH * pixelSize) / 1000;
      sensorOutput.textContent = `${sensorWmm.toFixed(1)} × ${sensorHmm.toFixed(1)} mm`;

      const scale = (ARCSEC_PER_RAD * pixelSize) / focalLength / 1000;
      scaleOutput.textContent = `${scale.toFixed(2)} arcsec/px`;

      const fovWArcmin = (ARCMIN_PER_RAD * sensorWmm) / focalLength;
      const fovHArcmin = (ARCMIN_PER_RAD * sensorHmm) / focalLength;
      fovOutput.textContent = `${formatDegMin(fovWArcmin)} × ${formatDegMin(fovHArcmin)}`;

      const diagMm = Math.sqrt(sensorWmm * sensorWmm + sensorHmm * sensorHmm);
      const diagArcmin = (ARCMIN_PER_RAD * diagMm) / focalLength;
      const lang = currentLang();
      const label = lang === 'en' ? 'Diagonal FOV' : 'FOV diagonale';
      diagOutput.textContent = `${label}: ${formatDegMin(diagArcmin)}`;
    };

    preset.addEventListener('change', () => {
      const opt = preset.selectedOptions[0];
      if (!opt || opt.value === 'custom') return;
      const w = opt.dataset.w;
      const h = opt.dataset.h;
      const px = opt.dataset.px;
      if (w) resWInput.value = w;
      if (h) resHInput.value = h;
      if (px) pixelSizeInput.value = px;
      update();
    });

    [focalLengthInput, pixelSizeInput, resWInput, resHInput].forEach((el) => el.addEventListener('input', update));
    update();

    (window as any).__fovCalcUpdate = update;
  }

  function setupGuidescopeCalculator() {
    const imgCameraPreset = document.querySelector<HTMLSelectElement>('#guide-img-camera-preset');
    const imgFocalLengthInput = document.querySelector<HTMLInputElement>('#guide-img-focal-length');
    const imgPixelSizeInput = document.querySelector<HTMLInputElement>('#guide-img-pixel-size');
    const imgBinningSelect = document.querySelector<HTMLSelectElement>('#guide-img-binning');
    const guideCameraPreset = document.querySelector<HTMLSelectElement>('#guide-cam-camera-preset');
    const guideFocalLengthInput = document.querySelector<HTMLInputElement>('#guide-scope-focal-length');
    const guidePixelSizeInput = document.querySelector<HTMLInputElement>('#guide-cam-pixel-size');
    const guideBinningSelect = document.querySelector<HTMLSelectElement>('#guide-cam-binning');
    const imgScaleOutput = document.querySelector<HTMLElement>('#guide-img-scale-output');
    const guideScaleOutput = document.querySelector<HTMLElement>('#guide-guide-scale-output');
    const ratioOutput = document.querySelector<HTMLElement>('#guide-ratio-output');
    const ratingOutput = document.querySelector<HTMLElement>('#guide-rating-output');
    const ratingDetail = document.querySelector<HTMLElement>('#guide-rating-detail');
    if (
      !imgCameraPreset || !imgFocalLengthInput || !imgPixelSizeInput || !imgBinningSelect ||
      !guideCameraPreset || !guideFocalLengthInput || !guidePixelSizeInput || !guideBinningSelect ||
      !imgScaleOutput || !guideScaleOutput || !ratioOutput || !ratingOutput || !ratingDetail
    ) return;
    if (imgFocalLengthInput.dataset.bound) return;
    imgFocalLengthInput.dataset.bound = '1';
    populateCameraSelect(imgCameraPreset);
    populateCameraSelect(guideCameraPreset);
    enhanceSearchableSelect(imgCameraPreset);
    enhanceSearchableSelect(guideCameraPreset);

    const RATINGS = {
      excellent: {
        color: '#4ade80',
        en: ['Excellent', 'The guide camera resolves finer than the imaging setup — guiding corrections will be as precise as possible.'],
        it: ['Eccellente', "La camera di guida campiona più fine dell'apparato di ripresa: le correzioni di guida saranno il più precise possibile."],
      },
      good: {
        color: '#4ade80',
        en: ['Good', 'A typical, well-balanced ratio between imaging and guiding resolution.'],
        it: ['Buono', 'Un rapporto tipico e ben bilanciato tra la risoluzione di ripresa e quella di guida.'],
      },
      adequate: {
        color: '#C2C1A5',
        en: ['Adequate', 'Workable, but the guide scope resolves noticeably coarser than the imaging setup — guiding may be less precise.'],
        it: ['Adeguato', 'Funzionale, ma il telescopio guida campiona con una risoluzione sensibilmente più bassa rispetto a quella di ripresa: la guida potrebbe quindi risultare meno precisa.'],
      },
      poor: {
        color: '#f87171',
        en: ['Poor', 'The guide scope resolution is much coarser than the imaging setup — guiding errors smaller than a guide pixel will go undetected.'],
        it: ['Scarso', 'La risoluzione del telescopio guida è molto più grossolana della ripresa: errori di guida più piccoli di un pixel di guida non verranno rilevati.'],
      },
    } as const;

    const scaleOf = (pixelSize: number, focalLength: number, binning: number) =>
      (ARCSEC_PER_RAD * pixelSize * binning) / focalLength / 1000;

    const update = () => {
      const imgFocalLength = parseFloat(imgFocalLengthInput.value);
      const imgPixelSize = parseFloat(imgPixelSizeInput.value);
      const imgBinning = parseFloat(imgBinningSelect.value) || 1;
      const guideFocalLength = parseFloat(guideFocalLengthInput.value);
      const guidePixelSize = parseFloat(guidePixelSizeInput.value);
      const guideBinning = parseFloat(guideBinningSelect.value) || 1;

      if (!imgFocalLength || !imgPixelSize || !guideFocalLength || !guidePixelSize) {
        imgScaleOutput.textContent = '—';
        guideScaleOutput.textContent = '—';
        ratioOutput.textContent = '—';
        ratingOutput.textContent = '—';
        ratingDetail.textContent = '—';
        return;
      }

      const imgScale = scaleOf(imgPixelSize, imgFocalLength, imgBinning);
      const guideScale = scaleOf(guidePixelSize, guideFocalLength, guideBinning);
      imgScaleOutput.textContent = `${imgScale.toFixed(2)} arcsec/px`;
      guideScaleOutput.textContent = `${guideScale.toFixed(2)} arcsec/px`;

      const ratio = guideScale / imgScale;
      ratioOutput.textContent = `1:${ratio.toFixed(2)}`;

      let key: keyof typeof RATINGS;
      if (ratio < 1) key = 'excellent';
      else if (ratio <= 4) key = 'good';
      else if (ratio <= 6) key = 'adequate';
      else key = 'poor';

      const lang = currentLang();
      const [label, detail] = RATINGS[key][lang];
      ratingOutput.textContent = label;
      ratingOutput.style.color = RATINGS[key].color;
      ratingDetail.textContent = detail;
    };

    imgCameraPreset.addEventListener('change', () => {
      const opt = imgCameraPreset.selectedOptions[0];
      if (!opt || opt.value === 'custom') return;
      const px = opt.dataset.px;
      if (px) imgPixelSizeInput.value = px;
      update();
    });

    guideCameraPreset.addEventListener('change', () => {
      const opt = guideCameraPreset.selectedOptions[0];
      if (!opt || opt.value === 'custom') return;
      const px = opt.dataset.px;
      if (px) guidePixelSizeInput.value = px;
      update();
    });

    [imgFocalLengthInput, imgPixelSizeInput, guideFocalLengthInput, guidePixelSizeInput].forEach((el) =>
      el.addEventListener('input', update)
    );
    [imgBinningSelect, guideBinningSelect].forEach((el) => el.addEventListener('change', update));
    update();

    (window as any).__guideCalcUpdate = update;
  }

  function setupFilterSizeCalculator() {
    const cameraPreset = document.querySelector<HTMLSelectElement>('#filter-camera-preset');
    const apertureInput = document.querySelector<HTMLInputElement>('#filter-aperture');
    const focalLengthInput = document.querySelector<HTMLInputElement>('#filter-focal-length');
    const gapInput = document.querySelector<HTMLInputElement>('#filter-gap');
    const diagonalInput = document.querySelector<HTMLInputElement>('#filter-ccd-diagonal');
    const sizeOutput = document.querySelector<HTMLElement>('#filter-size-output');
    const standardOutput = document.querySelector<HTMLElement>('#filter-standard-output');
    if (!cameraPreset || !apertureInput || !focalLengthInput || !gapInput || !diagonalInput || !sizeOutput || !standardOutput) return;
    if (apertureInput.dataset.bound) return;
    apertureInput.dataset.bound = '1';
    populateCameraSelect(cameraPreset);
    enhanceSearchableSelect(cameraPreset);

    // Common commercially available filter sizes (mm): 1.25" unmounted, 31mm mounted,
    // 36mm unmounted/T2, 2"/50.8mm mounted, 50mm unmounted, 65mm, 2" round for larger formats.
    const STANDARD_SIZES = [31, 36, 50, 50.8, 65];

    const update = () => {
      const aperture = parseFloat(apertureInput.value);
      const focalLength = parseFloat(focalLengthInput.value);
      const gap = parseFloat(gapInput.value);
      const diagonal = parseFloat(diagonalInput.value);
      if (!aperture || !focalLength || !diagonal || gap < 0) {
        sizeOutput.textContent = '—';
        standardOutput.textContent = '—';
        return;
      }

      const fieldAngle = diagonal / 2 / focalLength;
      const fRatio = focalLength / aperture;
      const filterSize = (focalLength - gap) * (fieldAngle / 0.5) + gap / fRatio;
      sizeOutput.textContent = `${filterSize.toFixed(2)} mm`;

      const nearest = STANDARD_SIZES.find((size) => size >= filterSize);
      const lang = currentLang();
      if (nearest) {
        const label = lang === 'en' ? 'Nearest standard size' : 'Formato standard più vicino';
        standardOutput.textContent = `${label}: ${nearest} mm`;
      } else {
        standardOutput.textContent =
          lang === 'en'
            ? 'Larger than common standard filter sizes — a custom/oversized filter may be needed.'
            : 'Più grande dei formati standard comuni: potrebbe servire un filtro custom o sovradimensionato.';
      }
    };

    cameraPreset.addEventListener('change', () => {
      const opt = cameraPreset.selectedOptions[0];
      if (!opt || opt.value === 'custom') return;
      const w = parseFloat(opt.dataset.w || '0');
      const h = parseFloat(opt.dataset.h || '0');
      const px = parseFloat(opt.dataset.px || '0');
      if (w && h && px) {
        const sensorWmm = (w * px) / 1000;
        const sensorHmm = (h * px) / 1000;
        const diagMm = Math.sqrt(sensorWmm * sensorWmm + sensorHmm * sensorHmm);
        diagonalInput.value = diagMm.toFixed(2);
      }
      update();
    });

    [apertureInput, focalLengthInput, gapInput, diagonalInput].forEach((el) => el.addEventListener('input', update));
    update();

    (window as any).__filterCalcUpdate = update;
  }

  function setup() {
    setupCcdCalculator();
    setupFovCalculator();
    setupGuidescopeCalculator();
    setupFilterSizeCalculator();
  }

  // Re-run rating/labels when the language toggle updates dynamic text.
  document.addEventListener('astro:page-load', setup);
  const langButtons = () => document.querySelectorAll<HTMLElement>('[data-lang-btn]');
  langButtons().forEach((btn) =>
    btn.addEventListener('click', () => {
      (window as any).__ccdCalcUpdate?.();
      (window as any).__fovCalcUpdate?.();
      (window as any).__guideCalcUpdate?.();
      (window as any).__filterCalcUpdate?.();
      document.querySelectorAll<HTMLSelectElement>('select[data-combo-bound]').forEach((sel) => (sel as any).__comboSync?.());
    })
