---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/url';
---

<Layout
  title="Astronomy Tools"
  description="Custom sensor suitability, field of view and guidescope suitability calculators for astrophotography planning."
  descriptionIt="Calcolatori personalizzati di campionamento deep sky, campo inquadrato e compatibilità del telescopio guida per la pianificazione dell'astrofotografia."
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="reveal-left mt-10 text-3xl font-semibold sm:text-4xl">Astronomy Tools</h1>

    <div class="reveal-right prose-astro mt-10" style="--reveal-delay: 150ms">
      <div data-lang-en>
        <p>
          Four calculators built directly into this page, inspired by <a href="https://astronomy.tools/" target="_blank" rel="noopener">astronomy.tools</a>, to help plan
          astrophotography sessions: a <strong>Sensor Suitability Calculator</strong> to check whether a
          camera/telescope pair is well matched to the sky's seeing, a <strong>Field of View
          Calculator</strong> to preview how large a target will appear in the frame, a <strong>Guidescope
          Suitability Calculator</strong> to check whether a guide scope/camera pair can track precisely enough
          for the main imaging setup, and a <strong>Filter Size Calculator</strong> to find the smallest
          filter that won't vignette the sensor.
        </p>
      </div>
      <div data-lang-it>
        <p>
          Quattro calcolatori integrati direttamente in questa pagina, ispirati ad <a href="https://astronomy.tools/" target="_blank" rel="noopener">astronomy.tools</a>, per pianificare
          le sessioni di astrofotografia: un <strong>calcolatore campionamento deep sky</strong> per verificare se
          l'abbinamento camera/telescopio è adatto al seeing del cielo, un <strong>calcolatore di campo
          inquadrato</strong> per vedere in anteprima quanto grande apparirà un soggetto nell'inquadratura, un <strong>calcolatore di compatibilità del telescopio guida</strong> per verificare se l'abbinamento
          telescopio guida/camera di guida è abbastanza preciso per l'apparato di ripresa principale, e un <strong>calcolatore della dimensione del filtro</strong> per trovare il filtro più piccolo che non vignetti il sensore.
        </p>
      </div>
    </div>

    <!-- Sensor Suitability Calculator -->
    <section class="reveal-3d-spin mt-12 rounded-2xl border border-white/10 bg-surface/40 p-6" style="--reveal-delay: 0ms">
      <h2 class="text-xl font-semibold">
        <span data-lang-en>1️⃣ Sensor Suitability Calculator</span>
        <span data-lang-it>1️⃣ Calcolatore Campionamento Deep Sky</span>
      </h2>
      <p class="mt-2 text-sm text-white/60">
        <span data-lang-en
          >Checks how well a sensor's pixel scale matches the atmospheric seeing.</span
        >
        <span data-lang-it
          >Verifica quanto il campionamento del sensore sia adatto al seeing atmosferico.</span
        >
      </p>

      <div class="mt-6">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="ccd-camera-preset">
          <span data-lang-en>Camera preset</span>
          <span data-lang-it>Preset camera</span>
        </label>
        <select id="ccd-camera-preset" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></select>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="ccd-pixel-size">
            <span data-lang-en>Pixel size (µm)</span>
            <span data-lang-it>Dimensione pixel (µm)</span>
          </label>
          <input id="ccd-pixel-size" type="number" step="0.01" min="0" value="3.76" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="ccd-focal-length">
            <span data-lang-en>Focal length (mm)</span>
            <span data-lang-it>Lunghezza focale (mm)</span>
          </label>
          <input id="ccd-focal-length" type="number" step="1" min="1" value="750" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="ccd-seeing">
            <span data-lang-en>Seeing (arcsec)</span>
            <span data-lang-it>Seeing (arcsec)</span>
          </label>
          <input id="ccd-seeing" type="number" step="0.1" min="0.1" value="2.5" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="ccd-binning">
            <span data-lang-en>Binning</span>
            <span data-lang-it>Binning</span>
          </label>
          <select id="ccd-binning" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
            <option value="1">1x1</option>
            <option value="2">2x2</option>
            <option value="3">3x3</option>
            <option value="4">4x4</option>
          </select>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-white/10 bg-surface-2/50 p-4">
        <p class="text-sm text-white/60">
          <span data-lang-en>Image scale</span>
          <span data-lang-it>Campionamento</span>
        </p>
        <p id="ccd-scale-output" class="mt-1 text-2xl font-semibold text-accent">—</p>
        <p id="ccd-rating-output" class="mt-2 text-sm font-semibold">—</p>
        <p id="ccd-rating-detail" class="mt-1 text-sm text-white/60">—</p>
      </div>
    </section>

    <!-- Field of View Calculator -->
    <section class="reveal-3d-spin mt-8 rounded-2xl border border-white/10 bg-surface/40 p-6" style="--reveal-delay: 120ms">
      <h2 class="text-xl font-semibold">
        <span data-lang-en>2️⃣ Field of View (FOV) Calculator</span>
        <span data-lang-it>2️⃣ Calcolatore di Campo Inquadrato (FOV)</span>
      </h2>
      <p class="mt-2 text-sm text-white/60">
        <span data-lang-en>Estimates the framing of a telescope + camera combination.</span>
        <span data-lang-it>Stima l'inquadratura di una combinazione telescopio + camera.</span>
      </p>

      <div class="mt-6">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="fov-preset">
          <span data-lang-en>Camera preset</span>
          <span data-lang-it>Preset camera</span>
        </label>
        <select id="fov-preset" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></select>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="fov-focal-length">
            <span data-lang-en>Focal length (mm)</span>
            <span data-lang-it>Lunghezza focale (mm)</span>
          </label>
          <input id="fov-focal-length" type="number" step="1" min="1" value="750" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="fov-pixel-size">
            <span data-lang-en>Pixel size (µm)</span>
            <span data-lang-it>Dimensione pixel (µm)</span>
          </label>
          <input id="fov-pixel-size" type="number" step="0.01" min="0" value="3.76" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="fov-res-w">
            <span data-lang-en>Resolution width (px)</span>
            <span data-lang-it>Risoluzione larghezza (px)</span>
          </label>
          <input id="fov-res-w" type="number" step="1" min="1" value="6248" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="fov-res-h">
            <span data-lang-en>Resolution height (px)</span>
            <span data-lang-it>Risoluzione altezza (px)</span>
          </label>
          <input id="fov-res-h" type="number" step="1" min="1" value="4176" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-white/10 bg-surface-2/50 p-4">
          <p class="text-sm text-white/60">
            <span data-lang-en>Sensor size</span>
            <span data-lang-it>Dimensione sensore</span>
          </p>
          <p id="fov-sensor-output" class="mt-1 text-lg font-semibold text-white">—</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-surface-2/50 p-4">
          <p class="text-sm text-white/60">
            <span data-lang-en>Image scale</span>
            <span data-lang-it>Campionamento</span>
          </p>
          <p id="fov-scale-output" class="mt-1 text-lg font-semibold text-white">—</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-surface-2/50 p-4 sm:col-span-2">
          <p class="text-sm text-white/60">
            <span data-lang-en>Field of view</span>
            <span data-lang-it>Campo inquadrato</span>
          </p>
          <p id="fov-fov-output" class="mt-1 text-2xl font-semibold text-accent">—</p>
          <p id="fov-diag-output" class="mt-1 text-sm text-white/60">—</p>
        </div>
      </div>
    </section>

    <!-- Guidescope Suitability Calculator -->
    <section class="reveal-3d-spin mt-8 rounded-2xl border border-white/10 bg-surface/40 p-6" style="--reveal-delay: 240ms">
      <h2 class="text-xl font-semibold">
        <span data-lang-en>3️⃣ Guidescope Suitability Calculator</span>
        <span data-lang-it>3️⃣ Calcolatore di Compatibilità del Telescopio Guida</span>
      </h2>
      <p class="mt-2 text-sm text-white/60">
        <span data-lang-en
          >Compares the imaging setup's pixel scale with the guide setup's, to check whether the guide scope can
          correct tracking errors precisely enough for the main telescope.</span
        >
        <span data-lang-it
          >Confronta il campionamento dell'apparato di ripresa con quello di guida, per verificare se il
          telescopio guida può correggere gli errori di inseguimento con la precisione richiesta dal telescopio
          principale.</span
        >
      </p>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold text-white/80">
            <span data-lang-en>Imaging setup</span>
            <span data-lang-it>Apparato di ripresa</span>
          </h3>
          <div class="mt-3 grid gap-4">
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="guide-img-focal-length">
                <span data-lang-en>Focal length (mm)</span>
                <span data-lang-it>Lunghezza focale (mm)</span>
              </label>
              <input id="guide-img-focal-length" type="number" step="1" min="1" value="750" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="guide-img-camera-preset">
                <span data-lang-en>Camera preset</span>
                <span data-lang-it>Preset camera</span>
              </label>
              <select id="guide-img-camera-preset" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></select>
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="guide-img-pixel-size">
                <span data-lang-en>Pixel size (µm)</span>
                <span data-lang-it>Dimensione pixel (µm)</span>
              </label>
              <input id="guide-img-pixel-size" type="number" step="0.01" min="0" value="3.76" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="guide-img-binning">
                <span data-lang-en>Binning</span>
                <span data-lang-it>Binning</span>
              </label>
              <select id="guide-img-binning" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
                <option value="1">1x1</option>
                <option value="2">2x2</option>
                <option value="3">3x3</option>
                <option value="4">4x4</option>
              </select>
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-white/80">
            <span data-lang-en>Guide setup</span>
            <span data-lang-it>Apparato di guida</span>
          </h3>
          <div class="mt-3 grid gap-4">
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="guide-scope-focal-length">
                <span data-lang-en>Focal length (mm)</span>
                <span data-lang-it>Lunghezza focale (mm)</span>
              </label>
              <input id="guide-scope-focal-length" type="number" step="1" min="1" value="120" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="guide-cam-camera-preset">
                <span data-lang-en>Camera preset</span>
                <span data-lang-it>Preset camera</span>
              </label>
              <select id="guide-cam-camera-preset" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></select>
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="guide-cam-pixel-size">
                <span data-lang-en>Pixel size (µm)</span>
                <span data-lang-it>Dimensione pixel (µm)</span>
              </label>
              <input id="guide-cam-pixel-size" type="number" step="0.01" min="0" value="2.9" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="guide-cam-binning">
                <span data-lang-en>Binning</span>
                <span data-lang-it>Binning</span>
              </label>
              <select id="guide-cam-binning" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
                <option value="1">1x1</option>
                <option value="2">2x2</option>
                <option value="3">3x3</option>
                <option value="4">4x4</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-white/10 bg-surface-2/50 p-4">
          <p class="text-sm text-white/60">
            <span data-lang-en>Imaging resolution</span>
            <span data-lang-it>Campionamento ripresa</span>
          </p>
          <p id="guide-img-scale-output" class="mt-1 text-lg font-semibold text-white">—</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-surface-2/50 p-4">
          <p class="text-sm text-white/60">
            <span data-lang-en>Guiding resolution</span>
            <span data-lang-it>Campionamento guida</span>
          </p>
          <p id="guide-guide-scale-output" class="mt-1 text-lg font-semibold text-white">—</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-surface-2/50 p-4 sm:col-span-2">
          <p class="text-sm text-white/60">
            <span data-lang-en>Imaging / guiding ratio</span>
            <span data-lang-it>Rapporto ripresa / guida</span>
          </p>
          <p id="guide-ratio-output" class="mt-1 text-2xl font-semibold text-accent">—</p>
          <p id="guide-rating-output" class="mt-2 text-sm font-semibold">—</p>
          <p id="guide-rating-detail" class="mt-1 text-sm text-white/60">—</p>
        </div>
      </div>
    </section>

    <!-- Filter Size Calculator -->
    <section class="reveal-3d-spin mt-8 rounded-2xl border border-white/10 bg-surface/40 p-6" style="--reveal-delay: 360ms">
      <h2 class="text-xl font-semibold">
        <span data-lang-en>4️⃣ Filter Size Calculator</span>
        <span data-lang-it>4️⃣ Calcolatore della Dimensione del Filtro</span>
      </h2>
      <p class="mt-2 text-sm text-white/60">
        <span data-lang-en
          >Finds the smallest filter diameter that won't vignette the corners of the sensor, based on how far the
          filter sits from the focal plane.</span
        >
        <span data-lang-it
          >Trova il diametro minimo del filtro che non vignetta gli angoli del sensore, in base a quanto il
          filtro è distante dal piano focale.</span
        >
      </p>

      <div class="mt-6">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="filter-camera-preset">
          <span data-lang-en>Camera preset</span>
          <span data-lang-it>Preset camera</span>
        </label>
        <select id="filter-camera-preset" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"></select>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="filter-aperture">
            <span data-lang-en>Telescope aperture (mm)</span>
            <span data-lang-it>Apertura del telescopio (mm)</span>
          </label>
          <input id="filter-aperture" type="number" step="1" min="1" value="80" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="filter-focal-length">
            <span data-lang-en>Focal length (mm)</span>
            <span data-lang-it>Lunghezza focale (mm)</span>
          </label>
          <input id="filter-focal-length" type="number" step="1" min="1" value="600" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="filter-gap">
            <span data-lang-en>Filter-to-sensor distance (mm)</span>
            <span data-lang-it>Distanza filtro-sensore (mm)</span>
          </label>
          <input id="filter-gap" type="number" step="0.5" min="0" value="20" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-white/50" for="filter-ccd-diagonal">
            <span data-lang-en>Sensor diagonal (mm)</span>
            <span data-lang-it>Diagonale del sensore (mm)</span>
          </label>
          <input id="filter-ccd-diagonal" type="number" step="0.01" min="0" value="11.21" class="w-full rounded-lg border border-white/15 bg-surface-2/60 px-3 py-2 text-sm text-white placeholder-white/30 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-white/10 bg-surface-2/50 p-4">
        <p class="text-sm text-white/60">
          <span data-lang-en>Recommended minimum filter size</span>
          <span data-lang-it>Dimensione minima del filtro consigliata</span>
        </p>
        <p id="filter-size-output" class="mt-1 text-2xl font-semibold text-accent">—</p>
        <p id="filter-standard-output" class="mt-1 text-sm text-white/60">—</p>
      </div>
    </section>

    <div class="mt-14 flex justify-center">
      <a href={withBase('/video-utility/')} class="btn-accent justify-center min-w-[190px]">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span data-lang-en>Back to Video &amp; Utility</span>
        <span data-lang-it>Torna a Video &amp; Utility</span>
      </a>
    </div>
  </article>
</Layout>

<script>
  const ARCSEC_PER_RAD = 206265;
  const ARCMIN_PER_RAD = 3437.746771;

  function currentLang(): 'en' | 'it' {
    return document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'it';
  }

  function formatDegMin(totalArcmin: number): string {
    const deg = Math.floor(totalArcmin / 60);
    const min = totalArcmin - deg * 60;
    if (deg > 0) return `${deg}° ${min.toFixed(1)}'`;
    return `${min.toFixed(2)}'`;
  }

