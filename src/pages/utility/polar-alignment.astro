import ShutterReveal from '../../components/ShutterReveal.astro';
import { withBase } from '../../utils/url';
import { Image } from 'astro:assets';
import s01 from '../../assets/articles/tutorial/step-01.jpg';
import s02 from '../../assets/articles/tutorial/step-02.jpg';
import s03 from '../../assets/articles/tutorial/step-03.jpg';
import s04 from '../../assets/articles/tutorial/step-04.jpg';
import s05 from '../../assets/articles/tutorial/step-05.jpg';
import s06 from '../../assets/articles/tutorial/step-06.jpg';
import s07 from '../../assets/articles/tutorial/step-07.jpg';
import s08 from '../../assets/articles/tutorial/step-08.jpg';
import s09 from '../../assets/articles/tutorial/step-09.jpg';
import s10 from '../../assets/articles/tutorial/step-10.jpg';
import s11 from '../../assets/articles/tutorial/step-11.jpg';
import s12 from '../../assets/articles/tutorial/step-12.jpg';
import s13 from '../../assets/articles/tutorial/step-13.jpg';
import s14 from '../../assets/articles/tutorial/step-14.jpg';
import s15 from '../../assets/articles/tutorial/step-15.jpg';
import s16 from '../../assets/articles/tutorial/step-16.jpg';
