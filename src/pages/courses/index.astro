---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/url';
import { socials } from '../../data/socials';

// Ordinati nella sequenza numerica desiderata (1-8): colonna sinistra
// (1-4) seguita dalla colonna destra (5-8) su desktop, e la stessa
// sequenza 1->8 quando la lista si impila in singola colonna su mobile.
const topicsLeft = [
  {
    en: 'Image stacking, calibration with dark, flat, darkflat',
    it: 'Stacking delle immagini, calibrazione con dark, flat, darkflat',
  },
  {
    en: 'Creation and calibration of RGB channels',
    it: 'Creazione e calibrazione dei canali RGB',
  },
  {
    en: 'Gradient removal, photometric color calibration, starless image',
    it: 'Rimozione dei gradienti, calibrazione fotometrica del colore',
  },
  {
    en: 'Starless image, deconvolution and linear denoising',
    it: 'Immagine starless, deconvoluzione e denoising in fase lineare',
  },
];

const topicsRight = [
  {
    en: 'Stretching and non-linear phase',
    it: 'Stretching e fase non lineare',
  },
  {
    en: 'Curves, contrasts, saturation, blending modes',
    it: 'Curve, contrasti, saturazione, blending mode',
  },
  {
    en: 'Fine details, star color calibration, final image',
    it: 'Dettagli fini, calibrazione del colore delle stelle, immagine finale',
  },
  {
    en: 'Questions, reflections, release of the video lesson',
    it: 'Domande, riflessioni, consegna della video lezione',
  },
];
---

<Layout
  title="Customised Online Courses"
  titleIt="Corsi Online Personalizzati"
  description="Personalized online astrophotography courses: stacking, gradient removal, stretching and color calibration with PixInsight, Photoshop and Camera Raw."
  descriptionIt="Corsi online personalizzati di astrofotografia: stacking, rimozione dei gradienti, stretching e calibrazione del colore con PixInsight, Photoshop e Camera Raw."
>
  <section class="mx-auto max-w-5xl px-6 pt-28 pb-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="reveal-left">
        <p class="eyebrow">
          <span data-lang-en>How can I help you?</span>
          <span data-lang-it>Come posso aiutarti?</span>
        </p>
        <div class="prose-astro mt-4">
          <div data-lang-en>
            <p>
              I have transformed my passion for processing into a clear and effective teaching method. In my 
               online courses, I will teach you my complete workflow for transforming a simple
              RAW file into a spectacular astronomical photograph.
            </p>
            <p>
              Together, we will go through every step of the process: from stacking to removing gradients,
              stretching the image, and managing color with powerful tools such as PixInsight, Photoshop, and
              Camera Raw. This course is designed for both beginners and those who want to discover alternative
              techniques.
            </p>
            <p>Contact me for more information.</p>
          </div>
          <div data-lang-it>
            <p>
              Ho trasformato la mia passione per l'elaborazione in un metodo di insegnamento chiaro ed
              efficace. Nei miei corsi online, ti insegnerò il mio flusso di lavoro completo
              per trasformare un semplice file RAW in una spettacolare fotografia astronomica.
            </p>
            <p>
              Insieme percorreremo ogni fase del processo: dallo stacking alla rimozione dei gradienti, allo
              stretching dell'immagine, fino alla gestione del colore con strumenti potenti come PixInsight,
              Photoshop e Camera Raw. Questo corso è pensato sia per i principianti sia per chi vuole scoprire
              tecniche alternative.
            </p>
            <p>Contattami per maggiori informazioni.</p>
          </div>
        </div>

        <div
          class="mt-4 flex flex-wrap gap-4"
          role="list"
          aria-label="Follow on social media"
          data-tr={JSON.stringify({ attr: 'aria-label', en: 'Follow on social media', it: 'Seguimi sui social' })}
        >
          {
            socials.map((s) => (
              <a
                href={s.href}
                target={s.external ? '_blank' : undefined}
                rel={s.external ? 'noopener' : undefined}
                aria-label={s.label}
                title={s.label}
                class="footer-icon"
                style={`--icon-hover: ${s.color}`}
              >
                {s.label === 'Instagram' ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4.2" />
                    <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
                  </svg>
                ) : (
                  <svg
                    viewBox={s.viewBox}
                    fill={s.stroke ? 'none' : 'currentColor'}
                    stroke={s.stroke ? 'currentColor' : undefined}
                    stroke-width={s.stroke ? '1.8' : undefined}
                    stroke-linecap={s.stroke ? 'round' : undefined}
                    stroke-linejoin={s.stroke ? 'round' : undefined}
                  >
                    <path d={s.icon} />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <div class="course-video-reveal w-full overflow-hidden rounded-xl" data-course-video-card>
          <video
            class="w-full"
            src={withBase('/video/course-demo.mp4')}
            poster={withBase('/video/course-demo-poster.jpg')}
            controls
            playsinline
            muted
            preload="auto"
            data-course-video
          />
          <div class="course-video-wipe" aria-hidden="true"></div>
          <button
            type="button"
            class="absolute bottom-3 right-3 z-30 rounded-full bg-black/60 px-3 py-2 text-xs font-semibold uppercase tracking-wide text-white backdrop-blur transition hover:bg-black/80"
            data-unmute-btn
          >
            <span data-lang-en>Enable audio</span>
            <span data-lang-it>Attiva audio</span>
          </button>
        </div>
        <p class="mt-4 text-sm text-white/60">
          <span data-lang-en>The video shows an example of how raw data can be transformed into a stunning final image.</span>
          <span data-lang-it>Il video mostra un esempio di come i dati raw possano essere trasformati in una splendida immagine finale.</span>
        </p>
      </div>
    </div>

    <style>
      /* Stesso effetto a tessere di .mosaic-reveal (global.css), ma con una
         classe dedicata: .mosaic-reveal è anche il selettore globale usato
         da ScrollReveal.astro per il video-teaser della home, che lo mette
         in pausa e lo ricopre di tessere ogni volta che esce dal viewport.
         Qui il video è un vero tutorial con audio (non una clip decorativa
         in loop), quindi serve un reveal one-shot indipendente: condividere
         la classe faceva scattare anche la logica dell'altro componente,
         che ricopriva il video subito dopo che il nostro script lo rivelava. */
      .course-video-reveal {
        position: relative;
        border: 1px solid transparent;
        transition: border-color 0.6s ease-out;
      }

      /* The frame border only fades in once the curtain has actually
         finished wiping away (.is-framed, added by setupCourseVideoReveal
         when the wipe animation completes), instead of sitting there as a
         static border the whole 2s the panel still covers the video —
         same technique as .iris-card / .barn-door-reveal in global.css. */
      .course-video-reveal.is-framed {
        border-color: rgba(255, 255, 255, 0.1);
      }

      /* Clip wipe one-shot: un pannello pieno copre il video e si "apre"
         con un bordo curvo animato via JS (vedi buildClipPath nello
         script), invece della tessitura a mosaico usata altrove.
         --color-surface (non --color-ink) perché il video parte da un
         fotogramma quasi nero: un pannello dello stesso nero della pagina
         sarebbe indistinguibile dallo sfondo. Stato di riposo = rettangolo
         pieno semplice; la forma curva del "sipario" la calcola solo lo
         script, fotogramma per fotogramma, durante il reveal. */
      .course-video-wipe {
        position: absolute;
        inset: 0;
        z-index: 20;
        background: var(--color-surface);
        clip-path: inset(0);
      }
    </style>

    <script>
      // easeInOutCubic + buildClipPath: stessa tecnica "curtain" costruita
      // dall'utente (poligono ricalcolato ad ogni frame, non una semplice
      // CSS transition tra due stati) — il sipario resta un pannello
      // statico, solo il suo clip-path cambia. Qui serve solo la fase di
      // "reveal" (il video è già caricato sotto, non c'è una fase di
      // cover/scambio contenuti come nella demo originale).
      const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

      const buildClipPath = (edgeLeading: number, edgeTrailing: number, bow: number, steps = 24) => {
        const pts: string[] = [];
        for (let i = 0; i <= steps; i++) {
          const t = i / steps;
          const curve = (bow / 100) * Math.sin(t * Math.PI);
          const x = (edgeLeading + curve) * 100;
          pts.push(`${x}% ${t * 100}%`);
        }
        for (let i = steps; i >= 0; i--) {
          const t = i / steps;
          const curve = (bow / 100) * Math.sin(t * Math.PI);
          const x = (edgeTrailing + curve) * 100;
          pts.push(`${x}% ${t * 100}%`);
        }
        return `polygon(${pts.join(', ')})`;
      };

      // Reveal "clip wipe" one-shot: rivela il video e lo avvia (muto) la
      // prima volta che entra in viewport, senza più toccarlo dopo (a
      // differenza del teaser in home, un vero tutorial con audio non va
      // messo in pausa/azzerato quando la sezione esce dallo schermo).
      const setupCourseVideoReveal = () => {
        const card = document.querySelector<HTMLElement>('[data-course-video-card]');
        const video = card?.querySelector<HTMLVideoElement>('[data-course-video]');
        const wipe = card?.querySelector<HTMLElement>('.course-video-wipe');
        const unmuteBtn = card?.querySelector<HTMLButtonElement>('[data-unmute-btn]');
        if (!card || !video || !wipe || card.dataset.revealBound) return;
        card.dataset.revealBound = '1';

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const DURATION = 2000; // stessa durata di .reveal-left (global.css)
        const BOW = 15;

        const reveal = () => {
          card.classList.add('is-visible');
          // Un <video> riutilizzato dal router di Astro dopo una
          // navigazione client-side (via e ritorno su /courses/) resta con
          // readyState 0 anche se l'attributo src è corretto: il browser
          // non riavvia da solo l'algoritmo di selezione della risorsa sul
          // nodo riciclato, va richiamato load() esplicitamente prima di
          // play() (stesso problema già gestito in ScrollReveal.astro).
          if (video.readyState === 0) {
            video.load();
          }
          // L'autoplay con audio è bloccato da tutti i browser: parte solo
          // muto, l'utente attiva l'audio dal pulsante o dai controlli nativi.
          video.play().catch(() => {});

          if (reduceMotion) {
            wipe.style.clipPath = buildClipPath(-0.3, -0.3, 0);
            card.classList.add('is-framed');
            return;
          }

          const start = performance.now();
          const frame = (now: number) => {
            const p = Math.min(1, (now - start) / DURATION);
            const eased = easeInOutCubic(p);
            // Il bordo "trailing" avanza da fuori-scena a sinistra (-0.3)
            // a fuori-scena a destra (1.15); il "leading" resta fisso
            // fuori-scena a destra: il sipario si ritira verso destra
            // scoprendo il video da sinistra a destra, con la pancia della
            // curva a inseguire al centro invece di un bordo dritto.
            const leading = 1.15;
            const trailing = -0.3 + eased * 1.45;
            wipe.style.clipPath = buildClipPath(leading, trailing, BOW);
            if (p < 1) {
              requestAnimationFrame(frame);
            } else {
              card.classList.add('is-framed');
            }
          };
          requestAnimationFrame(frame);
        };

        if (reduceMotion) {
          reveal();
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  reveal();
                  observer.disconnect();
                }
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
          );
          observer.observe(card);
        }

        unmuteBtn?.addEventListener('click', () => {
          video.muted = false;
          video.play().catch(() => {});
          unmuteBtn.remove();
        });

        video.addEventListener('volumechange', () => {
          if (!video.muted) unmuteBtn?.remove();
        });
      };

      // 'astro:page-load' fires on the initial load too (not just
      // client-side navigations), so this alone covers both cases — no
      // separate top-level call needed.
      document.addEventListener('astro:page-load', setupCourseVideoReveal);
    </script>

    <div class="mt-8 border-t border-white/10 pt-6">
      <p class="eyebrow">
        <span data-lang-en>Course topic</span>
        <span data-lang-it>Argomenti del corso</span>
      </p>
      <h2 class="reveal-left mt-2 text-2xl font-semibold sm:whitespace-nowrap sm:text-2xl" data-course-title>
        <span data-lang-en>We'll learn how to transform a RAW file into an extraordinary vision of the universe.</span>
        <span data-lang-it>Impareremo a trasformare un file RAW in una straordinaria visione dell'universo.</span>
      </h2>
      <div class="mt-5 flex flex-col gap-2 sm:grid sm:grid-cols-2 sm:gap-2">
        <ul class="flex flex-col gap-2">
          {topicsLeft.map((t) => (
            <li class="flex gap-3 text-white/80">
              <span class="text-accent">■</span>
              <span class="topic-fade" data-lang-en>{t.en}</span>
              <span class="topic-fade" data-lang-it>{t.it}</span>
            </li>
          ))}
        </ul>
        <ul class="flex flex-col gap-2">
          {topicsRight.map((t) => (
            <li class="flex gap-3 text-white/80">
              <span class="text-accent">■</span>
              <span class="topic-fade" data-lang-en>{t.en}</span>
              <span class="topic-fade" data-lang-it>{t.it}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <a href={withBase('/')} class="btn-accent justify-center min-w-[190px]" data-astro-reload>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span data-lang-en>Back to Home</span>
        <span data-lang-it>Torna alla Home</span>
      </a>
    </div>

    <style>
      /* Testo delle voci: fade in puro (i quadratini arancioni restano
         sempre visibili, non hanno questa classe). Gestito via JS
         (setupTopicsReveal sotto) invece del generico .reveal-fade: qui
         serve pilotare l'ordine preciso colonna-per-colonna e attendere
         la fine del reveal-left del titolo, cosa che il transition-delay
         CSS da solo non può garantire in modo affidabile ad ogni reload. */
      .topic-fade {
        opacity: 0;
        transition: opacity 0.9s ease-out;
      }

      .topic-fade.is-visible {
        opacity: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        .topic-fade {
          opacity: 1;
          transition: none;
        }
      }
    </style>

    <script>
      // Sequenza titolo -> colonne: un'unica IntersectionObserver pilota sia
      // il reveal-left del titolo (escluso dall'observer generico di
      // ScrollReveal.astro tramite [data-course-title]) sia i timer delle
      // voci, cosi i due restano sempre sincronizzati — anche al refresh,
      // quando titolo e lista possono risultare già entrambi nel viewport
      // nello stesso istante invece che in due passaggi di scroll separati.
      const setupTopicsReveal = () => {
        const title = document.querySelector<HTMLElement>('[data-course-title]');
        const items = Array.from(document.querySelectorAll<HTMLElement>('.topic-fade'));
        if (!title || !items.length || title.dataset.topicsBound) return;
        title.dataset.topicsBound = '1';

        const TITLE_DURATION = 2000; // stessa durata di .reveal-left (global.css)
        const STAGGER = 250;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Gli elementi sono già nel markup nell'ordine sequenziale 1->8
        // (colonna sinistra poi destra): basta dividerli a metà per
        // ottenere le due colonne, così la sequenza resta corretta sia
        // sulla griglia a due colonne del desktop sia sull'impilamento a
        // colonna singola del mobile.
        const half = Math.ceil(items.length / 2);
        const leftItems = items.slice(0, half);
        const rightItems = items.slice(half);
        // Colonna dx parte una pausa (STAGGER) dopo l'ultima voce della sx.
        const rightStart = leftItems.length * STAGGER + STAGGER;

        if (reduceMotion) {
          title.classList.add('is-visible');
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        let timers: number[] = [];
        const clearTimers = () => {
          timers.forEach((id) => window.clearTimeout(id));
          timers = [];
        };

        const showColumns = () => {
          leftItems.forEach((el, row) => {
            timers.push(window.setTimeout(() => el.classList.add('is-visible'), row * STAGGER));
          });
          rightItems.forEach((el, row) => {
            timers.push(window.setTimeout(() => el.classList.add('is-visible'), rightStart + row * STAGGER));
          });
        };

        // One-shot: plays the first time the title enters the viewport,
        // then detaches — scrolling back up never re-hides or replays it.
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                clearTimers();
                title.classList.add('is-visible');
                timers.push(window.setTimeout(showColumns, TITLE_DURATION));
                observer.disconnect();
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
        );
        observer.observe(title);
      };

      document.addEventListener('astro:page-load', setupTopicsReveal);
    </script>
  </section>
</Layout>
