---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/url';

const topics = [
  {
    en: 'Image stacking, calibration with dark, flat, darkflat',
    it: 'Stacking delle immagini, calibrazione con dark, flat, darkflat',
  },
  {
    en: 'Creation and calibration of RGB channels',
    it: 'Creazione e calibrazione dei canali RGB',
  },
  {
    en: 'Gradient removal, photometric color calibration, starless image',
    it: 'Rimozione dei gradienti, calibrazione fotometrica del colore, immagine starless',
  },
  {
    en: 'Deconvolution and linear denoising',
    it: 'Deconvoluzione e denoising in fase lineare',
  },
  {
    en: 'Stretching and non-linear phase',
    it: 'Stretching e fase non lineare',
  },
  {
    en: 'Curves, contrasts, saturation, blending modes',
    it: 'Curve, contrasti, saturazione, blending mode',
  },
  {
    en: 'Definition of fine details, star color calibration, final image',
    it: 'Definizione dei dettagli fini, calibrazione del colore delle stelle, immagine finale',
  },
  {
    en: 'Questions, reflections, release of the video lesson',
    it: 'Domande, riflessioni, consegna della video lezione',
  },
];
---

<Layout
  title="Customised Online Courses"
  titleIt="Corsi Online Personalizzati"
  description="Personalized online astrophotography courses: stacking, gradient removal, stretching and color calibration with PixInsight, Photoshop and Camera Raw."
  descriptionIt="Corsi online personalizzati di astrofotografia: stacking, rimozione dei gradienti, stretching e calibrazione del colore con PixInsight, Photoshop e Camera Raw."
>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <p class="eyebrow">
          <span data-lang-en>How can I help you?</span>
          <span data-lang-it>Come posso aiutarti?</span>
        </p>
        <div class="prose-astro mt-4">
          <div data-lang-en>
            <p>
              I have transformed my passion for processing into a clear and effective teaching method. In my
              <strong>online courses</strong>, I will teach you my complete workflow for transforming a simple
              RAW file into a spectacular astronomical photograph.
            </p>
            <p>
              Together, we will go through every step of the process: from stacking to removing gradients,
              stretching the image, and managing color with powerful tools such as PixInsight, Photoshop, and
              Camera Raw. This course is designed for both beginners and those who want to discover alternative
              techniques.
            </p>
            <p>
              <a href={withBase('/contact/')} class="font-semibold">Click here</a> to contact me through your preferred
              channels and get more information.
            </p>
          </div>
          <div data-lang-it>
            <p>
              Ho trasformato la mia passione per l'elaborazione in un metodo di insegnamento chiaro ed
              efficace. Nei miei <strong>corsi online</strong>, ti insegnerò il mio flusso di lavoro completo
              per trasformare un semplice file RAW in una spettacolare fotografia astronomica.
            </p>
            <p>
              Insieme percorreremo ogni fase del processo: dallo stacking alla rimozione dei gradienti, allo
              stretching dell'immagine, fino alla gestione del colore con strumenti potenti come PixInsight,
              Photoshop e Camera Raw. Questo corso è pensato sia per i principianti sia per chi vuole scoprire
              tecniche alternative.
            </p>
            <p>
              <a href={withBase('/contact/')} class="font-semibold">Clicca qui</a> per contattarmi attraverso il tuo
              canale preferito e ricevere maggiori informazioni.
            </p>
          </div>
        </div>
      </div>

      <div>
        <p class="text-sm text-white/60">
          <span data-lang-en>The video shows an example of how raw data can be transformed into a stunning final image.</span>
          <span data-lang-it>Il video mostra un esempio di come i dati raw possano essere trasformati in una splendida immagine finale.</span>
        </p>
        <video
          class="mt-4 w-full rounded-xl border border-white/10"
          src={withBase('/video/course-demo.mp4')}
          poster={withBase('/video/course-demo-poster.jpg')}
          controls
          playsinline
          preload="none"
        />
      </div>
    </div>

    <div class="mt-20 border-t border-white/10 pt-16">
      <p class="eyebrow">
        <span data-lang-en>Course topic</span>
        <span data-lang-it>Argomenti del corso</span>
      </p>
      <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">
        <span data-lang-en>We will learn how to manage our raw files<br /> and get to the final image</span>
        <span data-lang-it>Impareremo a gestire i nostri file raw<br /> fino ad arrivare all'immagine finale</span>
      </h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {topics.map((t) => (
          <li class="flex gap-3 text-white/80">
            <span class="text-accent">■</span>
            <span data-lang-en>{t.en}</span>
            <span data-lang-it>{t.it}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
