---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { slide } from 'astro:transitions';
import { marked } from 'marked';
import portrait from '../../assets/about/portrait.jpg';
import nasaApod from '../../assets/about/nasa-apod-300x127-300x127.jpg';
import optolongAward from '../../assets/about/optolong.jpg';
import astrobinAwards from '../../assets/about/astrobin-awards-badge.png';
import astrobinStats from '../../assets/about/astrobin-stats.png';
import astrobinStatsEn from '../../assets/about/astrobin-stats-en.png';
import { withBase } from '../../utils/url';

// Bounding box (px, riferiti alla risoluzione nativa 2176x1348 del PNG,
// identica in entrambe le lingue) di ogni numero mostrato nello screenshot
// AstroBin, individuata a livello di pixel con una soglia di luminanza
// (script scratch, non nel repo) invece che a occhio, per evitare di
// disallineare l'overlay animato dal numero reale sotto.
const NUMBER_OVERLAYS = [
  { key: 'images', value: 89, x: 379, y: 529, w: 72, h: 55, color: 'white' },
  { key: 'followers', value: 373, x: 1035, y: 537, w: 106, h: 46, color: 'white' },
  { key: 'following', value: 1086, x: 1690, y: 528, w: 144, h: 46, color: 'white' },
  { key: 'totalIntegrationHours', value: 1136, x: 348, y: 798, w: 134, h: 52, color: 'accent' },
  { key: 'averageHoursPerImage', value: '12.9', x: 1030, y: 807, w: 117, h: 43, color: 'white' },
  { key: 'awardedImages', value: 16, x: 1680, y: 798, w: 66, h: 46, color: 'accent' },
  { key: 'imageOfTheDay', value: 1, x: 306, y: 1120, w: 24, h: 30, color: 'white' },
  { key: 'topPick', value: 10, x: 977, y: 1120, w: 53, h: 30, color: 'white' },
  { key: 'topPickNomination', value: 5, x: 1647, y: 1120, w: 26, h: 38, color: 'white' },
];
const STATS_IMAGE_NATURAL_WIDTH = 2176;
const STATS_IMAGE_NATURAL_HEIGHT = 1348;
// Sfondo carta campionato a pixel dal PNG (#26262e): copre la cifra
// originale prima di disegnarci sopra il numero animato.
const STATS_CARD_BG = '#26262e';

const entry = await getEntry('about', 'bio');
const [bodyIt, bodyEn] = entry?.body?.split(/\n\n---\n\n/) ?? ['', ''];
const contentItHtml = (await marked.parse(bodyIt.trim())).replaceAll('href="/courses/"', `href="${withBase('/courses/')}"`);
const contentEnHtml = (await marked.parse(bodyEn.trim())).replaceAll('href="/courses/"', `href="${withBase('/courses/')}"`);
---

<Layout
  title="About Me"
  titleIt="Chi sono"
  description="Amateur astrophotographer since 2018, sharing the sky from a home terrace in Italy."
  descriptionIt="Astrofotografo amatoriale dal 2018, condivido il cielo da una terrazza di casa in Italia."
>
  <section class="mx-auto max-w-6xl px-6 pt-32 pb-20">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <div class="relative block aspect-[4/5] w-full max-w-md overflow-hidden rounded-2xl ring-1 ring-white/10">
        <Image
          quality={90}
          src={portrait}
          alt="Valerio Avitabile"
          class="h-full w-full rounded-2xl object-cover portrait-blur-in"
        />
      </div>
      <div transition:animate={slide({ duration: '2.6s' })}>
        <p class="eyebrow">
          <span data-lang-en>About me</span>
          <span data-lang-it>Chi sono</span>
        </p>
        <div class="prose-astro mt-4">
          <div data-lang-en set:html={contentEnHtml} />
          <div data-lang-it set:html={contentItHtml} />
        </div>
      </div>
    </div>

    <div class="mt-16 border-t border-white/10 pt-10 sm:mt-20 sm:pt-12">
      <p class="eyebrow text-center">
        <span data-lang-en>Recognitions</span>
        <span data-lang-it>Riconoscimenti</span>
      </p>
      <div class="iris-gallery mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3 sm:items-start">
        <a
          href="https://apod.nasa.gov/apod/ap211105.html"
          target="_blank"
          rel="noopener noreferrer"
          class="iris-card media-card aspect-[300/127]"
        >
          <span class="iris-stage relative block h-full w-full">
            <span class="iris-reveal block h-full w-full">
              <Image src={nasaApod} alt="NASA Astronomy Picture of the Day" class="h-full w-full object-cover" />
            </span>
          </span>
        </a>
        <a
          href="https://optolong.com/cms/document/detail/id/165.html"
          target="_blank"
          rel="noopener noreferrer"
          class="iris-card media-card aspect-[900/383]"
        >
          <span class="iris-stage relative block h-full w-full">
            <span class="iris-reveal block h-full w-full">
              <Image src={optolongAward} alt="Optolong Deep-Sky Astrophotography Competition 2021 prize-winner" class="h-full w-full object-cover" />
            </span>
          </span>
        </a>
        <button
          type="button"
          id="astrobin-awards-trigger"
          data-stats-src={astrobinStats.src}
          data-stats-src-en={astrobinStatsEn.src}
          aria-label="AstroBin Awards"
          data-tr={JSON.stringify({ attr: 'aria-label', it: 'Statistiche AstroBin', en: 'AstroBin stats' })}
          class="iris-card media-card aspect-[900/383] cursor-pointer"
        >
          <span class="iris-stage relative block h-full w-full">
            <span class="iris-reveal block h-full w-full">
              <Image src={astrobinAwards} alt="AstroBin Awards" class="h-full w-full object-cover" />
            </span>
          </span>
        </button>
      </div>
    </div>

    <div class="mt-16 flex justify-center">
      <a href={withBase('/')} class="btn-accent justify-center min-w-[190px]" data-astro-reload>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span data-lang-en>Back to Home</span>
        <span data-lang-it>Torna alla Home</span>
      </a>
    </div>
  </section>

  <script define:vars={{ NUMBER_OVERLAYS, STATS_IMAGE_NATURAL_WIDTH, STATS_IMAGE_NATURAL_HEIGHT, STATS_CARD_BG }}>
    // Modale fade-in per la card AstroBin Awards: stesso schema apri/chiudi
    // del modale video (LiteYouTube.astro) — overlay creato via JS e
    // appeso in coda a <body> cosi finisce sempre sopra header/lang-switcher
    // a prescindere dallo z-index dichiarato staticamente. Il modale mostra
    // lo screenshot AstroBin reale (identico all'originale, IT/EN): sopra
    // ogni numero viene disegnato un rettangolo dello stesso colore di
    // sfondo della card (nasconde la cifra del PNG) con sopra il numero
    // vero come testo animato a rullo (odometro), posizionato in percentuale
    // sulla bbox pixel-precisa individuata nello screenshot originale
    // (vedi NUMBER_OVERLAYS in frontmatter). Il resto dell'immagine (titolo,
    // icone dei badge, etichette, percentuali) resta lo screenshot originale,
    // invariato.
    const buildOdometer = (el, digitEm) => {
      const target = el.dataset.odometer ?? '';
      el.textContent = '';
      el.classList.add('odometer');
      const strips = [];

      for (const ch of target) {
        if (/[0-9]/.test(ch)) {
          const reel = document.createElement('span');
          reel.className = 'odometer-digit';
          if (digitEm) reel.style.width = `${digitEm}em`;
          const strip = document.createElement('span');
          strip.className = 'odometer-digit-strip';
          for (let i = 0; i <= 9; i += 1) {
            const digitEl = document.createElement('span');
            digitEl.className = 'odometer-digit-cell';
            digitEl.textContent = String(i);
            strip.append(digitEl);
          }
          reel.append(strip);
          el.append(reel);
          strips.push({ strip, digit: Number(ch) });
        } else {
          const staticEl = document.createElement('span');
          staticEl.className = 'odometer-static';
          staticEl.textContent = ch;
          el.append(staticEl);
        }
      }

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          strips.forEach(({ strip, digit }, i) => {
            strip.style.transitionDelay = `${i * 60}ms`;
            strip.style.transform = `translateY(-${digit * 10}%)`;
          });
        });
      });
    };

    // Un rullo per cifra ha una larghezza propria (0.62em, vedi CSS), quindi
    // un numero a N cifre e' largo N*0.62em: il rettangolo di copertura deve
    // essere posizionato/dimensionato di conseguenza, non semplicemente
    // sovrapposto alla bbox del testo originale (che e' piu' stretta di un
    // font monospaziato).
    const DIGIT_EM = 0.62;

    const layoutNumberOverlays = (frame, img) => {
      const scale = img.clientWidth / STATS_IMAGE_NATURAL_WIDTH;
      frame.querySelectorAll('.stats-number-overlay').forEach((wrap) => {
        const spec = NUMBER_OVERLAYS.find((s) => s.key === wrap.dataset.key);
        if (!spec) return;
        const fontSizePx = (spec.h * scale) / 0.72;
        const digitCount = String(spec.value).replace(/[^0-9]/g, '').length || 1;
        const numberWidthPx = digitCount * DIGIT_EM * fontSizePx;
        const centerXPx = (spec.x + spec.w / 2) * scale;
        const centerYPx = (spec.y + spec.h / 2) * scale;
        const padPx = fontSizePx * 0.18;

        wrap.style.left = `${centerXPx - numberWidthPx / 2 - padPx}px`;
        wrap.style.top = `${centerYPx - fontSizePx / 2 - padPx * 0.6}px`;
        wrap.style.width = `${numberWidthPx + padPx * 2}px`;
        wrap.style.height = `${fontSizePx + padPx * 1.2}px`;

        const valueEl = wrap.querySelector('.stats-number-value');
        if (valueEl) valueEl.style.fontSize = `${fontSizePx}px`;
      });
    };

    const buildNumberOverlays = (frame, img) => {
      frame.querySelectorAll('.stats-number-overlay').forEach((el) => el.remove());

      for (const spec of NUMBER_OVERLAYS) {
        const wrap = document.createElement('div');
        wrap.className = 'stats-number-overlay absolute flex items-center justify-center rounded-[3px]';
        wrap.dataset.key = spec.key;
        wrap.style.background = STATS_CARD_BG;

        const valueEl = document.createElement('span');
        valueEl.className = `stats-number-value font-bold leading-none ${spec.color === 'accent' ? 'text-accent' : 'text-white'}`;
        valueEl.dataset.odometer = String(spec.value);
        wrap.append(valueEl);
        frame.append(wrap);

        buildOdometer(valueEl, DIGIT_EM);
      }

      layoutNumberOverlays(frame, img);
    };

    const setupAstrobinStatsModal = () => {
      const trigger = document.getElementById('astrobin-awards-trigger');
      if (!trigger || trigger.dataset.bound) return;
      trigger.dataset.bound = '1';

      trigger.addEventListener('click', () => {
        // Lingua attiva al momento del click (stessa convenzione di
        // LiteYouTube.astro), non quella con cui la pagina e' stata
        // renderizzata lato server.
        const lang = document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'it';
        const src = lang === 'en' ? trigger.dataset.statsSrcEn : trigger.dataset.statsSrc;
        if (!src) return;

        const overlay = document.createElement('div');
        overlay.className =
          'fixed inset-0 z-[999] flex items-center justify-center bg-black/90 p-4 opacity-0 transition-opacity duration-300 sm:p-8';

        const wrapper = document.createElement('div');
        wrapper.className = 'relative w-full max-w-4xl';

        const closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.setAttribute('aria-label', 'Close');
        closeBtn.className =
          'absolute -top-10 right-0 text-3xl leading-none text-white/80 transition hover:text-white sm:-top-12';
        closeBtn.textContent = '×';

        const frame = document.createElement('div');
        frame.className = 'relative overflow-hidden rounded-2xl border border-white/10 bg-surface';

        const img = document.createElement('img');
        img.src = src;
        img.alt = lang === 'en' ? 'AstroBin statistics' : 'Statistiche AstroBin';
        img.className = 'h-full w-full object-contain';
        frame.append(img);

        // Il titolo "La mia attivita su AstroBin" e' inciso nel PNG (non
        // testo HTML): l'unico modo di renderlo cliccabile e' un link
        // trasparente posizionato sopra, a percentuale della sua bbox
        // reale nell'immagine (2176x1348) cosi resta allineato a qualsiasi
        // larghezza renderizzata (l'img scala a w-full, height auto).
        const titleLink = document.createElement('a');
        titleLink.href = 'https://www.astrobin.com/users/valerio76/';
        titleLink.target = '_blank';
        titleLink.rel = 'noopener noreferrer';
        titleLink.setAttribute('aria-label', 'AstroBin profile: valerio76');
        titleLink.className = 'group absolute cursor-pointer overflow-hidden';
        const bboxLeft = 4;
        const bboxTop = 9.5;
        const bboxWidth = 41;
        const bboxHeight = 8.5;
        titleLink.style.left = `${bboxLeft}%`;
        titleLink.style.top = `${bboxTop}%`;
        titleLink.style.width = `${bboxWidth}%`;
        titleLink.style.height = `${bboxHeight}%`;

        // Il titolo e' testo bianco inciso nel PNG: non e' ricolorabile via
        // CSS diretto. mask-image con mask-mode:luminance lascerebbe
        // trapelare anche lo sfondo scuro del riquadro (non e' nero puro),
        // disegnando un rettangolo pallido intorno al testo — non
        // accettabile ("solo la scritta, niente sfondo"). Si ritaglia quindi
        // la bbox del titolo su un canvas offscreen alla risoluzione
        // originale e si applica una soglia sulla luminanza pixel per
        // pixel: sopra soglia -> alpha piena (e' il testo), sotto -> alpha
        // zero (sfondo, del tutto trasparente). Il PNG risultante, usato
        // come mask-image in alpha mode (default), sagoma la tinta accent
        // esattamente sulle lettere.
        const tint = document.createElement('span');
        tint.className =
          'pointer-events-none absolute inset-0 bg-accent opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100';
        titleLink.append(tint);

        const buildTitleMask = () => {
          const sx = Math.round((bboxLeft / 100) * img.naturalWidth);
          const sy = Math.round((bboxTop / 100) * img.naturalHeight);
          const sw = Math.round((bboxWidth / 100) * img.naturalWidth);
          const sh = Math.round((bboxHeight / 100) * img.naturalHeight);
          const canvas = document.createElement('canvas');
          canvas.width = sw;
          canvas.height = sh;
          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          ctx.drawImage(img, sx, sy, sw, sh, 0, 0, sw, sh);
          const data = ctx.getImageData(0, 0, sw, sh);
          const LOW = 90;
          const HIGH = 150;
          for (let i = 0; i < data.data.length; i += 4) {
            const luminance = 0.299 * data.data[i] + 0.587 * data.data[i + 1] + 0.114 * data.data[i + 2];
            const alpha = Math.max(0, Math.min(1, (luminance - LOW) / (HIGH - LOW)));
            data.data[i + 3] = Math.round(alpha * 255);
          }
          ctx.putImageData(data, 0, 0);
          const dataUrl = canvas.toDataURL('image/png');
          tint.style.maskImage = `url("${dataUrl}")`;
          tint.style.webkitMaskImage = `url("${dataUrl}")`;
          tint.style.maskSize = '100% 100%';
          tint.style.webkitMaskSize = '100% 100%';
          tint.style.maskRepeat = 'no-repeat';
          tint.style.webkitMaskRepeat = 'no-repeat';
        };

        const onImageReady = () => {
          buildTitleMask();
          buildNumberOverlays(frame, img);
        };

        if (img.complete && img.naturalWidth) {
          onImageReady();
        } else {
          img.addEventListener('load', onImageReady, { once: true });
        }

        const onResize = () => layoutNumberOverlays(frame, img);
        window.addEventListener('resize', onResize);

        frame.append(titleLink);

        wrapper.append(closeBtn, frame);
        overlay.append(wrapper);
        document.body.append(overlay);
        document.body.classList.add('overflow-hidden');
        requestAnimationFrame(() => overlay.classList.remove('opacity-0'));

        const close = () => {
          overlay.classList.add('opacity-0');
          document.body.classList.remove('overflow-hidden');
          document.removeEventListener('keydown', onKeydown);
          window.removeEventListener('resize', onResize);
          window.setTimeout(() => overlay.remove(), 300);
        };

        const onKeydown = (e) => {
          if (e.key === 'Escape') close();
        };

        closeBtn.addEventListener('click', close);
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) close();
        });
        document.addEventListener('keydown', onKeydown);
      });
    };

    document.addEventListener('astro:page-load', setupAstrobinStatsModal);
  </script>

  <style>
    /* Sola animazione voluta per la foto: appare da sfocata a nitida.
       Nessun'altra animazione (hover zoom, morph di pagina, ecc.) deve
       toccare questa immagine. */
    .portrait-blur-in {
      animation: portrait-blur-in 1.2s ease-out both;
    }

    @keyframes portrait-blur-in {
      from {
        filter: blur(20px);
        opacity: 0;
      }
      to {
        filter: blur(0);
        opacity: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .portrait-blur-in {
        animation: none;
      }
    }
  </style>

  <style is:global>
    .odometer {
      display: inline-flex;
      font-variant-numeric: tabular-nums;
    }

    .odometer-digit {
      position: relative;
      display: inline-block;
      height: 1em;
      width: 0.62em;
      overflow: hidden;
      vertical-align: bottom;
    }

    .odometer-digit-strip {
      position: absolute;
      inset: 0 0 auto 0;
      height: 1000%;
      display: flex;
      flex-direction: column;
      transform: translateY(0);
      transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .odometer-digit-cell {
      height: 10%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .odometer-static {
      display: inline-block;
    }
  </style>
</Layout>
