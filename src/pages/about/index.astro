---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { slide } from 'astro:transitions';
import { marked } from 'marked';
import portrait from '../../assets/about/portrait.jpg';
import { withBase } from '../../utils/url';

const entry = await getEntry('about', 'bio');
const [bodyIt, bodyEn] = entry?.body?.split(/\n\n---\n\n/) ?? ['', ''];
const contentItHtml = (await marked.parse(bodyIt.trim())).replaceAll('href="/courses/"', `href="${withBase('/courses/')}"`);
const contentEnHtml = (await marked.parse(bodyEn.trim())).replaceAll('href="/courses/"', `href="${withBase('/courses/')}"`);
---

<Layout
  title="About Me"
  titleIt="Chi sono"
  description="Amateur astrophotographer since 2018, sharing the sky from a home terrace in Italy."
  descriptionIt="Astrofotografo amatoriale dal 2018, condivido il cielo da una terrazza di casa in Italia."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <div class="media-card aspect-[4/5] w-full max-w-md">
        <Image
          quality={90}
          src={portrait}
          alt="Valerio Avitabile"
          class="h-full rounded-2xl"
          transition:name="about-portrait"
        />
      </div>
      <div transition:animate={slide({ duration: '2.6s' })}>
        <p class="eyebrow">
          <span data-lang-en>About me</span>
          <span data-lang-it>Chi sono</span>
        </p>
        <div class="prose-astro mt-4">
          <div data-lang-en set:html={contentEnHtml} />
          <div data-lang-it set:html={contentItHtml} />
        </div>
      </div>
    </div>
  </section>
</Layout>
