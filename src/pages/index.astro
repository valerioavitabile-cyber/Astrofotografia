---
import Layout from '../layouts/Layout.astro';
import HeroSlideshow from '../components/HeroSlideshow';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import coursesVideo from '../assets/home/slideshow/Video Project (1).mp4';
import videoTutorial from '../assets/home/video tutorial 2.png';
import astronomyTool from '../assets/home/astronomy tool.png';
import portrait from '../assets/about/portrait.jpg';
import { site, categories } from '../data/site';
import { withBase } from '../utils/url';

const portfolioEntries = await getCollection('portfolio');

// Every portfolio photo is a candidate hero slide; 6 are picked at random
// client-side on mount (see HeroSlideshow), so the combination differs on
// every real browser refresh — including which one lands in slide 0, so no
// specific image here can be preloaded/prioritized ahead of time from
// Astro's side (HeroSlideshow prioritizes whichever slide ends up at
// position 0 once the client has made its pick).
const heroPool = await Promise.all(
  portfolioEntries.map(async (entry) => {
    const optimized = await getImage({ src: entry.data.image, width: 1920, format: 'webp', quality: 80 });
    return { src: optimized.src, alt: entry.data.title };
  }),
);

const entriesByCategory: Record<string, typeof portfolioEntries> = {};
for (const entry of portfolioEntries) {
  const categoryId = entry.id.split('/')[0];
  (entriesByCategory[categoryId] ??= []).push(entry);
}

// Same idea for the portfolio grid: every photo in a category is a candidate
// cover, all pre-optimized here, and a small inline script (below) swaps in
// a random one client-side so the "first photo" of each section is
// different on every refresh too.
const portfolioGrid = await Promise.all(
  Object.entries(categories).map(async ([id, cat]) => {
    const entries = entriesByCategory[id] ?? [];
    const variants = await Promise.all(
      entries.map(async (entry) => {
        const optimized = await getImage({ src: entry.data.image, width: 480, height: 480, format: 'webp', quality: 90 });
        return optimized.src;
      }),
    );
    return { id, cat, variants };
  }),
);

---

<Layout title={site.title} description={site.description} descriptionIt={site.descriptionIt}>
  <section id="hero" class="relative flex min-h-dvh items-end overflow-hidden">
    <HeroSlideshow client:load pool={heroPool} />
    <!-- Reserves the layout space for the animated title, which is rendered
         once in Header.astro and morphs into the corner brand on scroll. -->
    <div id="hero-placeholder" class="invisible relative z-10 mx-auto w-full max-w-6xl px-6 pb-20">
      <h1 class="text-5xl font-bold tracking-tight sm:text-7xl">Valerio Avitabile</h1>
      <p class="mt-3 text-[2.75rem] tracking-[0.08em] text-accent">Astrophotography</p>
    </div>
  </section>

  <section id="portfolio" class="border-t border-white/5 scroll-mt-20">
    <div class="reveal-left mx-auto max-w-6xl px-6 pt-8 pb-4 text-left">
      <p class="eyebrow">Portfolio</p>
      <h2 class="mt-4 text-4xl font-semibold leading-[1.05] sm:whitespace-nowrap sm:text-6xl">
        <span data-lang-en>The universe in your eyes</span>
        <span data-lang-it>L’universo nei tuoi occhi</span>
      </h2>
      <p class="mt-5 max-w-xl text-xl leading-relaxed text-white/70">
        <span data-lang-en>Galaxies, nebulae, stars in a single shot</span>
        <span data-lang-it>Galassie, nebulose e stelle in un solo scatto</span>
      </p>
    </div>
  </section>

  <section class="iris-gallery grid grid-cols-2 gap-4 px-6 pb-6 sm:grid-cols-4 sm:gap-6 sm:pb-10">
    {portfolioGrid.map(({ cat, variants }) => (
      <a
        href={withBase(`/portfolio/${cat.slug}/`)}
        class="iris-card media-card group block"
      >
        <span class="iris-stage relative block aspect-[16/9]">
          {variants.length > 0 && (
            <span class="iris-reveal block h-full w-full">
              <img
                src={variants[0]}
                data-cover-variants={variants.length > 1 ? JSON.stringify(variants) : undefined}
                alt={cat.title}
                width={480}
                height={480}
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </span>
          )}
        </span>
        <div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-black/80 via-black/10 to-transparent" />
        <div class="absolute inset-x-0 bottom-0 z-10 p-5">
          <p class="text-lg font-semibold text-white">
            <span data-lang-en>{cat.title}</span>
            <span data-lang-it>{cat.titleIt}</span>
          </p>
        </div>
      </a>
    ))}
  </section>
  <script>
    // Each cover card starts on its build-time default image; here we swap
    // in a random candidate from the same category. Bound to
    // 'astro:page-load' (not just run inline) because the ClientRouter
    // reuses this unchanged script tag across client-side navigations
    // instead of re-executing it, so relying on the inline run alone means
    // covers only randomize on a hard refresh and revert to the build-time
    // defaults whenever you navigate back to the home page in-app.
    function randomizeCovers() {
      document.querySelectorAll<HTMLImageElement>('[data-cover-variants]').forEach((img) => {
        const variants: string[] = JSON.parse(img.dataset.coverVariants ?? '[]');
        if (variants.length < 2) return;
        img.src = variants[Math.floor(Math.random() * variants.length)];
      });
    }
    randomizeCovers();
    document.addEventListener('astro:page-load', randomizeCovers);
  </script>

  <section class="border-t border-white/5">
    <div class="reveal-left mx-auto max-w-6xl px-6 pt-10 pb-8 text-left">
      <p class="eyebrow">
        <span data-lang-en>How can I help you?</span>
        <span data-lang-it>Come posso aiutarti?</span>
      </p>
      <h2 class="mt-4 text-4xl font-semibold leading-[1.05] sm:whitespace-nowrap sm:text-6xl">
        <span data-lang-en>Customised online courses</span>
        <span data-lang-it>Corsi online personalizzati</span>
      </h2>
      <p class="mt-5 max-w-xl text-xl leading-relaxed text-white/70">
        <span data-lang-en>Stacking, photo editing, software, and other tips</span>
        <span data-lang-it>Stacking, editing fotografico, software e altri consigli</span>
      </p>
    </div>

    <div class="mx-auto max-w-6xl px-6 pb-24">
      <a href={withBase('/courses/')} class="mosaic-reveal media-card group aspect-video w-full">
        <video
          src={coursesVideo}
          loop
          muted
          playsinline
          data-mosaic-video
        />
        <div class="mosaic-tiles" aria-hidden="true">
          {Array.from({ length: 260 }).map(() => (
            <span class="mosaic-tile"></span>
          ))}
        </div>
        <span class="media-card-overlay">
          <span class="media-card-label">
            <span data-lang-en>Discover courses</span>
            <span data-lang-it>Scopri i corsi</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </span>
      </a>
    </div>
  </section>

  <section class="border-t border-white/5 bg-surface/40">
    <div class="reveal-left mx-auto max-w-6xl px-6 py-20 text-left">
      <p class="eyebrow">
        <span data-lang-en>Video &amp; Utilities</span>
        <span data-lang-it>Video & Utility</span>
      </p>
      <h2 class="mt-4 text-4xl font-semibold leading-[1.05] sm:whitespace-nowrap sm:text-6xl" data-parallax="0.04">
        <span data-lang-en>Videos and astronomical calculation tools</span>
        <span data-lang-it>Video e strumenti di calcolo astronomico</span>
      </h2>
      <p class="mt-5 max-w-xl text-xl leading-relaxed text-white/70">
        <span data-lang-en>Tutorials to follow, tools to use</span>
        <span data-lang-it>Tutorial da seguire, strumenti da sfruttare</span>
      </p>
    </div>
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 pb-4 sm:grid-cols-2">
      <div data-parallax="-0.03">
        <a href={withBase('/video-utility/#video')} class="reveal-blur media-card group block aspect-video w-full">
          <Image quality={90} src={videoTutorial} alt="Video tutorial and astronomical calculation tools" />
          <span class="media-card-overlay">
            <span class="media-card-label">
              <span data-lang-en>Watch tutorials</span>
              <span data-lang-it>Guarda i tutorial</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </a>
      </div>
      <div>
        <a href={withBase('/video-utility/#tools')} class="reveal-blur media-card group block aspect-video w-full">
          <Image quality={90} src={astronomyTool} alt="Astronomy tools for plate solving and calculations" />
          <span class="media-card-overlay">
            <span class="media-card-label">
              <span data-lang-en>Explore tools</span>
              <span data-lang-it>Esplora gli strumenti</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-12 md:grid-cols-2 md:items-center">
        <a href={withBase('/about/')} data-portrait-link class="barn-door-reveal media-card group block aspect-[4/5] w-full max-w-md">
          <Image
            quality={90}
            src={portrait}
            alt="Valerio Avitabile, astrophotographer"
            class="h-full rounded-2xl"
          />
          <span class="barn-door barn-door-left" aria-hidden="true"></span>
          <span class="barn-door barn-door-right" aria-hidden="true"></span>
          <span class="media-card-overlay">
            <span class="media-card-label">
              <span data-lang-en>Read my story</span>
              <span data-lang-it>Leggi la mia storia</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </a>

        <div class="reveal-right text-left">
          <p class="eyebrow">
            <span data-lang-en>About me</span>
            <span data-lang-it>Chi sono</span>
          </p>
          <h2 class="mt-4 text-4xl font-semibold leading-[1.05] sm:text-6xl" data-parallax="0.04">
            <span data-lang-en>Astrophotography is a lifestyle, a way of being&hellip;</span>
            <span data-lang-it>L’astrofotografia è uno stile di vita, un modo di essere&hellip;</span>
          </h2>

          <a href={withBase('/about/')} class="btn-accent mt-6 justify-center min-w-[190px]">
            <span data-lang-en>My story</span>
            <span data-lang-it>La mia storia</span>
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
