---
import Layout from '../layouts/Layout.astro';
import HeroSlideshow from '../components/HeroSlideshow';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import b150 from '../assets/home/b150.jpg';
import hargb from '../assets/home/hargb.jpg';
import ic443 from '../assets/home/ic443-sho.jpg';
import m44 from '../assets/home/m44.jpg';
import ngc6914 from '../assets/home/ngc6914-halrgb.jpg';
import wr134 from '../assets/home/wr134.jpg';
import coursesVideo from '../assets/home/slideshow/Video Project (1).mp4';
import videoTutorial from '../assets/home/video tutorial 2.png';
import astronomyTool from '../assets/home/astronomy tool.png';
import portrait from '../assets/about/portrait.jpg';
import { site, categories } from '../data/site';

const featured = [
  { img: hargb, alt: 'Wide-field HaRGB astrophotography shot' },
  { img: ic443, alt: 'IC 443, the Jellyfish Nebula, in SHO palette' },
  { img: ngc6914, alt: 'NGC 6914 nebula in HaLRGB' },
  { img: wr134, alt: 'WR 134, Wolf-Rayet nebula' },
  { img: b150, alt: 'B150 dark nebula' },
  { img: m44, alt: 'M44, the Beehive Cluster' },
];

const slides = await Promise.all(
  featured.map(async ({ img, alt }) => {
    const optimized = await getImage({ src: img, width: 1920, format: 'webp', quality: 80 });
    return { src: optimized.src, alt };
  }),
);

const portfolioEntries = await getCollection('portfolio');
const portfolioCovers: Record<string, (typeof portfolioEntries)[number]> = {};
for (const entry of portfolioEntries) {
  if (!portfolioCovers[entry.data.category]) portfolioCovers[entry.data.category] = entry;
}
const portfolioGrid = Object.entries(categories).map(([id, cat]) => ({
  id,
  cat,
  cover: portfolioCovers[id],
}));

---

<Layout title={site.title} description={site.description} descriptionIt={site.descriptionIt} preloadImage={slides[0].src}>
  <section id="hero" class="relative flex min-h-dvh items-end overflow-hidden">
    <HeroSlideshow client:load slides={slides} />
    <!-- Reserves the layout space for the animated title, which is rendered
         once in Header.astro and morphs into the corner brand on scroll. -->
    <div id="hero-placeholder" class="invisible relative z-10 mx-auto w-full max-w-6xl px-6 pb-20">
      <h1 class="text-5xl font-bold tracking-tight sm:text-7xl">Valerio Avitabile</h1>
      <p class="mt-3 text-[2.75rem] tracking-[0.08em] text-accent">Astrophotography</p>
    </div>
  </section>

  <section id="portfolio" class="border-t border-white/5 scroll-mt-20">
    <div class="reveal-left mx-auto max-w-6xl px-6 pt-8 pb-4 text-left">
      <p class="eyebrow">Portfolio</p>
      <h2 class="mt-4 whitespace-nowrap text-4xl font-semibold leading-[1.05] sm:text-6xl">
        <span data-lang-en>The universe in your eyes</span>
        <span data-lang-it>L’universo nei tuoi occhi</span>
      </h2>
      <p class="mt-5 max-w-xl text-xl leading-relaxed text-white/70">
        <span data-lang-en>Galaxies, nebulae, stars in a single shot</span>
        <span data-lang-it>Galassie, nebulose, stelle in un solo scatto</span>
      </p>
    </div>
  </section>

  <section class="iris-gallery grid grid-cols-2 gap-4 px-6 pb-6 sm:grid-cols-4 sm:gap-6 sm:pb-10">
    {portfolioGrid.map(({ cat, cover }) => (
      <a
        href={`/portfolio/${cat.slug}/`}
        class="iris-card media-card group block"
      >
        <span class="iris-stage relative block aspect-[16/9]">
          {cover && (
            <span class="iris-reveal block h-full w-full">
              <Image
                quality={90}
                src={cover.data.image}
                alt={cat.title}
                width={480}
                height={480}
                class="h-full w-full object-cover"
              />
            </span>
          )}
        </span>
        <div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-black/80 via-black/10 to-transparent" />
        <div class="absolute inset-x-0 bottom-0 z-10 p-5">
          <p class="text-lg font-semibold text-white">
            <span data-lang-en>{cat.title}</span>
            <span data-lang-it>{cat.titleIt}</span>
          </p>
        </div>
      </a>
    ))}
  </section>

  <section class="border-t border-white/5">
    <div class="reveal-left mx-auto max-w-6xl px-6 pt-10 pb-8 text-left">
      <p class="eyebrow">
        <span data-lang-en>How can I help you?</span>
        <span data-lang-it>Come posso aiutarti?</span>
      </p>
      <h2 class="mt-4 whitespace-nowrap text-4xl font-semibold leading-[1.05] sm:text-6xl">
        <span data-lang-en>Customised online courses</span>
        <span data-lang-it>Corsi online personalizzati</span>
      </h2>
      <p class="mt-5 max-w-xl text-xl leading-relaxed text-white/70">
        <span data-lang-en>Stacking, photo editing, software, and other tips</span>
        <span data-lang-it>Stacking, editing fotografico, software e altri consigli</span>
      </p>
    </div>

    <div class="mx-auto max-w-6xl px-6 pb-24">
      <a href="/courses/" class="mosaic-reveal media-card group aspect-video w-full">
        <video
          src={coursesVideo}
          loop
          muted
          playsinline
          data-mosaic-video
        />
        <div class="mosaic-tiles" aria-hidden="true">
          {Array.from({ length: 260 }).map(() => (
            <span class="mosaic-tile"></span>
          ))}
        </div>
        <span class="media-card-overlay">
          <span class="media-card-label">
            <span data-lang-en>Discover courses</span>
            <span data-lang-it>Scopri i corsi</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </span>
      </a>
    </div>
  </section>

  <section class="border-t border-white/5 bg-surface/40">
    <div class="reveal-left mx-auto max-w-6xl px-6 py-20 text-left">
      <p class="eyebrow">
        <span data-lang-en>Video &amp; Utilities</span>
        <span data-lang-it>Video & Utility</span>
      </p>
      <h2 class="mt-4 whitespace-nowrap text-4xl font-semibold leading-[1.05] sm:text-6xl" data-parallax="0.04">
        <span data-lang-en>Videos and astronomical calculation tools</span>
        <span data-lang-it>Video e strumenti di calcolo astronomico</span>
      </h2>
    </div>
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 pb-4 sm:grid-cols-2">
      <div data-parallax="-0.03">
        <p class="reveal-left text-xl text-white/70">
          <span data-lang-en>Video &amp; tutorial</span>
          <span data-lang-it>Video & tutorial</span>
        </p>
        <a href="/videos/" class="reveal-blur media-card group mt-4 block aspect-video w-full">
          <Image quality={90} src={videoTutorial} alt="Video tutorial and astronomical calculation tools" />
          <span class="media-card-overlay">
            <span class="media-card-label">
              <span data-lang-en>Watch tutorials</span>
              <span data-lang-it>Guarda i tutorial</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </a>
      </div>
      <div>
        <p class="reveal-right text-xl text-white/70">
          <span data-lang-en>Plate solve and other</span>
          <span data-lang-it>Plate solve e altro</span>
        </p>
        <a href="/utility/" class="reveal-blur media-card group mt-4 block aspect-video w-full">
          <Image quality={90} src={astronomyTool} alt="Astronomy tools for plate solving and calculations" />
          <span class="media-card-overlay">
            <span class="media-card-label">
              <span data-lang-en>Explore tools</span>
              <span data-lang-it>Esplora gli strumenti</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-12 md:grid-cols-2 md:items-center">
        <a href="/about/" data-portrait-link class="barn-door-reveal media-card group block aspect-[4/5] w-full max-w-md">
          <Image
            quality={90}
            src={portrait}
            alt="Valerio Avitabile, astrophotographer"
            class="h-full rounded-2xl"
            transition:name="about-portrait"
          />
          <span class="barn-door barn-door-left" aria-hidden="true"></span>
          <span class="barn-door barn-door-right" aria-hidden="true"></span>
          <span class="media-card-overlay">
            <span class="media-card-label">
              <span data-lang-en>Read my story</span>
              <span data-lang-it>Leggi la mia storia</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </a>

        <div class="reveal-right text-left">
          <p class="eyebrow">
            <span data-lang-en>About me</span>
            <span data-lang-it>Chi sono</span>
          </p>
          <h2 class="mt-4 text-4xl font-semibold leading-[1.05] sm:text-6xl" data-parallax="0.04">
            <span data-lang-en>Astrophotography is a lifestyle, a way of being&hellip;</span>
            <span data-lang-it>L’astrofotografia è uno stile di vita, un modo di essere&hellip;</span>
          </h2>

          <a href="/about/" class="btn-accent mt-6 justify-center min-w-[190px]">
            <span data-lang-en>My story</span>
            <span data-lang-it>La mia storia</span>
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <div class="mt-10 border-t border-white/10 pt-8">
            <p class="text-lg text-white/70" data-parallax="-0.03">
              <span data-lang-en>Do you have any questions?<br /> Feel free to write to me, I will be happy to answer you.</span>
              <span data-lang-it>Hai qualche domanda?<br /> Scrivimi pure, sarò felice di risponderti.</span>
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-4">
              <a href="/contact/" class="btn-accent justify-center min-w-[190px]">
                <span data-lang-en>Contact me</span>
                <span data-lang-it>Contattami</span>
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <div class="flex gap-3">
                <a
                  href={`mailto:${site.email}`}
                  aria-label="Email"
                  title="Email"
                  class="footer-icon"
                  style="--icon-hover: #fbbf24"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3.5 6 8.5 7 8.5-7" />
                  </svg>
                </a>
                <a
                  href={site.social.instagram}
                  target="_blank"
                  rel="noopener"
                  aria-label="Instagram"
                  title="Instagram"
                  class="footer-icon"
                  style="--icon-hover: #e1306c"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4.2" />
                    <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
                  </svg>
                </a>
                <a
                  href={site.social.facebook}
                  target="_blank"
                  rel="noopener"
                  aria-label="Facebook"
                  title="Facebook"
                  class="footer-icon"
                  style="--icon-hover: #1877f2"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M13.5 21v-7.6h2.55l.38-2.96h-2.93V8.55c0-.86.24-1.44 1.47-1.44h1.57V4.46c-.27-.04-1.2-.12-2.28-.12-2.26 0-3.8 1.38-3.8 3.9v2.18H7.9v2.96h2.56V21h3.04Z" />
                  </svg>
                </a>
                <a
                  href={site.social.youtube}
                  target="_blank"
                  rel="noopener"
                  aria-label="YouTube"
                  title="YouTube"
                  class="footer-icon"
                  style="--icon-hover: #ff0000"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21.6 7.6a2.9 2.9 0 0 0-2.05-2.06C17.8 5.1 12 5.1 12 5.1s-5.8 0-7.55.44A2.9 2.9 0 0 0 2.4 7.6 30.4 30.4 0 0 0 2 12a30.4 30.4 0 0 0 .4 4.4 2.9 2.9 0 0 0 2.05 2.06c1.75.44 7.55.44 7.55.44s5.8 0 7.55-.44a2.9 2.9 0 0 0 2.05-2.06A30.4 30.4 0 0 0 22 12a30.4 30.4 0 0 0-.4-4.4ZM10 15V9l5.2 3-5.2 3Z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
